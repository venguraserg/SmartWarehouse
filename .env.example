# Скопируйте в .env и задайте свои значения. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=change-me
# Ключ подписи токенов входа — длинная случайная строка (не короче 32 символов).
JWT_KEY=замените-на-длинную-случайную-строку-не-короче-32-символов
# Начальный пароль администратора «admin» (используется только при самом первом запуске).
ADMIN_PASSWORD=admin123
API_PORT=8080
WEB_PORT=8081
TZ=Europe/Minsk
# Для HTTPS (docker-compose.https.yml): имя или IP сервера, по которому его открывают телефоны.
SITE_ADDRESS=192.168.1.10
