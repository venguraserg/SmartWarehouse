<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- PDF-акты: MigraDoc/PDFsharp, лицензия MIT. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.1.1" />
    <!-- Хеширование паролей (PBKDF2 с солью) из ASP.NET Core Identity. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.0" />
    <!-- Исправленная версия вместо транзитивной с уязвимостями (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Шрифт DejaVu Sans (кириллица) встроен в сборку: PDF одинаково строится в Windows и в Docker. -->
    <EmbeddedResource Include="Pdf\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <None Include="Pdf\Fonts\LICENSE-DejaVu.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartWarehouse.Application\SmartWarehouse.Application.csproj" />
  </ItemGroup>

</Project>
