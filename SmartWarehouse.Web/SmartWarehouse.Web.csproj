<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Переадресация на статических страницах (вход, смена пароля) без NavigationException:
         иначе отладчик Visual Studio останавливается на штатном исключении фреймворка. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Запуск как служба Windows (deploy/windows). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общие DTO и перечисления; к базе данных веб-приложение не обращается, только к API. -->
    <ProjectReference Include="..\SmartWarehouse.Application\SmartWarehouse.Application.csproj" />
  </ItemGroup>

</Project>
