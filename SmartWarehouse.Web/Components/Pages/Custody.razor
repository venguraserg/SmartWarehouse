@page "/custody"
@inject ApiClient Api

<PageTitle>Подотчёт — Склад ОЭТО</PageTitle>

<div class="page-head">
    <h1>Подотчёт</h1>
    <span class="spacer"></span>
    <AuthorizeView Roles="@AppRoles.Warehouse">
        <a class="btn" href="/documents/new/Issue">− Выдать</a>
        <a class="btn" href="/documents/new/Return">↩ Вернуть</a>
    </AuthorizeView>
    <a class="btn btn-primary" href="/acts/new">Акт на списание</a>
</div>
<p class="muted" style="margin-top: -.5rem">
    Что числится за сотрудниками до списания или возврата.
    <span class="tag tag-info">в работе</span> — выдано кладовщиком, в 1С остаётся за ним;
    <span class="tag tag-official">по 1С</span> — на МОЛ самого сотрудника.
    <OffBookTag Quantity="1" /> — б/у и неучтённое, в 1С не числится (списывается только для контроля).
    <AuthorizeView Roles="@AppRoles.Warehouse">
        <NotAuthorized>Показан ваш подотчёт@(context.User.IsInRole(AppRoles.Manager) ? " и подотчёт ваших подчинённых" : "").</NotAuthorized>
    </AuthorizeView>
</p>

<form class="toolbar" @onsubmit="LoadAsync" @onsubmit:preventDefault>
    <input type="search" placeholder="Сотрудник, табельный номер, артикул или наименование" @bind="search" style="max-width: 420px" />
    <button class="btn" type="submit">Найти</button>
    <div class="segmented" role="group" aria-label="Вид подотчёта">
        <button type="button" class="@(kind is null ? "active" : null)" @onclick="() => kind = null">Все</button>
        <button type="button" class="@(kind == CustodyKind.Work ? "active" : null)" @onclick="() => kind = CustodyKind.Work">В работе</button>
        <button type="button" class="@(kind == CustodyKind.Official ? "active" : null)" @onclick="() => kind = CustodyKind.Official">По 1С</button>
    </div>
    <BookFilter Value="book" ValueChanged="v => { book = v; }" />
</form>

<Alert Error="@error" />

@if (rows is null)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else if (Visible.Count == 0)
{
    <div class="panel empty">@(string.IsNullOrWhiteSpace(search) ? "За сотрудниками ничего не числится." : "Ничего не найдено.")</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 56px"></th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th class="num">Количество</th>
                    @if (ShowValue)
                    {
                        <th class="num">Стоимость</th>
                    }
                    <th class="num" title="Сколько дней числится (по самой ранней невозвращённой выдаче)">Числится</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Visible.GroupBy(r => r.EmployeeId))
                {
                    var first = group.First();
                    <tr class="group-row">
                        <td colspan="@(ShowValue ? 6 : 5)">
                            <div class="toolbar" style="margin: 0">
                                <a href="/employees/@first.EmployeeId">@first.EmployeeName</a>
                                @if (!string.IsNullOrEmpty(first.Position))
                                {
                                    <span class="muted">· @first.Position</span>
                                }
                                @if (ShowValue)
                                {
                                    <span class="muted">· на @Ui.Value(group.Any(r => r.Value is not null) ? group.Sum(r => ValueOf(r) ?? 0) : null, book != true && group.Any(r => r.ValueIncomplete))</span>
                                }
                                @if (!first.EmployeeIsActive)
                                {
                                    <span class="tag tag-neutral">не работает</span>
                                }
                                <span class="spacer"></span>
                                <AuthorizeView Roles="@AppRoles.Warehouse">
                                    <a class="btn btn-sm" href="/documents/new/Return?employee=@first.EmployeeId">Вернуть</a>
                                </AuthorizeView>
                                @if (isWarehouse || first.EmployeeId == myEmployeeId)
                                {
                                    @if (group.Any(r => r.Kind == CustodyKind.Work))
                                    {
                                        <a class="btn btn-sm" href="/reports/new?employee=@first.EmployeeId">Отчёт</a>
                                    }
                                    @if (group.Any(r => r.Kind == CustodyKind.Official))
                                    {
                                        <a class="btn btn-sm" href="/acts/new?employee=@first.EmployeeId">Акт на списание</a>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                    @foreach (var r in group)
                    {
                        var qty = QtyOf(r);
                        <tr class="@(book == true || r.OffBookQuantity >= r.Quantity ? "row-offbook" : null)">
                            <td><Thumb ItemId="r.ItemId" ImageVersion="r.ImageVersion" /></td>
                            <td class="mono"><a href="/items/@r.ItemId">@r.Sku</a></td>
                            <td class="col-name">
                                @r.ItemName
                                <span class="tag @Ui.CustodyKindClass(r.Kind)" title="@Ui.CustodyKindTitle(r.Kind)">@Ui.CustodyKindShort(r.Kind)</span>
                                @if (book != false)
                                {
                                    <OffBookTag Quantity="book == true ? qty : r.OffBookQuantity" Total="qty" />
                                }
                            </td>
                            <td class="num">
                                @Ui.Qty(qty) @r.UnitCode
                                @if (r.Reserved > 0 && book is null)
                                {
                                    <div class="line-hint">из них @Ui.Qty(r.Reserved) — @(r.Kind == CustodyKind.Work ? "в отчётах об использовании" : "в актах на утверждении")</div>
                                }
                            </td>
                            @if (ShowValue)
                            {
                                <td class="num">@Ui.Value(ValueOf(r), book != true && r.ValueIncomplete)</td>
                            }
                            <td class="num"><CustodyAge Since="r.HeldSince" Kind="r.Kind" Unreported="r.Quantity - r.Reserved" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isWarehouse;

    /// <summary>Стоимость отдаётся API только тем, кому её можно видеть.</summary>
    private bool ShowValue => rows?.Any(r => r.Value is not null || r.ValueIncomplete) == true;
    private int? myEmployeeId;
    private List<CustodyRowDto>? rows;

    /// <summary>Фильтр по виду: null — все, «в работе» или «по 1С».</summary>
    private CustodyKind? kind;

    /// <summary>Учёт: null — все, false — по 1С, true — вне учёта.</summary>
    private bool? book;

    private List<CustodyRowDto> Visible => rows?.Where(r => (kind is null || r.Kind == kind) && QtyOf(r) > 0).ToList() ?? [];

    /// <summary>Количество строки с учётом фильтра «Учёт».</summary>
    private decimal QtyOf(CustodyRowDto r) => book switch
    {
        false => r.Quantity - r.OffBookQuantity,
        true => r.OffBookQuantity,
        null => r.Quantity
    };

    private decimal? ValueOf(CustodyRowDto r) => r.Value is not decimal v ? null : book switch
    {
        false => v - r.OffBookValue,
        true => r.OffBookValue,
        null => v
    };
    private string? search;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            isWarehouse = user.IsWarehouseStaff();
            myEmployeeId = user.EmployeeIdOf();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            rows = await Api.GetCustodyAsync(search: search);
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
