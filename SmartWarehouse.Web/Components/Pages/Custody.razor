@page "/custody"
@inject ApiClient Api

<PageTitle>Подотчёт — склад</PageTitle>

<div class="page-head">
    <h1>Подотчёт</h1>
    <span class="spacer"></span>
    <AuthorizeView Roles="@AppRoles.Warehouse">
        <a class="btn" href="/documents/new/Issue">− Выдать</a>
        <a class="btn" href="/documents/new/Return">↩ Вернуть</a>
    </AuthorizeView>
    <a class="btn btn-primary" href="/acts/new">Акт на списание</a>
</div>
<p class="muted" style="margin-top: -.5rem">
    Что выдано со склада и числится за сотрудниками — до списания или возврата.
    <AuthorizeView Roles="@AppRoles.Warehouse">
        <NotAuthorized>Показан ваш подотчёт@(context.User.IsInRole(AppRoles.Manager) ? " и подотчёт ваших подчинённых" : "").</NotAuthorized>
    </AuthorizeView>
</p>

<form class="toolbar" @onsubmit="LoadAsync" @onsubmit:preventDefault>
    <input type="search" placeholder="Сотрудник, табельный номер, артикул или наименование" @bind="search" style="max-width: 420px" />
    <button class="btn" type="submit">Найти</button>
</form>

<Alert Error="@error" />

@if (rows is null)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else if (rows.Count == 0)
{
    <div class="panel empty">@(string.IsNullOrWhiteSpace(search) ? "За сотрудниками ничего не числится." : "Ничего не найдено.")</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 56px"></th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th class="num">Количество</th>
                    <th class="num" title="Сколько дней числится (по самой ранней невозвращённой выдаче)">Числится</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in rows.GroupBy(r => r.EmployeeId))
                {
                    var first = group.First();
                    <tr class="group-row">
                        <td colspan="5">
                            <div class="toolbar" style="margin: 0">
                                <a href="/employees/@first.EmployeeId">@first.EmployeeName</a>
                                @if (!string.IsNullOrEmpty(first.Position))
                                {
                                    <span class="muted">· @first.Position</span>
                                }
                                @if (!first.EmployeeIsActive)
                                {
                                    <span class="tag tag-neutral">не работает</span>
                                }
                                <span class="spacer"></span>
                                <AuthorizeView Roles="@AppRoles.Warehouse">
                                    <a class="btn btn-sm" href="/documents/new/Return?employee=@first.EmployeeId">Вернуть</a>
                                </AuthorizeView>
                                @if (isWarehouse || first.EmployeeId == myEmployeeId)
                                {
                                    <a class="btn btn-sm" href="/acts/new?employee=@first.EmployeeId">Акт на списание</a>
                                }
                            </div>
                        </td>
                    </tr>
                    @foreach (var r in group)
                    {
                        <tr>
                            <td><Thumb ItemId="r.ItemId" ImageVersion="r.ImageVersion" /></td>
                            <td class="mono"><a href="/items/@r.ItemId">@r.Sku</a></td>
                            <td>@r.ItemName</td>
                            <td class="num">
                                @Ui.Qty(r.Quantity) @r.UnitCode
                                @if (r.Reserved > 0)
                                {
                                    <div class="line-hint">из них @Ui.Qty(r.Reserved) — в актах на утверждении</div>
                                }
                            </td>
                            <td class="num"><CustodyAge Since="r.HeldSince" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isWarehouse;
    private int? myEmployeeId;
    private List<CustodyRowDto>? rows;
    private string? search;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            isWarehouse = user.IsWarehouseStaff();
            myEmployeeId = user.EmployeeIdOf();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            rows = await Api.GetCustodyAsync(search: search);
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
