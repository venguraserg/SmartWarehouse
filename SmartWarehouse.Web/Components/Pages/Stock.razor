@page "/stock"
@using System.Globalization
@using System.Text
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Остатки — Склад ОЭТО</PageTitle>

<div class="page-head">
    <h1>Остатки на складе</h1>
    <span class="spacer"></span>
    @if (result is { Rows.Count: > 0 })
    {
        <a class="btn" href="@CsvHref" download="@CsvFileName">Скачать для Excel</a>
    }
</div>

<form class="panel filters" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
    <div class="field-row">
        <div class="field">
            <label for="f-search">Наименование, артикул или текст заметки</label>
            <input id="f-search" type="search" @bind="search" placeholder="подшипник, 6205…" />
        </div>
        <div class="field">
            <label>Место (зона, стеллаж, полка, ящик)</label>
            <PlacePicker Tree="placeTree" Value="LocationId" ValueChanged="OnLocationPickedAsync" Title="Остатки по месту"
                         AllowClear="true" ClearText="Все места"
                         Placeholder="@(string.IsNullOrWhiteSpace(location) ? "Все места" : $"код места: {location}")" />
            <div class="field-hint">Вместе со всем, что вложено в место.</div>
        </div>
        <div class="field">
            <label for="f-wh">Склад</label>
            <select id="f-wh" @bind="warehouseId">
                <option value="">Все склады</option>
                @foreach (var w in warehouses)
                {
                    <option value="@w.Id">@w.Code — @w.Name</option>
                }
            </select>
        </div>
        @if (mols.Count > 1)
        {
            <div class="field">
                <label for="f-mol">За кем числится (МОЛ)</label>
                <select id="f-mol" @bind="molId">
                    <option value="">Все МОЛ</option>
                    @foreach (var m in mols)
                    {
                        <option value="@m.EmployeeId">@m.Name</option>
                    }
                </select>
            </div>
        }
        <div class="field">
            <label for="f-cat">Категория</label>
            <select id="f-cat" @bind="categoryId">
                <option value="">Все категории</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="toolbar" style="margin: 0">
        <label class="checkbox"><input type="checkbox" @bind="belowMinimum" /> только ниже минимума</label>
        <span class="spacer"></span>
        <button class="btn" type="button" @onclick="ResetAsync">Сбросить</button>
        <button class="btn btn-primary" type="submit">Показать</button>
    </div>
</form>

<Alert Error="@error" />

@if (result is null)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else
{
    <div class="toolbar" style="margin-top: 1rem">
        <div class="segmented" role="group" aria-label="Вид">
            <button type="button" class="@(byItem ? null : "active")" @onclick="() => SetViewAsync(false)">По местам</button>
            <button type="button" class="@(byItem ? "active" : null)" @onclick="() => SetViewAsync(true)">По позициям</button>
        </div>
        <BookFilter Value="offBook" ValueChanged="SetBookAsync" />
        @if (!byItem && result.Rows.Count > 0)
        {
            <span class="hide-phone">
                <button class="btn btn-sm" type="button" @onclick="ExpandAll" title="Развернуть всё"><Icon Name="expand" Size="16" /> всё</button>
                <button class="btn btn-sm" type="button" @onclick="CollapseAll" title="Свернуть всё"><Icon Name="collapse" Size="16" /> всё</button>
            </span>
        }
        <span class="spacer"></span>
        <span class="muted">
            Позиций: <strong>@result.Rows.Select(r => r.ItemId).Distinct().Count()</strong> ·
            мест: <strong>@result.Rows.Select(r => r.LocationId).Distinct().Count()</strong>
            @if (ShowValue && offBook != true)
            {
                <span> · стоимость по 1С: <strong>@Ui.Value(AccountedValue, result.Rows.Any(r => r.ValueIncomplete))</strong></span>
            }
        </span>
    </div>
    @if (OffBookItems > 0)
    {
        <p class="muted" style="margin-top: -.25rem">
            <OffBookTag Quantity="1" />
            @(offBook == true ? "Показано только" : "Из них") вне учёта: <strong>@OffBookItems</strong> @Plural(OffBookItems, "позиция", "позиции", "позиций")
            @if (ShowValue && OffBookValue > 0)
            {
                <span> (оценка @Ui.Money(OffBookValue) руб., в 1С не числится)</span>
            }
            — б/у и неучтённое, в стоимость по 1С не входит.
        </p>
    }

    @if (result.Truncated)
    {
        <div class="alert alert-error">Показаны первые @result.Rows.Count строк. Уточните фильтры, чтобы увидеть всё.</div>
    }

    @if (result.Rows.Count == 0)
    {
        <div class="panel empty">
            @(HasFilters ? "По заданным фильтрам ничего не найдено." : "Склад пуст — оформите приход.")
        </div>
    }
    else if (!byItem)
    {
        <div class="table-wrap hide-phone">
            <table>
                <thead>
                    <tr>
                        <th style="width: 56px"></th>
                        <th>Артикул</th>
                        <th>Наименование</th>
                        <th>Категория</th>
                        <th class="num">Количество</th>
                        @if (ShowValue)
                        {
                            <th class="num">Стоимость</th>
                        }
                        <th class="col-request"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rack in RackGroups)
                    {
                        var open = !collapsed.Contains(rack.Key);
                        var places = rack.ToList();
                        var head = places[0].Address;
                        var single = places.Count == 1 && head.Rest is null;
                        var positions = places.Sum(pl => pl.Rows.Count);
                        <tr class="group-row">
                            <td colspan="@(ShowValue ? 7 : 6)">
                                <span class="place-head">
                                    <button type="button" class="tree-toggle" aria-expanded="@(open ? "true" : "false")"
                                            aria-label="@(open ? "Свернуть" : "Развернуть")" @onclick="() => Toggle(rack.Key)">
                                        <Icon Name="@(open ? "collapse" : "expand")" Size="14" />
                                    </button>
                                    <span class="place-title">@head.GroupTitle</span>
                                    @if (single && head.Note is not null)
                                    {
                                        <span class="place-note">@head.Note</span>
                                    }
                                    <a class="mono place-code" href="@StockUrl(location: GroupCode(rack.Key, head))" title="Показать только это место"
                                       @onclick:preventDefault @onclick="() => FilterByLocationAsync(GroupCode(rack.Key, head))">@GroupCode(rack.Key, head)</a>
                                    <span class="place-count">@positions @Plural(positions, "позиция", "позиции", "позиций")</span>
                                </span>
                            </td>
                        </tr>
                        @if (open)
                        {
                            foreach (var place in places)
                            {
                                var a = place.Address;
                                if (!single)
                                {
                                    <tr class="place-row">
                                        <td colspan="@(ShowValue ? 7 : 6)">
                                            <span class="place-sub">@(a.Rest ?? HereLabel(a))</span>
                                            @if (a.Note is not null)
                                            {
                                                <span class="place-note">@a.Note</span>
                                            }
                                            <a class="mono place-code" href="@StockUrl(location: a.Code)" title="Показать только это место"
                                               @onclick:preventDefault @onclick="() => FilterByLocationAsync(a.Code)">@a.Code</a>
                                        </td>
                                    </tr>
                                }
                                foreach (var row in place.Rows)
                                {
                                    <tr class="@(row.OffBookQuantity >= row.Quantity ? "row-offbook" : null)">
                                        <td><Thumb ItemId="row.ItemId" ImageVersion="row.ImageVersion" /></td>
                                        <td class="mono"><a href="/items/@row.ItemId">@row.Sku</a></td>
                                        <td class="col-name"><a href="/items/@row.ItemId">@row.ItemName</a> <OffBookTag Quantity="row.OffBookQuantity" Total="row.Quantity" /> <MolTags Mols="row.Mols" /><NoteHit Hit="HitOf(row.ItemId)" Term="@searched" /></td>
                                        <td>@row.CategoryName</td>
                                        <td class="num">@Ui.Qty(row.Quantity) @row.UnitCode</td>
                                        @if (ShowValue)
                                        {
                                            <td class="num">@Ui.Value(row.Value, row.ValueIncomplete)</td>
                                        }
                                        <td class="col-request"><RequestAddButton ItemId="row.ItemId" Compact="true" /></td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-wrap hide-phone">
            <table>
                <thead>
                    <tr>
                        <th style="width: 56px"></th>
                        <th>Артикул</th>
                        <th>Наименование</th>
                        <th class="num">Всего</th>
                        @if (ShowValue)
                        {
                            <th class="num">Стоимость</th>
                        }
                        <th>Где лежит</th>
                        <th class="col-request"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in result.Rows.GroupBy(r => r.ItemId).OrderBy(g => g.First().ItemName))
                    {
                        var first = group.First();
                        var total = group.Sum(r => r.Quantity);
                        var totalOffBook = group.Sum(r => r.OffBookQuantity);
                        <tr class="@(totalOffBook >= total ? "row-offbook" : null)">
                            <td><Thumb ItemId="first.ItemId" ImageVersion="first.ImageVersion" /></td>
                            <td class="mono"><a href="/items/@first.ItemId">@first.Sku</a></td>
                            <td class="col-name">
                                <a href="/items/@first.ItemId">@first.ItemName</a>
                                <OffBookTag Quantity="totalOffBook" Total="total" />
                                <MolTags Mols="MolsOf(group)" />
                                <NoteHit Hit="HitOf(first.ItemId)" Term="@searched" />
                                @if (belowMinimum)
                                {
                                    <div class="line-hint">минимум @Ui.Qty(first.MinStock) @first.UnitCode</div>
                                }
                            </td>
                            <td class="num"><strong>@Ui.Qty(total) @first.UnitCode</strong></td>
                            @if (ShowValue)
                            {
                                <td class="num">@Ui.Value(group.Any(r => r.Value is not null) ? group.Sum(r => r.Value ?? 0) : null, group.Any(r => r.ValueIncomplete))</td>
                            }
                            <td>
                                <div class="chips">
                                    @foreach (var row in group)
                                    {
                                        var a = Address(row);
                                        <a class="chip" href="@StockUrl(location: row.LocationCode)" title="@a.Title" @onclick:preventDefault @onclick="() => FilterByLocationAsync(row.LocationCode)">
                                            <span>@a.Short</span> <strong>@Ui.Qty(row.Quantity)</strong>@(row.OffBookQuantity > 0 ? (row.OffBookQuantity >= row.Quantity ? " б/у" : $" (б/у {Ui.Qty(row.OffBookQuantity)})") : "")
                                        </a>
                                    }
                                </div>
                            </td>
                            <td class="col-request"><RequestAddButton ItemId="first.ItemId" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Телефон и ТСД: карточки по позициям — наименование крупно, количество справа, внизу код и места *@
    @if (result.Rows.Count > 0)
    {
        <div class="cards only-phone">
            @foreach (var group in result.Rows.GroupBy(r => r.ItemId).OrderBy(g => g.First().ItemName))
            {
                var first = group.First();
                var total = group.Sum(r => r.Quantity);
                var totalOffBook = group.Sum(r => r.OffBookQuantity);
                var low = first.MinStock > 0 && total < first.MinStock;
                <div class="card card-linked @(totalOffBook >= total ? "row-offbook" : null)">
                    <span class="card-top">
                        <a class="card-title card-link" href="/items/@first.ItemId">@first.ItemName</a>
                        <span class="card-qty @(low ? "qty-warn" : null)">@Ui.Qty(total) @first.UnitCode</span>
                    </span>
                    <NoteHit Hit="HitOf(first.ItemId)" Term="@searched" />
                    <span class="card-bottom">
                        <span class="card-meta"><span class="mono">@first.Sku</span> · @string.Join(", ", group.Select(r => Address(r).Short).Take(3))@(group.Count() > 3 ? $" +{group.Count() - 3}" : "")</span>
                        @if (totalOffBook > 0)
                        {
                            <OffBookTag Quantity="totalOffBook" Total="total" />
                        }
                        else if (low)
                        {
                            <span class="tag tag-warn">ниже минимума</span>
                        }
                        <MolTags Mols="MolsOf(group)" />
                        <RequestAddButton ItemId="first.ItemId" Class="card-action" />
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    // Фильтры приходят из адреса страницы — ссылку на выборку можно сохранить или отправить коллеге.
    [SupplyParameterFromQuery(Name = "search")] public string? SearchParam { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public string? LocationParam { get; set; }
    [SupplyParameterFromQuery(Name = "warehouse")] public int? WarehouseParam { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public int? CategoryParam { get; set; }
    [SupplyParameterFromQuery(Name = "low")] public bool? LowParam { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    [SupplyParameterFromQuery(Name = "book")] public string? BookParam { get; set; }
    [SupplyParameterFromQuery(Name = "mol")] public int? MolParam { get; set; }

    private string? search;

    /// <summary>Что искали при последней загрузке — подсвечивается в отрывке заметки.</summary>
    private string? searched;

    /// <summary>Заметка, по которой нашлась позиция (если не нашлась по названию или артикулу).</summary>
    private ItemNoteHitDto? HitOf(int itemId) => result?.NoteHits?.GetValueOrDefault(itemId);
    private string? location;
    private int? warehouseId;
    private int? categoryId;

    /// <summary>МОЛ: null — все, 0 — основной, иначе — сотрудник-МОЛ.</summary>
    private int? molId;
    private List<MolDto> mols = [];
    private bool belowMinimum;
    private bool byItem;

    /// <summary>Учёт: null — все, false — по 1С, true — вне учёта.</summary>
    private bool? offBook;

    private List<WarehouseDto> warehouses = [];
    private List<CategoryDto> categories = [];
    private PlaceTree placeTree = new();

    /// <summary>Выбранное в фильтре место (если в адресе полный код места).</summary>
    private int? LocationId => string.IsNullOrWhiteSpace(location) ? null
        : placeTree.All.FirstOrDefault(n => string.Equals(n.FullCode, location.Trim(), StringComparison.OrdinalIgnoreCase))?.Id;

    private Task OnLocationPickedAsync(int? id)
    {
        location = id is int x && placeTree.ById.TryGetValue(x, out var node) ? node.FullCode : null;
        if (location is not null)
            warehouseId = null;
        return ApplyAsync();
    }
    private StockSearchResult? result;
    private string? error;
    private bool referencesLoaded;

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(location)
        || warehouseId is not null || categoryId is not null || belowMinimum || offBook is not null || molId is not null;

    protected override async Task OnParametersSetAsync()
    {
        search = SearchParam;
        location = LocationParam;
        warehouseId = WarehouseParam;
        categoryId = CategoryParam;
        molId = MolParam;
        belowMinimum = LowParam ?? false;
        byItem = ViewParam == "items";
        offBook = BookParam switch { "1c" => false, "off" => true, _ => null };

        try
        {
            if (!referencesLoaded)
            {
                warehouses = await Api.GetWarehousesAsync();
                categories = await Api.GetCategoriesAsync();
                placeTree = await Api.GetPlacesAsync();
                mols = await Api.GetMolsAsync();
                referencesLoaded = true;
            }

            result = await Api.SearchStockAsync(new StockQuery(warehouseId, location, search, categoryId, belowMinimum, offBook, molId));
            searched = search?.Trim();
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = $"Не удалось загрузить остатки: {ex.Message}";
        }
    }

    // Применение фильтров = переход на адрес с параметрами; загрузку делает OnParametersSetAsync.
    private Task ApplyAsync()
    {
        Nav.NavigateTo(StockUrl(), replace: true);
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        search = location = null;
        warehouseId = categoryId = molId = null;
        belowMinimum = false;
        offBook = null;
        return ApplyAsync();
    }

    private Task SetViewAsync(bool items)
    {
        byItem = items;
        return ApplyAsync();
    }

    private Task SetBookAsync(bool? value)
    {
        offBook = value;
        return ApplyAsync();
    }

    private Task FilterByLocationAsync(string code)
    {
        location = code;
        warehouseId = null;
        return ApplyAsync();
    }

    private string StockUrl(string? location = null) => Nav.GetUriWithQueryParameters("/stock", new Dictionary<string, object?>
    {
        ["search"] = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
        ["location"] = location ?? (string.IsNullOrWhiteSpace(this.location) ? null : this.location.Trim()),
        ["warehouse"] = location is null ? warehouseId : null,
        ["category"] = categoryId,
        ["mol"] = molId,
        ["low"] = belowMinimum ? true : null,
        ["view"] = byItem ? "items" : null,
        ["book"] = offBook switch { false => "1c", true => "off", null => null }
    });

    private static string Plural(int n, string one, string few, string many) => Ui.Plural(n, one, few, many);

    // ---------- Адреса словами и группировка «по местам»: этаж/зона → стеллаж → полка, ячейка ----------

    /// <summary>Свёрнутые группы (стеллажи) в виде «По местам».</summary>
    private readonly HashSet<int> collapsed = [];

    private sealed record PlaceRows(PlaceAddress Address, List<StockRowDto> Rows);

    private PlaceAddress Address(StockRowDto row) => placeTree.AddressOf(row.LocationId, row.LocationCode, row.LocationName);

    /// <summary>Места, сгруппированные по стеллажу (или зоне), в порядке дерева мест.</summary>
    private IEnumerable<IGrouping<int, PlaceRows>> RackGroups =>
        (result?.Rows ?? [])
            .GroupBy(r => r.LocationId)
            .Select(g => new PlaceRows(Address(g.First()), g.ToList()))
            .OrderBy(p => placeTree.OrderOf(p.Address.GroupId))
            .ThenBy(p => placeTree.OrderOf(p.Rows[0].LocationId))
            .ThenBy(p => p.Address.Code, StringComparer.OrdinalIgnoreCase)
            .GroupBy(p => p.Address.GroupId);

    private string GroupCode(int groupId, PlaceAddress head) =>
        placeTree.ById.TryGetValue(groupId, out var node) ? node.FullCode : head.Code;

    /// <summary>Товар лежит прямо на стеллаже (или в зоне), без полки.</summary>
    private string HereLabel(PlaceAddress a) =>
        placeTree.ById.TryGetValue(a.GroupId, out var node) && node.Type == SmartWarehouse.Domain.Enums.LocationType.Rack
            ? "на стеллаже, без полки" : "без стеллажа";

    private void Toggle(int groupId)
    {
        if (!collapsed.Remove(groupId))
            collapsed.Add(groupId);
    }

    private void ExpandAll() => collapsed.Clear();

    private void CollapseAll()
    {
        foreach (var g in RackGroups)
            collapsed.Add(g.Key);
    }

    private static IReadOnlyList<string>? MolsOf(IEnumerable<StockRowDto> rows)
    {
        var names = rows.SelectMany(r => r.Mols ?? []).Distinct().OrderBy(n => n).ToList();
        return names.Count == 0 ? null : names;
    }

    // ---------- Выгрузка для Excel (CSV с разделителем «;», открывается двойным щелчком) ----------

    private string CsvFileName => $"остатки_{DateTime.Now:yyyy-MM-dd_HH-mm}.csv";

    /// <summary>Стоимость видна тем, кому API её отдаёт (не рядовым сотрудникам).</summary>
    private bool ShowValue => result?.Rows.Any(r => r.Value is not null || r.ValueIncomplete) == true;

    /// <summary>Стоимость учётного (по 1С) — без вне учёта.</summary>
    private decimal? AccountedValue =>
        result?.Rows.Any(r => r.Value is not null) == true ? result.Rows.Sum(r => (r.Value ?? 0) - r.OffBookValue) : null;

    private int OffBookItems => result?.Rows.Where(r => r.OffBookQuantity > 0).Select(r => r.ItemId).Distinct().Count() ?? 0;

    private decimal OffBookValue => result?.Rows.Sum(r => r.OffBookValue) ?? 0;

    private string CsvHref
    {
        get
        {
            var ru = CultureInfo.GetCultureInfo("ru-RU");
            var sb = new StringBuilder("﻿"); // BOM — чтобы Excel понял кодировку
            sb.AppendLine("Склад;Место;Этаж / зона;Адрес;Описание места;Артикул;Наименование;Категория;Количество;Ед.;Стоимость;Из них вне учёта");
            foreach (var r in result?.Rows ?? Array.Empty<StockRowDto>())
            {
                var a = Address(r);
                sb.AppendLine(string.Join(';',
                    Csv(r.WarehouseCode), Csv(r.LocationCode), Csv(a.Area), Csv(a.Full), Csv(a.Note), Csv(r.Sku), Csv(r.ItemName),
                    Csv(r.CategoryName), r.Quantity.ToString("0.###", ru), Csv(r.UnitCode),
                    r.Value is decimal v ? v.ToString("0.00", ru) : "",
                    r.OffBookQuantity > 0 ? r.OffBookQuantity.ToString("0.###", ru) : ""));
            }
            return "data:text/csv;charset=utf-8," + Uri.EscapeDataString(sb.ToString());
        }
    }

    private static string Csv(string? value) =>
        string.IsNullOrEmpty(value) ? "" : $"\"{value.Replace("\"", "\"\"")}\"";
}
