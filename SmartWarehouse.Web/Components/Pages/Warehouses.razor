@page "/warehouses"
@inject ApiClient Api

<PageTitle>Склады и места — склад</PageTitle>

<h1>Склады и места хранения</h1>

<Alert Error="@error" Success="@success" />

<div class="grid-sidebar">
    <section class="panel">
        <h2 style="margin-top: 0">Склады</h2>
        <ul class="list-select">
            @foreach (var w in warehouses)
            {
                <li>
                    <button type="button" class="@(w.Id == warehouse?.Id ? "selected" : null)" @onclick="() => SelectWarehouseAsync(w)">
                        <span class="mono">@w.Code</span> — @w.Name
                    </button>
                </li>
            }
        </ul>
        @if (warehouses.Count == 0)
        {
            <p class="muted">Складов пока нет.</p>
        }

        <form style="margin-top: 1rem" @onsubmit="CreateWarehouseAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="wh-code">Код нового склада <span class="req">*</span></label>
                <CodeInput Id="wh-code" @bind-Value="newWarehouseCode" Placeholder="СК1" Invalid="@(WarehouseCodeError is not null)" />
                <FieldError Message="@WarehouseCodeError" />
                <div class="field-hint">Только буквы и цифры. С него начинаются коды всех мест склада.</div>
            </div>
            <div class="field">
                <label for="wh-name">Название <span class="req">*</span></label>
                <input id="wh-name" type="text" @bind="newWarehouseName" @bind:event="oninput" maxlength="128"
                       class="@(WarehouseNameError is not null ? "invalid" : null)" />
                <FieldError Message="@WarehouseNameError" />
            </div>
            <button class="btn" type="submit" disabled="@(!WarehouseFormValid || busy)">Создать склад</button>
        </form>
    </section>

    <section>
        @if (warehouse is null)
        {
            <div class="panel muted">Выберите склад слева или создайте новый.</div>
        }
        else
        {
            <div class="grid-2">
                <div class="panel">
                    <div class="toolbar" style="margin-bottom: .5rem">
                        <h2 style="margin: 0">@warehouse.Name</h2>
                        <span class="spacer"></span>
                        <a class="btn btn-sm" href="/stock?warehouse=@warehouse.Id">Остатки склада</a>
                        <button class="btn btn-sm" type="button" @onclick="() => SelectLocationAsync(null)" disabled="@(selected is null)">Верхний уровень</button>
                    </div>
                    @if (tree.Count == 0)
                    {
                        <p class="muted">Мест хранения пока нет. Добавьте зону или стеллаж справа.</p>
                    }
                    else
                    {
                        <ul class="tree">
                            @foreach (var node in tree)
                            {
                                <LocationNode Node="node" SelectedId="selected?.Id" OnSelect="SelectLocationAsync" />
                            }
                        </ul>
                    }
                </div>

                <div>
                    <div class="panel">
                        @if (selected is null)
                        {
                            <h2 style="margin-top: 0">Добавить на верхний уровень</h2>
                            <p class="muted">Код склада: <span class="mono">@warehouse.Code</span></p>
                        }
                        else
                        {
                            <h2 style="margin-top: 0" class="mono">@selected.FullCode</h2>
                            <p class="muted">
                                @Ui.LocType(selected.Type)@(string.IsNullOrEmpty(selected.Name) ? "" : $" · {selected.Name}")
                                · <a href="/stock?location=@Uri.EscapeDataString(selected.FullCode)">что лежит здесь и внутри</a>
                            </p>
                        }

                        @if (AllowedChildTypes.Count > 0)
                        {
                            <form @onsubmit="AddLocationAsync" @onsubmit:preventDefault>
                                <div class="field-row">
                                    <div class="field">
                                        <label for="loc-type">Тип</label>
                                        <select id="loc-type" @bind="newType" @bind:after="SuggestLocationCode">
                                            @foreach (var t in AllowedChildTypes)
                                            {
                                                <option value="@t">@Ui.LocType(t)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label for="loc-code">Код <span class="req">*</span></label>
                                        <CodeInput Id="loc-code" @bind-Value="newCode" Placeholder="A, 01, 03" Invalid="@(LocationCodeError is not null)" />
                                        <FieldError Message="@LocationCodeError" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label for="loc-name">Название (необязательно)</label>
                                    <input id="loc-name" type="text" @bind="newName" maxlength="128" />
                                </div>
                                <button class="btn btn-primary" type="submit" disabled="@(LocationCodeError is not null || busy)">
                                    Добавить @(selected is null ? "" : "внутрь")
                                </button>
                                <p class="muted" style="margin-bottom: 0">
                                    Полный код: <span class="mono">@PreviewCode</span>
                                </p>
                            </form>
                        }
                        else
                        {
                            <p class="muted">В ячейку нельзя вложить другие места.</p>
                        }
                    </div>

                    @if (selected is not null && selected.Children.Count == 0)
                    {
                        <div class="panel">
                            <h2 style="margin-top: 0">Что лежит</h2>
                            @if (content.Count == 0)
                            {
                                <p class="muted">Пусто.</p>
                            }
                            else
                            {
                                <table>
                                    <thead><tr><th>Позиция</th><th class="num">Кол-во</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in content)
                                        {
                                            <tr>
                                                <td><a href="/items/@c.ItemId">@c.Name</a><br /><span class="muted mono">@c.Sku</span></td>
                                                <td class="num">@Ui.Qty(c.Quantity) @c.UnitCode</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </section>
</div>

@code {
    private List<WarehouseDto> warehouses = [];
    private WarehouseDto? warehouse;
    private List<LocationNodeDto> tree = [];
    private LocationNodeDto? selected;
    private List<LocationContentDto> content = [];

    private string? newWarehouseCode;
    private string? newWarehouseName;
    private LocationType newType = LocationType.Rack;
    private string? newCode;
    private string? newName;

    private bool busy;
    private string? error;
    private string? success;

    // ---------- Проверки (те же правила, что на сервере) ----------

    private string? WarehouseCodeError =>
        string.IsNullOrEmpty(newWarehouseCode) ? "Укажите код склада."
        : warehouses.Any(w => string.Equals(w.Code, newWarehouseCode, StringComparison.OrdinalIgnoreCase)) ? $"Склад {newWarehouseCode} уже есть."
        : null;

    private string? WarehouseNameError =>
        string.IsNullOrWhiteSpace(newWarehouseName) ? "Укажите название." : null;

    private bool WarehouseFormValid => WarehouseCodeError is null && WarehouseNameError is null;

    /// <summary>Соседние места на том уровне, куда добавляем.</summary>
    private IReadOnlyList<LocationNodeDto> Siblings => selected?.Children ?? tree;

    private string? LocationCodeError =>
        string.IsNullOrEmpty(newCode) ? "Укажите код."
        : Siblings.Any(s => string.Equals(s.Code, newCode, StringComparison.OrdinalIgnoreCase)) ? $"Код {newCode} на этом уровне уже занят."
        : null;

    /// <summary>Какие типы можно вложить в выбранное место (только «вниз»).</summary>
    private List<LocationType> AllowedChildTypes =>
        Enum.GetValues<LocationType>().Where(t => selected is null || t > selected.Type).ToList();

    private string PreviewCode =>
        $"{selected?.FullCode ?? warehouse?.Code}-{(string.IsNullOrEmpty(newCode) ? "…" : newCode)}";

    // ---------- Загрузка и выбор ----------

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
        if (warehouses.Count > 0)
            await SelectWarehouseAsync(warehouses[0]);
    }

    private async Task LoadWarehousesAsync()
    {
        try
        {
            warehouses = await Api.GetWarehousesAsync();
            SuggestWarehouse();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    /// <summary>Предзаполнение формы нового склада: следующий свободный код и название.</summary>
    private void SuggestWarehouse()
    {
        newWarehouseCode = Codes.NextWarehouseCode(warehouses.Select(w => w.Code));
        newWarehouseName = warehouses.Count == 0 ? "Склад запчастей" : $"Склад {newWarehouseCode}";
    }

    private async Task SelectWarehouseAsync(WarehouseDto w)
    {
        warehouse = w;
        selected = null;
        await ReloadTreeAsync();
        ResetNewType();
    }

    private async Task ReloadTreeAsync()
    {
        if (warehouse is null) return;
        try
        {
            tree = await Api.GetLocationTreeAsync(warehouse.Id);
            if (selected is not null)
                selected = Find(tree, selected.Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private async Task SelectLocationAsync(LocationNodeDto? node)
    {
        selected = node;
        content = [];
        error = success = null;
        ResetNewType();

        if (node is not null && node.Children.Count == 0)
        {
            try
            {
                content = await Api.GetLocationContentAsync(node.Id);
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                error = ex.Message;
            }
        }
    }

    /// <summary>Тип по умолчанию — на уровень ниже выбранного места (на верхнем уровне — стеллаж).</summary>
    private void ResetNewType()
    {
        var allowed = AllowedChildTypes;
        newType = selected is null
            ? LocationType.Rack
            : allowed.Count > 0 ? allowed[0] : newType;
        SuggestLocationCode();
    }

    /// <summary>Предзаполнение кода: следующая свободная буква или номер среди соседей.</summary>
    private void SuggestLocationCode() =>
        newCode = Codes.NextLocationCode(newType, Siblings.Select(s => s.Code));

    // ---------- Сохранение ----------

    private async Task CreateWarehouseAsync()
    {
        if (!WarehouseFormValid) return;
        error = success = null;
        busy = true;
        try
        {
            var created = await Api.CreateWarehouseAsync(new CreateWarehouseRequest(newWarehouseCode!, newWarehouseName!.Trim(), null));
            await LoadWarehousesAsync();
            await SelectWarehouseAsync(warehouses.First(w => w.Id == created.Id));
            success = $"Склад {created.Code} создан. Теперь добавьте стеллажи и ячейки справа.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddLocationAsync()
    {
        if (warehouse is null || LocationCodeError is not null) return;
        error = success = null;
        busy = true;
        try
        {
            var created = await Api.AddLocationAsync(warehouse.Id,
                new CreateLocationRequest(selected?.Id, newType, newCode!, string.IsNullOrWhiteSpace(newName) ? null : newName.Trim()));
            newName = null;
            await ReloadTreeAsync();
            SuggestLocationCode(); // сразу следующий код — удобно добавлять ячейки подряд
            success = $"Добавлено: {created.FullCode}";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static LocationNodeDto? Find(IEnumerable<LocationNodeDto> nodes, int id)
    {
        foreach (var node in nodes)
        {
            if (node.Id == id) return node;
            if (Find(node.Children, id) is { } found) return found;
        }
        return null;
    }
}
