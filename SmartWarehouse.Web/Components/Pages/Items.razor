@page "/items"
@inject ApiClient Api

<PageTitle>Номенклатура — Склад ОЭТО</PageTitle>

<div class="page-head">
    <h1>Номенклатура</h1>
    <span class="spacer"></span>
<AuthorizeView Roles="@AppRoles.Warehouse"><a class="btn btn-primary" href="/items/new"><Icon Name="plus" Size="18" /> Новая позиция</a></AuthorizeView>
</div>

<form class="toolbar" @onsubmit="LoadAsync" @onsubmit:preventDefault>
    <input type="search" placeholder="Артикул, наименование, штрих-код или текст заметки" @bind="search" style="max-width: 420px" />
    <select @bind="categoryId" @bind:after="LoadAsync" style="max-width: 240px">
        <option value="">Все категории</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id">@c.Name</option>
        }
    </select>
    <button class="btn" type="submit">Найти</button>
    <label class="checkbox"><input type="checkbox" @bind="showInactive" /> показывать неактивные</label>
</form>

<Alert Error="@error" />

@if (items is null)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else
{
    var visible = items.Where(i => showInactive || i.IsActive).ToList();

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 56px"></th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th>Категория</th>
                    <th>Ед.</th>
                    <th class="num">Мин.</th>
                    <th class="num">Макс.</th>
                    <th class="col-request"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in visible)
                {
                    <tr class="@(item.IsActive ? null : "inactive")">
                        <td>
                            @if (Ui.ImageUrl(item.Id, item.ImageVersion) is { } url)
                            {
                                <img class="thumb" src="@url" alt="" loading="lazy" />
                            }
                            else
                            {
                                <div class="thumb-empty"></div>
                            }
                        </td>
                        <td class="mono"><a href="/items/@item.Id">@item.Sku</a></td>
                        <td class="col-name">
                            <a href="/items/@item.Id">@item.Name</a>
                            @if (!item.IsActive)
                            {
                                <span class="tag tag-neutral">неактивна</span>
                            }
                            @if (item.NoteCount > 0)
                            {
                                <a class="note-badge" href="/items/@item.Id#notes" title="Заметки сотрудников"><Icon Name="note" Size="14" /> @item.NoteCount</a>
                            }
                            @if (item.NoteHit is { } hit)
                            {
                                <div class="note-hit">
                                    <Icon Name="note" Size="14" />
                                    <span>
                                        <span class="note-hit-kind">@Ui.NoteKindName(hit.Kind):</span>
                                        @foreach (var (part, match) in Ui.Highlight(hit.Snippet, searched))
                                        {
                                            if (match)
                                            {
                                                <mark class="hl">@part</mark>
                                            }
                                            else
                                            {
                                                @part
                                            }
                                        }
                                    </span>
                                </div>
                            }
                        </td>
                        <td>@item.CategoryName</td>
                        <td>@item.UnitCode</td>
                        <td class="num">@Ui.Qty(item.MinStock)</td>
                        <td class="num">@(item.MaxStock is { } max ? Ui.Qty(max) : "")</td>
                        <td class="col-request">
                            @if (item.IsActive)
                            {
                                <RequestAddButton ItemId="item.Id" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (visible.Count == 0)
        {
            <div class="empty">Ничего не найдено.</div>
        }
    </div>
    <p class="muted">Показано: @visible.Count@(items?.Count >= ListLimit ? $" — в списке первые {ListLimit} по наименованию, уточните поиск" : "")</p>
}

@code {
    private List<ItemDto>? items;

    /// <summary>Как CatalogService.ListLimit: без «all» API отдаёт не больше стольких позиций.</summary>
    private const int ListLimit = 500;
    private List<CategoryDto> categories = [];
    private string? search;

    /// <summary>Что искали при последней загрузке — для подсветки в отрывке заметки.</summary>
    private string? searched;
    private int? categoryId;
    private bool showInactive;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await Api.GetCategoriesAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            items = await Api.GetItemsAsync(search, categoryId);
            searched = search?.Trim();
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = $"Не удалось загрузить номенклатуру: {ex.Message}";
        }
    }
}
