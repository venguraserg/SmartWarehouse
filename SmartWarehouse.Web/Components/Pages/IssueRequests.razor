@page "/requests"
@inject ApiClient Api

<PageTitle>Запросы на выдачу — Склад ОЭТО</PageTitle>

<div class="page-head">
    <h1>Запросы на выдачу</h1>
    <span class="spacer"></span>
    <a class="btn btn-primary" href="/requests/new">+ Запрос на выдачу</a>
</div>
<p class="muted" style="margin-top: -.5rem">
    Сотрудник выбирает из остатков, что ему нужно, — кладовщик или старший смены собирает заказ и оформляет
    выдачу: строки документа уже заполнены. Остатки запрос не резервирует.
</p>

<div class="toolbar">
    <div class="segmented" role="group" aria-label="Какие запросы">
        <button type="button" class="@(openOnly ? "active" : null)" @onclick="() => SetOpenOnlyAsync(true)">
            Ждут выдачи@(openCount > 0 ? $" ({openCount})" : "")
        </button>
        <button type="button" class="@(!openOnly ? "active" : null)" @onclick="() => SetOpenOnlyAsync(false)">Все</button>
    </div>
</div>

<Alert Error="@error" />

@if (requests is null)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else if (requests.Count == 0)
{
    <div class="panel empty">@(openOnly ? "Нет запросов, ожидающих выдачи." : "Запросов пока нет.")</div>
}
else
{
    <div class="cards only-phone">
        @foreach (var r in requests)
        {
            <a class="card" href="/requests/@r.Id">
                <span class="card-top">
                    <span class="card-title">@r.EmployeeName</span>
                    <span class="tag @Ui.RequestStateClass(r.Status)">@Ui.RequestState(r.Status)</span>
                </span>
                <span class="card-bottom">
                    <span class="card-meta"><span class="mono">@r.Number</span> · @Ui.Date(r.CreatedAt) · @r.LineCount поз.</span>
                </span>
                @if (!string.IsNullOrEmpty(r.Comment))
                {
                    <span class="card-meta">@r.Comment</span>
                }
            </a>
        }
    </div>
    <div class="table-wrap hide-phone">
        <table>
            <thead>
                <tr>
                    <th>Запрос</th>
                    <th>Состояние</th>
                    <th>Сотрудник</th>
                    <th>Создан</th>
                    <th class="num">Позиций</th>
                    <th>Комментарий</th>
                    <th>Выдача</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in requests)
                {
                    <tr>
                        <td class="mono"><a href="/requests/@r.Id">@r.Number</a></td>
                        <td><span class="tag @Ui.RequestStateClass(r.Status)">@Ui.RequestState(r.Status)</span></td>
                        <td><a href="/employees/@r.EmployeeId">@r.EmployeeName</a></td>
                        <td>@Ui.Date(r.CreatedAt)</td>
                        <td class="num">@r.LineCount</td>
                        <td class="col-name">@r.Comment</td>
                        <td class="mono">
                            @if (r.DocumentId is long docId)
                            {
                                <a href="/documents/@docId">@r.DocumentNumber</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<IssueRequestSummaryDto>? requests;
    private bool openOnly;
    private int openCount;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        // Тем, кто выдаёт, — сразу ожидающие; сотруднику — все его запросы.
        var user = AuthState is null ? null : (await AuthState).User;
        openOnly = user is not null
            && (user.IsInRole(AppRoles.Storekeeper) || user.IsInRole(AppRoles.Admin) || user.IsInRole(AppRoles.ShiftLead));
        await LoadAsync();
    }

    private async Task SetOpenOnlyAsync(bool value)
    {
        openOnly = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            requests = await Api.GetIssueRequestsAsync(openOnly ? IssueRequestStatus.Open : null);
            openCount = openOnly ? requests.Count : requests.Count(r => r.Status == IssueRequestStatus.Open);
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
