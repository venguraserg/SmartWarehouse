@page "/documents/new/{Kind}"
@attribute [Authorize(Roles = AppRoles.Issuing)]
@inject ApiClient Api
@inject BrowserStore Store
@inject NavigationManager Nav
@inject ScannerHub Scanner
@implements IDisposable

<PageTitle>@Title — склад</PageTitle>

<h1>@Title</h1>
@if (Hint is not null)
{
    <p class="muted" style="margin-top: -.5rem">@Hint</p>
}

<Alert Error="@error" />

@if (notAllowed)
{
    <p>Старший смены оформляет только <a href="/documents/new/Issue">выдачу со склада</a> и <a href="/documents/new/Return">возврат</a>. Остальное — кладовщик.</p>
}
else if (type is null)
{
    <p>Неизвестный тип документа. <a href="/documents">К списку документов</a></p>
}
else if (!loaded)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else
{
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="panel">
            <div class="field-row">
                @if (UsesAccountable)
                {
                    <div class="field">
                        <label for="accountable">@Ui.AccountableLabel(type.Value) <span class="req">*</span></label>
                        <select id="accountable" @bind="accountableId" @bind:after="OnAccountableChangedAsync"
                                class="@(AccountableError is not null && showErrors ? "invalid" : null)">
                            <option value="">— выберите сотрудника —</option>
                            @foreach (var e in AccountableChoices)
                            {
                                <option value="@e.Id">@EmployeeLabel(e)@(e.IsActive ? "" : " (не работает)")</option>
                            }
                        </select>
                        @if (showErrors)
                        {
                            <FieldError Message="@AccountableError" />
                        }
                        @if (type == MovementType.Issue && activeEmployees.Count == 0)
                        {
                            <div class="field-hint">Сначала заведите <a href="/employees">сотрудников</a>.</div>
                        }
                        else if (type != MovementType.Issue && accountableId is not null && custody.Count == 0)
                        {
                            <div class="field-hint">За этим сотрудником ничего не числится.</div>
                        }
                    </div>
                }
                @if (type == MovementType.Receipt)
                {
                    <div class="field">
                        <label for="book">Вид учёта</label>
                        <select id="book" @bind="bookKind">
                            <option value="off">Вне учёта — б/у, снятое с оборудования, прочее</option>
                            <option value="book">Учётное (есть в 1С)</option>
                        </select>
                        <div class="field-hint">
                            @if (offBook)
                            {
                                <span>В 1С не числится: цена необязательна, в сверку с 1С не попадает.</span>
                            }
                            else
                            {
                                <span>Учётное лучше принимать <a href="/receiving">по накладной из 1С</a> — без ручного ввода и ошибок.</span>
                            }
                        </div>
                    </div>
                }
                <div class="field">
                    <label for="ext">@ExternalLabel@(RequiresNumber ? " *" : "")</label>
                    <input id="ext" type="text" @bind="externalNumber" @bind:event="oninput" maxlength="128"
                           class="@(showErrors && NumberError is not null ? "invalid" : null)" />
                    @if (showErrors)
                    {
                        <FieldError Message="@NumberError" />
                    }
                </div>
                <div class="field">
                    <label for="who">@(type == MovementType.WriteOff ? "Кто оформляет (кладовщик)" : "Кто проводит")</label>
                    @if (activeEmployees.Count > 0)
                    {
                        <select id="who" @bind="performedById">
                            <option value="">— не указан —</option>
                            @foreach (var e in activeEmployees)
                            {
                                <option value="@e.Id">@EmployeeLabel(e)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input id="who" type="text" @bind="performedBy" maxlength="128" placeholder="Фамилия И.О." />
                    }
                </div>
                @if (UsesEquipment)
                {
                    <div class="field">
                        <label for="eq">@(type == MovementType.WriteOff ? "Оборудование (куда установлено)" : "Оборудование")</label>
                        <div class="select-with-add">
                            <select id="eq" @bind="equipmentId">
                                <option value="">— не указано —</option>
                                @foreach (var e in equipment)
                                {
                                    <option value="@e.Item.Id">@(new string('\u00A0', e.Depth * 3))@e.Item.Code — @e.Item.Name</option>
                                }
                            </select>
                            @if (isStaff)
                            {
                                <button class="btn btn-sm" type="button" title="Новое оборудование" @onclick="() => quickEquipment = !quickEquipment">+</button>
                            }
                        </div>
                        @if (quickEquipment)
                        {
                            <QuickEquipment All="@equipment.Select(e => e.Item).ToList()" OnCreated="OnEquipmentCreatedAsync" OnCancel="() => quickEquipment = false" />
                        }
                    </div>
                }
            </div>
            <div class="field" style="margin-bottom: 0">
                @if (type == MovementType.WriteOff)
                {
                    <label for="comment">Куда использовано <span class="req">*</span></label>
                    <input id="comment" type="text" @bind="comment" @bind:event="oninput" maxlength="1000"
                           class="@(showErrors && UsageError is not null ? "invalid" : null)"
                           placeholder="Например: замена подшипника на насосе Н-3 при плановом ремонте" />
                    @if (showErrors)
                    {
                        <FieldError Message="@UsageError" />
                    }
                    <div class="field-hint">Укажите оборудование выше или опишите здесь — это попадёт в акт.</div>
                }
                else
                {
                    <label for="comment">Комментарий</label>
                    <input id="comment" type="text" @bind="comment" maxlength="1000" />
                }
            </div>
        </div>

        <h2>Строки</h2>
        <p class="scan-hint">
            📷 Ручной сканер: штрих-код или QR позиции — новая строка (повторно — +1 к количеству),
            QR ячейки — @ScanLocationHint.
        </p>
        @if (scanInfo is not null)
        {
            <div class="alert alert-success" role="status">@scanInfo</div>
        }

        @* ---------- Новая позиция прямо из прихода: документ остаётся заполненным ---------- *@
        @if (newItem is not null)
        {
            @* Не <form>: блок стоит внутри формы документа (вложенные формы недопустимы). Enter — «Создать» (js/latin-input.js). *@
            <div class="panel quick-add" style="margin-bottom: 1rem">
                <h2 style="margin-top: 0">Новая позиция номенклатуры</h2>
                <p class="muted" style="margin-top: -.5rem">
                    Приход не теряется: после создания позиция сразу встанет в строку. Остальное (фото, описание) — потом в карточке позиции.
                </p>
                <div class="field-row">
                    <div class="field" style="grid-column: span 2">
                        <label for="ni-name">Наименование <span class="req">*</span></label>
                        <input id="ni-name" type="text" @bind="newItem.Name" @bind:event="oninput" maxlength="256" placeholder="Подшипник 6205-2RS" />
                    </div>
                    <div class="field">
                        <label for="ni-cat">Категория</label>
                        <div class="select-with-add">
                            <select id="ni-cat" @bind="newItem.CategoryId" @bind:after="SuggestNewSkuAsync">
                                <option value="">— без категории —</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name@(string.IsNullOrEmpty(c.SkuPrefix) ? "" : $" ({c.SkuPrefix})")</option>
                                }
                            </select>
                            <button class="btn btn-sm" type="button" title="Новая категория" @onclick="() => quickCategory = !quickCategory">+</button>
                        </div>
                    </div>
                </div>
                @if (quickCategory)
                {
                    <QuickCategory OnCreated="OnCategoryCreatedAsync" OnCancel="() => quickCategory = false" />
                }
                <div class="field-row">
                    <div class="field">
                        <label for="ni-sku">Артикул <span class="req">*</span></label>
                        <div class="input-with-btn">
                            <input id="ni-sku" type="text" @bind="newItem.Sku" @bind:event="oninput" maxlength="64" data-latin="upper" autocomplete="off" spellcheck="false" />
                            <button class="btn btn-sm" type="button" title="Следующий свободный номер" @onclick="() => SuggestNewSkuAsync(force: true)">↻</button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="ni-unit">Единица <span class="req">*</span></label>
                        <div class="select-with-add">
                            <select id="ni-unit" @bind="newItem.UnitId">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Id">@u.Code — @u.Name</option>
                                }
                            </select>
                            <button class="btn btn-sm" type="button" title="Новая единица" @onclick="() => quickUnit = !quickUnit">+</button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="ni-barcode">Штрих-код с упаковки</label>
                        <input id="ni-barcode" type="text" @bind="newItem.Barcode" maxlength="64" data-latin data-scanner="off" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="field">
                        <label for="ni-min">Минимальный остаток</label>
                        <input id="ni-min" type="number" min="0" step="any" @bind="newItem.MinStock" />
                    </div>
                </div>
                @if (quickUnit)
                {
                    <QuickUnit OnCreated="OnUnitCreated" OnCancel="() => quickUnit = false" />
                }
                <FieldError Message="@newItemError" />
                <div class="actions">
                    <button class="btn btn-primary" type="button" @onclick="CreateNewItemAsync" disabled="@(saving || string.IsNullOrWhiteSpace(newItem.Name) || string.IsNullOrWhiteSpace(newItem.Sku) || newItem.UnitId == 0)">Создать и подставить в приход</button>
                    <button class="btn" type="button" @onclick="() => newItem = null">Отмена</button>
                </div>
            </div>
        }

        <datalist id="items-list">
            @foreach (var label in ItemChoices)
            {
                <option value="@label"></option>
            }
        </datalist>

        <div class="table-wrap">
            <table class="lines">
                <thead>
                    <tr>
                        <th class="num">№</th>
                        <th style="min-width: 260px">Позиция (артикул или наименование)</th>
                        @if (type == MovementType.Adjustment)
                        {
                            <th>Действие</th>
                        }
                        @if (ShowFromColumn)
                        {
                            <th style="min-width: 240px">Откуда</th>
                        }
                        @if (ShowToColumn)
                        {
                            <th style="min-width: 240px">Куда</th>
                        }
                        @if (ShowBatchColumn)
                        {
                            <th style="min-width: 200px">Партия</th>
                        }
                        @if (ShowPriceColumn)
                        {
                            <th style="width: 130px">Цена за ед.</th>
                        }
                        <th style="width: 130px">Количество</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < lines.Count; i++)
                    {
                        var line = lines[i];
                        var n = i + 1;
                        <tr>
                            <td class="num">@n</td>
                            <td>
                                <input type="text" list="items-list" @bind="line.ItemText" @bind:after="() => OnItemChangedAsync(line)"
                                       placeholder="Начните вводить…" class="@(ShowLineError(line) ? "invalid" : null)" />
                                @if (line.Item is not null)
                                {
                                    <div class="line-hint">@StockHint(line)</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(line.ItemText))
                                {
                                    <div class="line-hint" style="color: var(--danger)">
                                        Позиция не найдена — выберите из списка@(CanCreateItems ? "" : ".")
                                        @if (CanCreateItems)
                                        {
                                            <span>или </span>
                                            <button class="btn btn-sm" type="button" @onclick="() => StartNewItemAsync(line, line.ItemText, null)">+ создать новую</button>
                                        }
                                    </div>
                                }
                                @if (ShowLineError(line))
                                {
                                    <FieldError Message="@LineError(line)" />
                                }
                            </td>
                            @if (type == MovementType.Adjustment)
                            {
                                <td>
                                    <select @bind="line.Direction" @bind:after="() => OnDirectionChangedAsync(line)">
                                        <option value="plus">+ добавить</option>
                                        <option value="minus">− убрать</option>
                                    </select>
                                </td>
                            }
                            @if (ShowFromColumn)
                            {
                                <td>
                                    @if (NeedsFrom(line))
                                    {
                                        <select @bind="line.FromId" @bind:after="() => LoadBatchesAsync(line)" disabled="@(line.Item is null)">
                                            <option value="">@(line.Item is null ? "сначала позицию" : line.Available.Count == 0 ? "нет на складе" : "— выберите —")</option>
                                            @foreach (var a in line.Available)
                                            {
                                                <option value="@a.LocationId" title="@a.LocationCode">@PlacePath(a.LocationId, a.LocationCode) — @Ui.Qty(a.Quantity)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                            }
                            @if (ShowToColumn)
                            {
                                <td>
                                    @if (NeedsTo(line))
                                    {
                                        <select @bind="line.ToId" class="place-select">
                                            <option value="">— выберите —</option>
                                            @foreach (var l in leaves.OrderBy(l => PlacePath(l.Id), StringComparer.CurrentCultureIgnoreCase))
                                            {
                                                <option value="@l.Id" title="@l.FullCode">@PlacePath(l.Id)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                            }
                            @if (ShowBatchColumn)
                            {
                                <td>
                                    @if (TakesBatch(line))
                                    {
                                        <select @bind="line.BatchId" disabled="@(line.Batches.Count == 0)">
                                            <option value="">@(line.Batches.Count == 0 ? "—" : "самая старая")</option>
                                            @foreach (var b in line.Batches)
                                            {
                                                <option value="@b.BatchId">@Ui.Batch(b, line.Item?.UnitCode ?? "")</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="muted">новая</span>
                                    }
                                </td>
                            }
                            @if (ShowPriceColumn)
                            {
                                <td>
                                    @if (NeedsPrice(line))
                                    {
                                        <input type="number" min="0" step="0.01" @bind="line.UnitPrice"
                                               class="@(showErrors && line.UnitPrice is null && !PriceOptional ? "invalid" : null)" placeholder="@(PriceOptional ? "необязательно" : "0,00")" />
                                    }
                                    else
                                    {
                                        <span class="muted">по партии</span>
                                    }
                                </td>
                            }
                            <td>
                                <input type="number" min="0" step="any" @bind="line.Quantity" class="@(ShowLineError(line) && line.Quantity <= 0 ? "invalid" : null)" />
                                @if (line.Item is not null)
                                {
                                    <div class="line-hint">@line.Item.UnitCode</div>
                                }
                            </td>
                            <td>
                                <button class="btn btn-link" type="button" title="Удалить строку" @onclick="() => RemoveLine(line)" disabled="@(lines.Count == 1)">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="actions" style="margin-top: .75rem">
            <button class="btn" type="button" @onclick="AddLine">+ Строка</button>
            @if (FromEmployee && custody.Count > 0)
            {
                <button class="btn" type="button" @onclick="FillAllCustodyAsync">Заполнить всем, что числится</button>
            }
        </div>

        @if (leaves.Count == 0 && ShowToColumn)
        {
            <div class="alert alert-error" style="margin-top: 1rem">
                Нет ни одного места хранения. Сначала создайте склад и ячейки в разделе <a href="/warehouses">Склады и места</a>.
            </div>
        }

        @if (showErrors && (LinesWithErrors.Count > 0 || AccountableError is not null || UsageError is not null))
        {
            <div class="alert alert-error" style="margin-top: 1rem">
                @if (AccountableError is not null)
                {
                    <div>@AccountableError</div>
                }
                @if (UsageError is not null)
                {
                    <div>@UsageError</div>
                }
                @if (LinesWithErrors.Count > 0)
                {
                    <div>Проверьте строки: @(string.Join(", ", LinesWithErrors)). Ошибки показаны под позициями.</div>
                }
            </div>
        }

        <div class="actions" style="margin-top: 1.5rem">
            <button class="btn btn-primary" type="submit" disabled="@saving">
                @(type == MovementType.WriteOff ? "Списать и сформировать акт" : "Провести документ")
            </button>
            <a class="btn" href="/documents">Отмена</a>
        </div>
        <p class="muted">Документ проводится целиком: если в какой-то строке ошибка или не хватает остатка, не изменится ничего.</p>
    </form>
}

@code {
    [Parameter] public string Kind { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool notAllowed;

    /// <summary>Кладовщик или администратор: может заводить элементы справочников прямо из документа.</summary>
    private bool isStaff;

    private bool quickEquipment;
    private bool quickCategory;
    private bool quickUnit;

    /// <summary>Место хранения — строкой из описаний: «Склад запчастей › Стеллаж у ворот › Подшипники».</summary>
    private Dictionary<int, string> placePaths = [];

    private string PlacePath(int locationId, string? fallback = null) =>
        placePaths.TryGetValue(locationId, out var path) ? path : fallback ?? locationId.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task OnEquipmentCreatedAsync(EquipmentDto created)
    {
        try
        {
            equipment = EquipmentTree.Flatten(await Api.GetEquipmentAsync());
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        equipmentId = created.Id;
        quickEquipment = false;
    }

    private async Task OnCategoryCreatedAsync(CategoryDto created)
    {
        categories.Add(created);
        categories = categories.OrderBy(c => c.Name).ToList();
        quickCategory = false;
        if (newItem is not null)
        {
            newItem.CategoryId = created.Id;
            await SuggestNewSkuAsync();
        }
    }

    private void OnUnitCreated(UnitDto created)
    {
        units.Add(created);
        fractionalByUnit[created.Code] = created.IsFractional;
        quickUnit = false;
        if (newItem is not null)
            newItem.UnitId = created.Id;
    }

    /// <summary>Сотрудник подставляется сразу (переход «Списать» / «Вернуть» из карточки сотрудника).</summary>
    [SupplyParameterFromQuery(Name = "employee")] public int? EmployeeParam { get; set; }

    private MovementType? type;
    private bool loaded;
    private bool saving;
    private bool showErrors;
    private string? error;

    private Dictionary<string, ItemDto> itemsByLabel = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, bool> fractionalByUnit = new(StringComparer.OrdinalIgnoreCase);
    private List<LocationNodeDto> leaves = [];
    private List<(EquipmentDto Item, int Depth)> equipment = [];
    private List<EmployeeDto> allEmployees = [];
    private List<EmployeeDto> activeEmployees = [];
    private HashSet<int> custodyHolders = [];

    private string? externalNumber;

    /// <summary>Ручной приход по умолчанию — вне учёта (б/у и прочее); учётное приходит по накладной из 1С.</summary>
    private string bookKind = "off";

    private bool offBook => bookKind == "off";

    /// <summary>Приход вне учёта: цена необязательна.</summary>
    private bool PriceOptional => type == MovementType.Receipt && offBook;

    /// <summary>Учётное вручную — только с номером документа (по нему потом сверяться с 1С).</summary>
    private bool RequiresNumber => type == MovementType.Receipt && !offBook;

    private string? NumberError => RequiresNumber && string.IsNullOrWhiteSpace(externalNumber)
        ? "Для учётного прихода укажите номер и дату документа — как в 1С."
        : null;
    private string? performedBy;
    private int? performedById;
    private int? accountableId;
    private string? comment;
    private int? equipmentId;
    private List<LineModel> lines = [new()];

    /// <summary>Что числится за выбранным сотрудником: позиция → количество (для списания и возврата).</summary>
    private Dictionary<int, decimal> custody = new();

    // ---------- Тип документа ----------

    private string Title => type switch
    {
        MovementType.Receipt => "Приход",
        MovementType.Issue => "Выдача сотруднику",
        MovementType.Transfer => "Перемещение",
        MovementType.WriteOff => "Списание с сотрудника",
        MovementType.Adjustment => "Корректировка остатков",
        MovementType.Return => "Возврат на склад",
        _ => "Новый документ"
    };

    private string? Hint => type switch
    {
        MovementType.Issue => "Товар уходит из ячейки и числится за сотрудником, пока его не спишут или не вернут.",
        MovementType.WriteOff => "Сотрудник отчитывается, куда использовал полученное: позиции списываются с него и выбывают из учёта. После проведения формируется акт (PDF).",
        MovementType.Return => "Неиспользованное возвращается от сотрудника в ячейку склада.",
        MovementType.Adjustment => "Исправление остатков в ячейках по результатам пересчёта (в т.ч. брак, найденный на складе).",
        _ => null
    };

    private string ExternalLabel => type switch
    {
        MovementType.Receipt => "Накладная поставщика",
        MovementType.Issue => "Заявка / наряд",
        MovementType.WriteOff => "Наряд / основание",
        MovementType.Adjustment => "Акт инвентаризации",
        _ => "Основание"
    };

    private bool UsesAccountable => type is MovementType.Issue or MovementType.WriteOff or MovementType.Return;
    private bool FromEmployee => type is MovementType.WriteOff or MovementType.Return;
    private bool UsesEquipment => type is MovementType.Issue or MovementType.WriteOff;
    private bool ShowFromColumn => type is MovementType.Issue or MovementType.Transfer or MovementType.Adjustment;
    private bool ShowToColumn => type is MovementType.Receipt or MovementType.Transfer or MovementType.Adjustment or MovementType.Return;

    private bool NeedsFrom(LineModel line) =>
        type is MovementType.Issue or MovementType.Transfer
        || (type == MovementType.Adjustment && line.Minus);

    private bool NeedsTo(LineModel line) =>
        type is MovementType.Receipt or MovementType.Transfer or MovementType.Return
        || (type == MovementType.Adjustment && !line.Minus);

    /// <summary>Выдавать можно только работающим; списать и вернуть — и с уволенных, если за ними что-то числится.</summary>
    private IEnumerable<EmployeeDto> AccountableChoices =>
        type == MovementType.Issue ? activeEmployees : allEmployees.Where(e => e.IsActive || custodyHolders.Contains(e.Id));

    /// <summary>Подсказки позиций: при списании и возврате — только то, что числится за сотрудником.</summary>
    private IEnumerable<string> ItemChoices =>
        FromEmployee
            ? itemsByLabel.Where(kv => custody.ContainsKey(kv.Value.Id)).Select(kv => kv.Key)
            : itemsByLabel.Keys;

    private static string EmployeeLabel(EmployeeDto e) =>
        string.IsNullOrEmpty(e.Position) ? e.ShortName : $"{e.ShortName} — {e.Position}";

    private string StockHint(LineModel line) =>
        FromEmployee
            ? $"За сотрудником: {Ui.Qty(CustodyOf(line))} {line.Item!.UnitCode}"
            : $"Всего на складе: {Ui.Qty(line.Available.Sum(a => a.Quantity))} {line.Item!.UnitCode}";

    // ---------- Загрузка ----------

    protected override async Task OnParametersSetAsync()
    {
        // Компонент переиспользуется при переходе между типами — начинаем документ заново.
        type = Enum.TryParse<MovementType>(Kind, ignoreCase: true, out var parsed) && Enum.IsDefined(parsed) ? parsed : null;

        // Старший смены (без роли кладовщика) — только выдача и возврат.
        isStaff = AuthState is not null && (await AuthState).User.IsWarehouseStaff();
        notAllowed = type is not (null or MovementType.Issue or MovementType.Return or MovementType.WriteOff) && !isStaff;
        if (notAllowed)
            return;

        // Списание оформляется актом на списание (с утверждением руководителем).
        if (type == MovementType.WriteOff)
        {
            Nav.NavigateTo(EmployeeParam is int forEmployee ? $"/acts/new?employee={forEmployee}" : "/acts/new", replace: true);
            return;
        }
        lines = [new()];
        externalNumber = comment = null;
        equipmentId = null;
        accountableId = null;
        custody = new();
        error = null;
        showErrors = false;
        scannedLocationId = null;
        scanInfo = null;

        if (type is null)
            return;

        if (!loaded)
        {
            try
            {
                var items = await Api.GetItemsAsync();
                itemsByLabel = items
                    .Where(i => i.IsActive)
                    .ToDictionary(i => $"{i.Sku} · {i.Name}", StringComparer.OrdinalIgnoreCase);
                (leaves, placePaths) = await Api.GetPlacesAsync();
                equipment = EquipmentTree.Flatten(await Api.GetEquipmentAsync());
                units = await Api.GetUnitsAsync();
                fractionalByUnit = units.ToDictionary(u => u.Code, u => u.IsFractional, StringComparer.OrdinalIgnoreCase);
                allEmployees = await Api.GetEmployeesAsync(includeInactive: true);
                activeEmployees = allEmployees.Where(e => e.IsActive).ToList();
                custodyHolders = (await Api.GetCustodyAsync()).Select(r => r.EmployeeId).ToHashSet();

                // Кто проводит — как в прошлый раз на этом компьютере.
                var lastPerformer = await Store.GetIntAsync("doc.performedById");
                performedById = activeEmployees.Any(e => e.Id == lastPerformer) ? lastPerformer : null;
                performedBy ??= await Store.GetAsync("doc.performedBy");
                loaded = true;
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                error = $"Не удалось загрузить справочники: {ex.Message}";
                return;
            }
        }

        if (UsesAccountable && EmployeeParam is int employeeId && AccountableChoices.Any(e => e.Id == employeeId))
        {
            accountableId = employeeId;
            await OnAccountableChangedAsync();
        }
    }

    /// <summary>Выбран сотрудник: для списания и возврата загружаем, что за ним числится.</summary>
    private async Task OnAccountableChangedAsync()
    {
        custody = new();
        if (FromEmployee && accountableId is int id)
        {
            try
            {
                // Зарезервированное в актах на утверждении вернуть нельзя — считаем только свободное.
                custody = (await Api.GetCustodyAsync(employeeId: id))
                    .Where(r => r.Quantity - r.Reserved > 0)
                    .ToDictionary(r => r.ItemId, r => r.Quantity - r.Reserved);
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                error = ex.Message;
            }
        }

        // Возврат: партии теперь — из подотчёта выбранного сотрудника.
        foreach (var line in lines.Where(l => l.Item is not null))
            await LoadBatchesAsync(line);
    }

    private async Task OnItemChangedAsync(LineModel line)
    {
        var text = line.ItemText?.Trim() ?? "";
        line.Item = itemsByLabel.TryGetValue(text, out var byLabel)
            ? byLabel
            : itemsByLabel.Values.FirstOrDefault(i => string.Equals(i.Sku, text, StringComparison.OrdinalIgnoreCase));

        line.Available = [];
        line.FromId = null;

        if (line.Item is null)
            return;

        line.ItemText = $"{line.Item.Sku} · {line.Item.Name}";
        try
        {
            line.Available = await Api.GetBalancesAsync(line.Item.Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }

        // При списании и возврате по умолчанию — всё, что числится за сотрудником по этой позиции.
        if (FromEmployee && line.Quantity == 1 && CustodyOf(line) > 0)
            line.Quantity = CustodyOf(line);

        await PrefillLocationsAsync(line);
        await LoadBatchesAsync(line);
    }

    /// <summary>
    /// Предзаполнение мест в строке:
    /// «Откуда» — место, где этой позиции больше всего;
    /// «Куда» (приход, возврат, корректировка «+») — место, где позиция уже лежит, иначе ячейка прошлого прихода.
    /// Перемещение «куда» не подставляем: его пользователь выбирает сам.
    /// </summary>
    private async Task PrefillLocationsAsync(LineModel line)
    {
        if (line.Item is null)
            return;

        if (NeedsFrom(line) && (line.FromId is null || line.Available.All(a => a.LocationId != line.FromId)))
            line.FromId = line.Available.OrderByDescending(a => a.Quantity).FirstOrDefault()?.LocationId;

        if (NeedsTo(line) && line.ToId is null && type != MovementType.Transfer)
        {
            var whereItLies = line.Available
                .OrderByDescending(a => a.Quantity)
                .Select(a => (int?)a.LocationId)
                .FirstOrDefault(id => leaves.Any(l => l.Id == id));

            var lastTo = await Store.GetIntAsync("doc.lastTo");

            line.ToId = whereItLies
                ?? (leaves.Any(l => l.Id == lastTo) ? lastTo : null)
                ?? (leaves.Count == 1 ? (int?)leaves[0].Id : null);
        }

        StateHasChanged();
    }

    /// <summary>Строки по всему, что числится за сотрудником (удобно при увольнении или закрытии наряда).</summary>
    private async Task FillAllCustodyAsync()
    {
        lines = [];
        foreach (var (itemId, quantity) in custody)
        {
            var label = itemsByLabel.FirstOrDefault(kv => kv.Value.Id == itemId).Key;
            if (label is null) continue;

            var line = new LineModel { ItemText = label, Quantity = quantity };
            lines.Add(line);
            await OnItemChangedAsync(line);
        }
        if (lines.Count == 0)
            lines.Add(new LineModel());
    }

    private void AddLine() => lines.Add(new LineModel { Direction = lines.LastOrDefault()?.Direction ?? "plus" });

    private void RemoveLine(LineModel line)
    {
        if (lines.Count > 1)
            lines.Remove(line);
    }

    // ---------- Проверка (до отправки на сервер) ----------

    private decimal CustodyOf(LineModel line) =>
        line.Item is not null && custody.TryGetValue(line.Item.Id, out var q) ? q : 0;

    /// <summary>Акт списания должен отвечать на вопрос «куда пошло».</summary>
    private string? UsageError =>
        type == MovementType.WriteOff && equipmentId is null && string.IsNullOrWhiteSpace(comment)
            ? "Укажите оборудование или опишите, куда использовано."
            : null;

    private string? AccountableError =>
        UsesAccountable && accountableId is null ? $"Укажите сотрудника: «{Ui.AccountableLabel(type!.Value)}»." : null;

    private bool ShowLineError(LineModel line) =>
        LineError(line) is not null && (showErrors || line.Item is not null);

    private string? LineError(LineModel line)
    {
        if (line.Item is null)
            return "Выберите позицию из списка.";

        if (line.Quantity <= 0)
            return "Количество должно быть больше нуля.";

        if (fractionalByUnit.TryGetValue(line.Item.UnitCode, out var fractional) && !fractional
            && line.Quantity != decimal.Truncate(line.Quantity))
            return $"«{line.Item.UnitCode}» — только целое количество.";

        var above = lines.TakeWhile(l => !ReferenceEquals(l, line)).Where(l => l.Item?.Id == line.Item.Id).ToList();

        if (FromEmployee && accountableId is not null)
        {
            if (CustodyOf(line) == 0)
                return "За сотрудником эта позиция не числится.";
            var left = CustodyOf(line) - above.Sum(l => l.Quantity);
            if (line.Quantity > left)
                return $"За сотрудником числится только {Ui.Qty(Math.Max(0, left))} {line.Item.UnitCode}.";
        }

        if (NeedsFrom(line))
        {
            if (line.Available.Count == 0)
                return "Этой позиции нет на складе.";
            if (line.FromId is null)
                return "Выберите, откуда взять.";

            // Учитываем другие строки этого документа, которые берут из того же места.
            var available = line.Available.FirstOrDefault(a => a.LocationId == line.FromId)?.Quantity ?? 0;
            var takenAbove = above.Where(l => NeedsFrom(l) && l.FromId == line.FromId).Sum(l => l.Quantity);
            if (line.Quantity > available - takenAbove)
                return $"В этом месте есть только {Ui.Qty(Math.Max(0, available - takenAbove))} {line.Item.UnitCode}.";
        }

        if (NeedsPrice(line))
        {
            if (line.UnitPrice is null && !PriceOptional)
                return "Укажите цену за единицу.";
            if (line.UnitPrice < 0)
                return "Цена не может быть отрицательной.";
        }

        if (NeedsTo(line) && line.ToId is null)
            return "Выберите, куда положить.";

        if (type == MovementType.Transfer && line.FromId is not null && line.FromId == line.ToId)
            return "Место отправления и назначения совпадают.";

        return null;
    }

    private List<int> LinesWithErrors =>
        lines.Select((l, i) => (l, n: i + 1)).Where(x => LineError(x.l) is not null).Select(x => x.n).ToList();

    // ---------- Проведение ----------

    private async Task SubmitAsync()
    {
        error = null;
        showErrors = true;

        if (LinesWithErrors.Count > 0 || AccountableError is not null || UsageError is not null || NumberError is not null)
            return;

        var request = new CreateDocumentRequest(
            type!.Value,
            externalNumber,
            UsesEquipment ? equipmentId : null,
            performedById is null ? performedBy : null,
            comment,
            lines.Select(l => new DocumentLineRequest(
                l.Item!.Id,
                l.Quantity,
                NeedsFrom(l) ? l.FromId : null,
                NeedsTo(l) ? l.ToId : null,
                TakesBatch(l) ? l.BatchId : null,
                NeedsPrice(l) ? l.UnitPrice : null)).ToList(),
            PerformedById: performedById,
            ReceivedById: UsesAccountable ? accountableId : null,
            OffBook: PriceOptional);

        saving = true;
        try
        {
            var doc = await Api.PostDocumentAsync(request);

            await Store.SetAsync("doc.performedBy", performedBy);
            await Store.SetAsync("doc.performedById", performedById);
            var lastTo = lines.Where(NeedsTo).Select(l => l.ToId).LastOrDefault(id => id is not null);
            if (lastTo is not null)
                await Store.SetAsync("doc.lastTo", lastTo);

            Nav.NavigateTo($"/documents/{doc.Id}");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    // ---------- Ручной сканер ----------

    private IDisposable? scanSubscription;
    private string? scanInfo;

    /// <summary>Последняя отсканированная ячейка — подставляется в новые строки.</summary>
    private int? scannedLocationId;

    protected override void OnInitialized() => scanSubscription = Scanner.Subscribe(OnScanAsync);

    public void Dispose() => scanSubscription?.Dispose();

    private string ScanLocationHint => type switch
    {
        MovementType.Receipt or MovementType.Return => "куда положить (для текущей и следующих строк)",
        MovementType.Issue => "откуда взять",
        MovementType.Transfer => "сначала откуда, затем куда",
        MovementType.Adjustment => "место корректировки",
        _ => "место"
    };

    /// <summary>Код со сканера на странице документа: позиция — строка, ячейка — место в строке.</summary>
    private async Task<bool> OnScanAsync(string code)
    {
        if (type is null || !loaded)
            return false;

        ScanResultDto found;
        try
        {
            found = await Api.ScanAsync(code);
        }
        catch (ApiException ex) when (ex.Status == System.Net.HttpStatusCode.NotFound && CanCreateItems)
        {
            // В приходе незнакомый штрих-код — сразу предлагаем завести позицию с этим штрих-кодом.
            scanInfo = null;
            error = null;
            await StartNewItemAsync(null, null, code.Trim());
            StateHasChanged();
            return true;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            scanInfo = null;
            error = ex.Message;
            StateHasChanged();
            return true;
        }

        error = null;
        if (found.Kind == ScanKind.Item)
            await AddScannedItemAsync(found);
        else
            ApplyScannedLocation(found);

        // Место «откуда» могло смениться — обновляем список партий строки.
        if (lines.LastOrDefault(l => l.Item is not null) is { } current)
            await LoadBatchesAsync(current);
        StateHasChanged();
        return true;
    }

    private async Task AddScannedItemAsync(ScanResultDto found)
    {
        var entry = itemsByLabel.FirstOrDefault(kv => kv.Value.Id == found.Id);
        if (entry.Value is null)
        {
            error = $"Позиция {found.Code} неактивна — операции с ней запрещены.";
            return;
        }
        var item = entry.Value;

        if (FromEmployee)
        {
            if (accountableId is null)
            {
                error = "Сначала выберите сотрудника.";
                return;
            }
            if (!custody.ContainsKey(item.Id))
            {
                error = $"За сотрудником не числится {item.Sku} · {item.Name}.";
                return;
            }
        }

        // Повторный скан — +1 к строке с этой позицией.
        var existing = lines.LastOrDefault(l => l.Item?.Id == item.Id);
        if (existing is not null)
        {
            existing.Quantity += 1;
            scanInfo = $"{item.Sku} · {item.Name}: {Ui.Qty(existing.Quantity)} {item.UnitCode}";
            return;
        }

        var line = lines.FirstOrDefault(l => l.Item is null && string.IsNullOrWhiteSpace(l.ItemText));
        if (line is null)
        {
            line = new LineModel { Direction = lines.LastOrDefault()?.Direction ?? "plus" };
            lines.Add(line);
        }
        line.ItemText = entry.Key;
        await OnItemChangedAsync(line);
        line.Quantity = 1; // сканер считает поштучно

        // Ранее отсканированная ячейка — в новую строку.
        if (scannedLocationId is int locationId)
        {
            if (NeedsTo(line) && type != MovementType.Transfer && leaves.Any(l => l.Id == locationId))
                line.ToId = locationId;
            else if (NeedsFrom(line) && line.Available.Any(a => a.LocationId == locationId))
            {
                line.FromId = locationId;
                line.FromScanned = true;
            }
        }

        scanInfo = $"Добавлено: {item.Sku} · {item.Name}";
    }

    private void ApplyScannedLocation(ScanResultDto found)
    {
        var leaf = leaves.FirstOrDefault(l => l.Id == found.Id);
        if (leaf is null)
        {
            error = $"{found.Code} содержит вложенные места — отсканируйте конкретную ячейку.";
            return;
        }

        var line = lines.LastOrDefault(l => l.Item is not null);
        var here = line?.Available.FirstOrDefault(a => a.LocationId == found.Id);

        if (line is not null && type == MovementType.Transfer)
        {
            // Перемещение: ячейка, где позиция лежит, — «откуда» (если ещё не сканировали), иначе — «куда».
            if (here is not null && !line.FromScanned)
            {
                line.FromId = found.Id;
                line.FromScanned = true;
                scanInfo = $"Откуда: {found.Code}";
            }
            else if (found.Id != line.FromId)
            {
                line.ToId = found.Id;
                scanInfo = $"Куда: {found.Code}";
            }
            return;
        }

        scannedLocationId = found.Id;

        if (line is null)
        {
            scanInfo = $"Ячейка {found.Code} — теперь сканируйте позиции.";
            return;
        }

        if (NeedsTo(line))
        {
            line.ToId = found.Id;
            scanInfo = $"Куда: {found.Code} (и для следующих строк)";
        }
        else if (NeedsFrom(line))
        {
            if (here is null)
            {
                error = $"В {found.Code} нет «{line.Item!.Name}».";
                return;
            }
            line.FromId = found.Id;
            line.FromScanned = true;
            scanInfo = $"Откуда: {found.Code}";
        }
        else
        {
            scanInfo = $"Ячейка {found.Code}";
        }
    }

    // ---------- Новая позиция из прихода ----------

    /// <summary>Заводить позиции на ходу можно в приходе (его оформляет кладовщик или администратор).</summary>
    private bool CanCreateItems => type == MovementType.Receipt;

    private NewItemModel? newItem;
    private LineModel? newItemLine;
    private string? newItemError;
    private string? newItemSuggestedSku;
    private List<UnitDto> units = [];
    private List<CategoryDto> categories = [];

    /// <param name="line">Строка, куда подставить позицию; null — первая пустая или новая.</param>
    /// <param name="text">Что ввели в строке: похоже на артикул — в артикул, иначе в наименование.</param>
    /// <param name="barcode">Отсканированный незнакомый штрих-код.</param>
    private async Task StartNewItemAsync(LineModel? line, string? text, string? barcode)
    {
        newItemLine = line;
        newItemError = null;
        text = text?.Trim();
        var looksLikeSku = !string.IsNullOrEmpty(text) && !text.Contains(' ') && text.Any(char.IsDigit);

        newItem = new NewItemModel
        {
            Name = looksLikeSku ? null : text,
            Barcode = barcode,
            UnitId = units.FirstOrDefault(u => u.Code == "шт")?.Id ?? units.FirstOrDefault()?.Id ?? 0
        };
        try
        {
            if (categories.Count == 0)
                categories = await Api.GetCategoriesAsync();
            var lastCategory = await Store.GetIntAsync("item.category");
            newItem.CategoryId = categories.Any(c => c.Id == lastCategory) ? lastCategory : null;
            if (looksLikeSku)
                newItem.Sku = text!.ToUpperInvariant();
            else
                await SuggestNewSkuAsync(force: true);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            newItemError = ex.Message;
        }
    }

    private Task SuggestNewSkuAsync() => SuggestNewSkuAsync(force: false);

    /// <summary>Свободный артикул по категории; введённый вручную не перезаписывается (кроме кнопки ↻).</summary>
    private async Task SuggestNewSkuAsync(bool force)
    {
        if (newItem is null || (!force && !string.IsNullOrWhiteSpace(newItem.Sku) && newItem.Sku != newItemSuggestedSku))
            return;
        try
        {
            newItem.Sku = newItemSuggestedSku = await Api.GetNextSkuAsync(newItem.CategoryId);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            newItemError = ex.Message;
        }
    }

    private async Task CreateNewItemAsync()
    {
        if (newItem is null)
            return;
        saving = true;
        newItemError = null;
        try
        {
            var item = await Api.CreateItemAsync(new CreateItemRequest(
                newItem.Sku!.Trim(), newItem.Name!.Trim(), newItem.CategoryId, newItem.UnitId,
                Math.Max(0, newItem.MinStock), null, null, string.IsNullOrWhiteSpace(newItem.Barcode) ? null : newItem.Barcode.Trim()));

            var label = $"{item.Sku} · {item.Name}";
            itemsByLabel[label] = item;

            var line = newItemLine is not null && lines.Contains(newItemLine)
                ? newItemLine
                : lines.FirstOrDefault(l => l.Item is null && string.IsNullOrWhiteSpace(l.ItemText));
            if (line is null)
            {
                line = new LineModel();
                lines.Add(line);
            }
            line.ItemText = label;
            await OnItemChangedAsync(line);

            scanInfo = $"Позиция {item.Sku} «{item.Name}» создана и добавлена в приход — укажите количество, цену и место.";
            newItem = null;
            newItemLine = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            newItemError = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class NewItemModel
    {
        public string? Name { get; set; }
        public string? Sku { get; set; }
        public int? CategoryId { get; set; }
        public int UnitId { get; set; }
        public string? Barcode { get; set; }
        public decimal MinStock { get; set; }
    }

    private sealed class LineModel
    {
        /// <summary>«Откуда» задано сканированием (для перемещения следующий скан ячейки — «куда»).</summary>
        public bool FromScanned { get; set; }

        public string? ItemText { get; set; }
        public ItemDto? Item { get; set; }
        public decimal Quantity { get; set; } = 1;
        public int? FromId { get; set; }
        public int? ToId { get; set; }

        /// <summary>Для корректировки: «plus» — увеличить остаток, «minus» — уменьшить.</summary>
        public string Direction { get; set; } = "plus";

        public bool Minus => Direction == "minus";

        public List<StockBalanceDto> Available { get; set; } = [];

        /// <summary>Партия, откуда взять (null — самая старая).</summary>
        public int? BatchId { get; set; }

        /// <summary>Партии в выбранном месте (или у сотрудника — для возврата).</summary>
        public List<BatchStockDto> Batches { get; set; } = [];

        /// <summary>Цена за единицу — для прихода и корректировки «+» (новая партия).</summary>
        public decimal? UnitPrice { get; set; }
    }

    // ---------- Партии и цены ----------

    /// <summary>Колонка «Партия» — там, где товар откуда-то берётся.</summary>
    private bool ShowBatchColumn => type is MovementType.Issue or MovementType.Transfer or MovementType.Return or MovementType.Adjustment;

    /// <summary>Колонка «Цена» — где поступает новая партия.</summary>
    private bool ShowPriceColumn => type is MovementType.Receipt or MovementType.Adjustment;

    private bool TakesBatch(LineModel line) => NeedsFrom(line) || FromEmployee;

    private bool NeedsPrice(LineModel line) =>
        type == MovementType.Receipt || (type == MovementType.Adjustment && !line.Minus);

    private async Task OnDirectionChangedAsync(LineModel line)
    {
        await PrefillLocationsAsync(line);
        await LoadBatchesAsync(line);
    }

    /// <summary>Партии позиции в месте «откуда» (или у сотрудника при возврате); выбор сбрасывается, если партии там нет.</summary>
    private async Task LoadBatchesAsync(LineModel line)
    {
        line.Batches = [];
        try
        {
            if (line.Item is not null && NeedsFrom(line) && line.FromId is int fromId)
                line.Batches = await Api.GetBatchesAsync(line.Item.Id, locationId: fromId);
            else if (line.Item is not null && FromEmployee && accountableId is int employeeId)
                line.Batches = await Api.GetBatchesAsync(line.Item.Id, employeeId: employeeId);

            // Для прихода — подсказка цены: последняя известная по позиции.
            if (line.Item is not null && NeedsPrice(line) && line.UnitPrice is null && !PriceOptional)
                line.UnitPrice = (await Api.GetBatchesAsync(line.Item.Id))
                    .Where(b => b.UnitPrice is not null)
                    .OrderByDescending(b => b.ReceivedAt)
                    .FirstOrDefault()?.UnitPrice;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        if (line.BatchId is int chosen && line.Batches.All(b => b.BatchId != chosen))
            line.BatchId = null;
        StateHasChanged();
    }
}
