@page "/references"
@attribute [Authorize(Roles = AppRoles.Warehouse)]
@inject ApiClient Api

<PageTitle>Справочники — склад</PageTitle>

<h1>Справочники</h1>

<Alert Error="@error" Success="@success" />

<div class="grid-2">
    <section class="panel">
        <h2 style="margin-top: 0">Категории</h2>
        <form class="inline-form" @onsubmit="AddCategoryAsync" @onsubmit:preventDefault>
            <div class="field">
                <label for="cat-name">Новая категория</label>
                <input id="cat-name" type="text" @bind="categoryName" @bind:event="oninput" maxlength="128" placeholder="Подшипники"
                       class="@(CategoryError is not null ? "invalid" : null)" />
            </div>
            <button class="btn btn-primary" type="submit" disabled="@(CategoryError is not null || string.IsNullOrWhiteSpace(categoryName) || busy)">Добавить</button>
        </form>
        <FieldError Message="@CategoryError" />
        <table style="margin-top: 1rem">
            <tbody>
                @foreach (var c in categories)
                {
                    if (IsEditing("categories", c.Id))
                    {
                        <tr>
                            <td colspan="2">
                                <div class="inline-form">
                                    <input type="text" @bind="editName" maxlength="128" aria-label="Название" />
                                    <button class="btn btn-primary btn-sm" type="button" disabled="@(busy || string.IsNullOrWhiteSpace(editName))"
                                            @onclick="() => SaveAsync(() => Api.UpdateCategoryAsync(c.Id, new UpdateCategoryRequest(editName!, c.Description)))">Сохранить</button>
                                    <button class="btn btn-sm" type="button" @onclick="CancelEdit">Отмена</button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td class="row-actions">
                                @if (isAdmin)
                                {
                                    <RowAdminActions Confirming="@IsConfirming("categories", c.Id)" Busy="busy"
                                                     DeleteHint="Позиции останутся — без категории."
                                                     OnEdit='() => StartEdit("categories", c.Id, c.Name)'
                                                     OnAskDelete='() => AskDelete("categories", c.Id)'
                                                     OnCancelDelete="CancelEdit"
                                                     OnDelete='() => DeleteAsync("categories", c.Id)' />
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (categories.Count == 0)
        {
            <p class="muted">Категорий пока нет.</p>
        }
    </section>

    <section class="panel">
        <h2 style="margin-top: 0">Единицы измерения</h2>
        <form class="inline-form" @onsubmit="AddUnitAsync" @onsubmit:preventDefault>
            <div class="field" style="max-width: 110px">
                <label for="unit-code">Обозначение</label>
                <input id="unit-code" type="text" @bind="unitCode" @bind:event="oninput" maxlength="16" placeholder="пар"
                       class="@(UnitCodeError is not null ? "invalid" : null)" />
            </div>
            <div class="field">
                <label for="unit-name">Название</label>
                <input id="unit-name" type="text" @bind="unitName" @bind:event="oninput" maxlength="64" placeholder="пара" />
            </div>
            <label class="checkbox" style="margin-bottom: .5rem"><input type="checkbox" @bind="unitFractional" /> дробная</label>
            <button class="btn btn-primary" type="submit" disabled="@(!UnitFormValid || busy)">Добавить</button>
        </form>
        <FieldError Message="@UnitCodeError" />
        <div class="field-hint">«Дробная» — можно учитывать 0,5 (метры, литры). Для штук оставьте выключенным.</div>
        <table style="margin-top: 1rem">
            <thead><tr><th>Обозн.</th><th>Название</th><th>Количество</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in units)
                {
                    if (IsEditing("units", u.Id))
                    {
                        <tr>
                            <td><input type="text" @bind="editCode" maxlength="16" aria-label="Обозначение" style="max-width: 80px" /></td>
                            <td><input type="text" @bind="editName" maxlength="64" aria-label="Название" /></td>
                            <td><label class="checkbox"><input type="checkbox" @bind="editFractional" /> дробное</label></td>
                            <td class="row-actions">
                                <button class="btn btn-primary btn-sm" type="button" disabled="@(busy || string.IsNullOrWhiteSpace(editCode) || string.IsNullOrWhiteSpace(editName))"
                                        @onclick="() => SaveAsync(() => Api.UpdateUnitAsync(u.Id, new UpdateUnitRequest(editCode!, editName!, editFractional)))">Сохранить</button>
                                <button class="btn btn-sm" type="button" @onclick="CancelEdit">Отмена</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@u.Code</td>
                            <td>@u.Name</td>
                            <td class="muted">@(u.IsFractional ? "дробное" : "целое")</td>
                            <td class="row-actions">
                                @if (isAdmin)
                                {
                                    <RowAdminActions Confirming="@IsConfirming("units", u.Id)" Busy="busy"
                                                     DeleteHint="Только если не указана ни у одной позиции."
                                                     OnEdit='() => StartEdit("units", u.Id, u.Name, u.Code, fractional: u.IsFractional)'
                                                     OnAskDelete='() => AskDelete("units", u.Id)'
                                                     OnCancelDelete="CancelEdit"
                                                     OnDelete='() => DeleteAsync("units", u.Id)' />
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
</div>

<section class="panel" style="margin-top: 1rem">
    <h2 style="margin-top: 0">Оборудование</h2>
    <p class="muted">Участки, установки и узлы — на них оформляется выдача запчастей.</p>
    <form class="inline-form" @onsubmit="AddEquipmentAsync" @onsubmit:preventDefault>
        <div class="field">
            <label for="eq-parent">Входит в</label>
            <select id="eq-parent" @bind="equipmentParentId" @bind:after="SuggestEquipmentCode">
                <option value="">— верхний уровень (участок) —</option>
                @foreach (var e in equipmentTree)
                {
                    <option value="@e.Item.Id">@(new string(' ', e.Depth * 3))@e.Item.Code — @e.Item.Name</option>
                }
            </select>
        </div>
        <div class="field" style="max-width: 160px">
            <label for="eq-code">Код <span class="req">*</span></label>
            <input id="eq-code" type="text" @bind="equipmentCode" @bind:event="oninput" maxlength="64"
                   class="@(EquipmentCodeError is not null ? "invalid" : null)" />
        </div>
        <div class="field">
            <label for="eq-name">Наименование <span class="req">*</span></label>
            <input id="eq-name" type="text" @bind="equipmentName" @bind:event="oninput" maxlength="256" placeholder="Насос центробежный" />
        </div>
        <button class="btn btn-primary" type="submit" disabled="@(!EquipmentFormValid || busy)">Добавить</button>
    </form>
    <FieldError Message="@EquipmentCodeError" />

    <div class="table-wrap" style="margin-top: 1rem">
        <table>
            <thead><tr><th>Код</th><th>Наименование</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in equipmentTree)
                {
                    if (IsEditing("equipment", e.Item.Id))
                    {
                        <tr>
                            <td colspan="3">
                                <div class="inline-form">
                                    <div class="field">
                                        <label>Входит в</label>
                                        <select @bind="editParentId">
                                            <option value="">— верхний уровень —</option>
                                            @foreach (var p in EquipmentParentChoices(e.Item.Id))
                                            {
                                                <option value="@p.Item.Id">@(new string('\u00A0', p.Depth * 3))@p.Item.Code — @p.Item.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field" style="max-width: 160px">
                                        <label>Код</label>
                                        <input type="text" @bind="editCode" maxlength="64" />
                                    </div>
                                    <div class="field">
                                        <label>Наименование</label>
                                        <input type="text" @bind="editName" maxlength="256" />
                                    </div>
                                    <button class="btn btn-primary btn-sm" type="button" disabled="@(busy || string.IsNullOrWhiteSpace(editCode) || string.IsNullOrWhiteSpace(editName))"
                                            @onclick="() => SaveAsync(() => Api.UpdateEquipmentAsync(e.Item.Id, new UpdateEquipmentRequest(editParentId, editCode!, editName!)))">Сохранить</button>
                                    <button class="btn btn-sm" type="button" @onclick="CancelEdit">Отмена</button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="mono" style="@Indent(e.Depth)">@e.Item.Code</td>
                            <td>@e.Item.Name</td>
                            <td class="row-actions">
                                @if (isAdmin)
                                {
                                    <RowAdminActions Confirming="@IsConfirming("equipment", e.Item.Id)" Busy="busy"
                                                     DeleteHint="Только если не указано в документах и актах и в него ничего не входит."
                                                     OnEdit='() => StartEdit("equipment", e.Item.Id, e.Item.Name, e.Item.Code, parentId: e.Item.ParentId)'
                                                     OnAskDelete='() => AskDelete("equipment", e.Item.Id)'
                                                     OnCancelDelete="CancelEdit"
                                                     OnDelete='() => DeleteAsync("equipment", e.Item.Id)' />
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (equipmentTree.Count == 0)
        {
            <div class="empty">Оборудование не заведено.</div>
        }
    </div>
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isAdmin;

    // ---------- Правка строки (администратор) ----------

    private string? editKind;
    private int editId;
    private bool confirming;
    private string? editName;
    private string? editCode;
    private bool editFractional;
    private int? editParentId;

    private bool IsEditing(string kind, int id) => editKind == kind && editId == id && !confirming;

    private bool IsConfirming(string kind, int id) => editKind == kind && editId == id && confirming;

    private void StartEdit(string kind, int id, string name, string? code = null, bool fractional = false, int? parentId = null)
    {
        error = success = null;
        editKind = kind;
        editId = id;
        confirming = false;
        editName = name;
        editCode = code;
        editFractional = fractional;
        editParentId = parentId;
    }

    private void AskDelete(string kind, int id)
    {
        error = success = null;
        editKind = kind;
        editId = id;
        confirming = true;
    }

    private void CancelEdit()
    {
        editKind = null;
        confirming = false;
    }

    /// <summary>Куда можно перенести оборудование: не в себя и не в свои узлы.</summary>
    private IEnumerable<(EquipmentDto Item, int Depth)> EquipmentParentChoices(int id)
    {
        var excluded = new HashSet<int> { id };
        bool changed;
        do
        {
            changed = false;
            foreach (var e in equipment.Where(e => e.ParentId is int p && excluded.Contains(p)))
                changed |= excluded.Add(e.Id);
        } while (changed);
        return equipmentTree.Where(x => !excluded.Contains(x.Item.Id));
    }

    private Task SaveAsync(Func<Task<ReferenceChangeResult>> save) => RunAsync(async () =>
    {
        success = (await save()).Message;
        CancelEdit();
    });

    private Task DeleteAsync(string what, int id) => RunAsync(async () =>
    {
        try
        {
            success = (await Api.DeleteReferenceAsync(what, id)).Message;
        }
        finally
        {
            CancelEdit();
        }
    });

    private List<CategoryDto> categories = [];
    private List<UnitDto> units = [];
    private List<EquipmentDto> equipment = [];
    private List<(EquipmentDto Item, int Depth)> equipmentTree = [];

    private string? categoryName;
    private string? unitCode;
    private string? unitName;
    private bool unitFractional;
    private int? equipmentParentId;
    private string? equipmentCode;
    private string? equipmentName;

    private bool busy;
    private string? error;
    private string? success;

    // ---------- Проверки ----------

    private string? CategoryError =>
        !string.IsNullOrWhiteSpace(categoryName)
        && categories.Any(c => string.Equals(c.Name, categoryName.Trim(), StringComparison.OrdinalIgnoreCase))
            ? $"Категория «{categoryName.Trim()}» уже есть."
            : null;

    private string? UnitCodeError =>
        !string.IsNullOrWhiteSpace(unitCode)
        && units.Any(u => string.Equals(u.Code, unitCode.Trim(), StringComparison.OrdinalIgnoreCase))
            ? $"Единица «{unitCode.Trim()}» уже есть."
            : null;

    private bool UnitFormValid =>
        UnitCodeError is null && !string.IsNullOrWhiteSpace(unitCode) && !string.IsNullOrWhiteSpace(unitName);

    private string? EquipmentCodeError =>
        string.IsNullOrWhiteSpace(equipmentCode) ? "Укажите код оборудования."
        : equipment.Any(e => string.Equals(e.Code, equipmentCode.Trim(), StringComparison.OrdinalIgnoreCase)) ? $"Код {equipmentCode.Trim()} уже занят."
        : null;

    private bool EquipmentFormValid => EquipmentCodeError is null && !string.IsNullOrWhiteSpace(equipmentName);

    // ---------- Загрузка ----------

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            isAdmin = (await AuthState).User.IsInRole(AppRoles.Admin);
        await LoadAsync();
    }

    private static string Indent(int depth) =>
        FormattableString.Invariant($"padding-left: {0.75 + depth * 1.25}rem");

    private async Task LoadAsync()
    {
        try
        {
            categories = await Api.GetCategoriesAsync();
            units = await Api.GetUnitsAsync();
            equipment = await Api.GetEquipmentAsync();
            equipmentTree = EquipmentTree.Flatten(equipment);
            SuggestEquipmentCode();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    /// <summary>Предзаполнение кода оборудования: «код родителя-01» или «УЧ-01» на верхнем уровне.</summary>
    private void SuggestEquipmentCode()
    {
        var parentCode = equipment.FirstOrDefault(e => e.Id == equipmentParentId)?.Code;
        equipmentCode = Codes.NextEquipmentCode(parentCode, equipment.Select(e => e.Code));
    }

    // ---------- Сохранение ----------

    private Task AddCategoryAsync() => RunAsync(async () =>
    {
        var name = categoryName!.Trim();
        await Api.CreateCategoryAsync(new CreateCategoryRequest(name, null));
        success = $"Категория «{name}» добавлена.";
        categoryName = null;
    });

    private Task AddUnitAsync() => RunAsync(async () =>
    {
        var code = unitCode!.Trim();
        await Api.CreateUnitAsync(new CreateUnitRequest(code, unitName!.Trim(), unitFractional));
        success = $"Единица «{code}» добавлена.";
        unitCode = unitName = null;
        unitFractional = false;
    });

    private Task AddEquipmentAsync() => RunAsync(async () =>
    {
        var code = equipmentCode!.Trim();
        await Api.CreateEquipmentAsync(new CreateEquipmentRequest(equipmentParentId, code, equipmentName!.Trim()));
        success = $"Оборудование «{code}» добавлено.";
        equipmentName = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        error = success = null;
        busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
