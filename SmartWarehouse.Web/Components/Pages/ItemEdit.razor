@page "/items/new"
@page "/items/{Id:int}/edit"
@inject ApiClient Api
@inject BrowserStore Store
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Новая позиция" : "Изменение позиции") — склад</PageTitle>

<h1>@(IsNew ? "Новая позиция" : "Изменение позиции")</h1>

<Alert Error="@error" />

@if (loaded)
{
    <form class="panel" style="max-width: 760px" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="field-row">
            <div class="field">
                <label for="sku">Артикул <span class="req">*</span></label>
                @if (IsNew)
                {
                    <div class="input-with-btn">
                        <input id="sku" type="text" @bind="form.Sku" @bind:event="oninput" maxlength="64"
                               class="@(SkuError is not null ? "invalid" : null)" />
                        <button class="btn btn-sm" type="button" title="Подставить следующий свободный номер" @onclick="SuggestSkuAsync">↻</button>
                    </div>
                    <FieldError Message="@SkuError" />
                    <div class="field-hint">Предложен следующий свободный номер. Можно заменить на артикул производителя.</div>
                }
                else
                {
                    <input id="sku" type="text" value="@form.Sku" disabled />
                }
            </div>
            <div class="field">
                <label for="unit">Единица измерения <span class="req">*</span></label>
                <select id="unit" @bind="form.UnitId">
                    @foreach (var u in units)
                    {
                        <option value="@u.Id">@u.Code — @u.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="field">
            <label for="name">Наименование <span class="req">*</span></label>
            <input id="name" type="text" @bind="form.Name" @bind:event="oninput" maxlength="256"
                   class="@(NameError is not null ? "invalid" : null)" placeholder="Подшипник 6205-2RS" />
            <FieldError Message="@NameError" />
        </div>

        <div class="field">
            <label for="category">Категория</label>
            <select id="category" @bind="form.CategoryId">
                <option value="">— без категории —</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <div class="field-row">
            <div class="field">
                <label for="min">Минимальный остаток</label>
                <input id="min" type="number" min="0" step="any" @bind="form.MinStock"
                       class="@(MinError is not null ? "invalid" : null)" />
                <FieldError Message="@MinError" />
                <div class="field-hint">Ниже этого количества позиция попадёт в список «ниже минимума». 0 — не следить.</div>
            </div>
            <div class="field">
                <label for="max">Максимальный остаток</label>
                <input id="max" type="number" min="0" step="any" @bind="form.MaxStock"
                       class="@(MaxError is not null ? "invalid" : null)" />
                <FieldError Message="@MaxError" />
                <div class="field-hint">До какого количества пополнять. Можно оставить пустым.</div>
            </div>
        </div>

        <div class="field">
            <label for="desc">Описание</label>
            <textarea id="desc" @bind="form.Description" maxlength="2000"></textarea>
        </div>

        @if (!IsNew)
        {
            <div class="field">
                <label class="checkbox"><input type="checkbox" @bind="form.IsActive" /> Активна (доступна в документах)</label>
            </div>
        }

        <div class="actions">
            <button class="btn btn-primary" type="submit" disabled="@(!IsValid || saving)">Сохранить</button>
            <a class="btn" href="@(IsNew ? "/items" : $"/items/{Id}")">Отмена</a>
        </div>
        @if (IsNew)
        {
            <p class="muted">Фото можно добавить в карточке позиции после сохранения.</p>
        }
    </form>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private readonly ItemForm form = new();
    private List<UnitDto> units = [];
    private List<CategoryDto> categories = [];
    private bool loaded;
    private bool saving;
    private string? error;

    // ---------- Проверки (те же правила, что на сервере) ----------

    private string? SkuError => IsNew && string.IsNullOrWhiteSpace(form.Sku) ? "Укажите артикул." : null;
    private string? NameError => string.IsNullOrWhiteSpace(form.Name) ? "Укажите наименование." : null;
    private string? MinError => form.MinStock < 0 ? "Не может быть отрицательным." : null;
    private string? MaxError =>
        form.MaxStock < 0 ? "Не может быть отрицательным."
        : form.MaxStock is { } max && max < form.MinStock ? "Не может быть меньше минимального."
        : null;

    private bool IsValid => SkuError is null && NameError is null && MinError is null && MaxError is null && form.UnitId > 0;

    // ---------- Загрузка ----------

    protected override async Task OnInitializedAsync()
    {
        try
        {
            units = await Api.GetUnitsAsync();
            categories = await Api.GetCategoriesAsync();

            if (Id is int id)
            {
                var item = await Api.GetItemAsync(id);
                form.Sku = item.Sku;
                form.Name = item.Name;
                form.CategoryId = item.CategoryId;
                form.UnitId = item.UnitId;
                form.MinStock = item.MinStock;
                form.MaxStock = item.MaxStock;
                form.Description = item.Description;
                form.IsActive = item.IsActive;
            }
            else
            {
                // Предзаполнение: свободный артикул, единица и категория — как в прошлый раз.
                form.Sku = await Api.GetNextSkuAsync();

                var lastUnit = await Store.GetIntAsync("item.unit");
                form.UnitId = units.Any(u => u.Id == lastUnit)
                    ? lastUnit!.Value
                    : units.FirstOrDefault(u => u.Code == "шт")?.Id ?? units.FirstOrDefault()?.Id ?? 0;

                var lastCategory = await Store.GetIntAsync("item.category");
                form.CategoryId = categories.Any(c => c.Id == lastCategory) ? lastCategory : null;
            }

            loaded = true;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private async Task SuggestSkuAsync()
    {
        try
        {
            form.Sku = await Api.GetNextSkuAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    // ---------- Сохранение ----------

    private async Task SaveAsync()
    {
        if (!IsValid) return;

        saving = true;
        error = null;
        try
        {
            ItemDto saved;
            if (Id is int id)
            {
                saved = await Api.UpdateItemAsync(id, new UpdateItemRequest(
                    form.Name.Trim(), form.CategoryId, form.UnitId, form.MinStock, form.MaxStock, form.Description, form.IsActive));
            }
            else
            {
                saved = await Api.CreateItemAsync(new CreateItemRequest(
                    form.Sku.Trim(), form.Name.Trim(), form.CategoryId, form.UnitId, form.MinStock, form.MaxStock, form.Description));
                await Store.SetAsync("item.unit", form.UnitId);
                await Store.SetAsync("item.category", form.CategoryId);
            }
            Nav.NavigateTo($"/items/{saved.Id}");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class ItemForm
    {
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public int? CategoryId { get; set; }
        public int UnitId { get; set; }
        public decimal MinStock { get; set; }
        public decimal? MaxStock { get; set; }
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
