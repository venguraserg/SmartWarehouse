@page "/l/{Code}"
@inject ApiClient Api

@* Сюда ведёт QR-наклейка ячейки: что лежит в месте хранения. Страница рассчитана на телефон. *@

<PageTitle>@(location is null ? Code : placeTree.AddressOf(location.Id, location.FullCode).Full) — Склад ОЭТО</PageTitle>

<Alert Error="@error" />

@if (location is not null)
{
    var place = placeTree.AddressOf(location.Id, location.FullCode, location.Name);
    <div class="page-head">
        <h1>@place.Full</h1>
        <span class="spacer"></span>
        <a class="btn" href="/scan"><Icon Name="scan" Size="18" /> Ещё</a>
    </div>
    @foreach (var inv in inventories)
    {
        <a class="btn btn-primary btn-big" style="margin-bottom: 1rem" href="/inventory/@inv.Id/place/@location.Id">
            <Icon Name="check" Size="20" /> Посчитать для инвентаризации @inv.Number
        </a>
    }
    <div class="place-cell" style="margin: -.5rem 0 1rem">
        <RackScheme Tree="placeTree" LocationId="location.Id" />
        <div>
            @if (place.Area is not null && place.Area != place.Full)
            {
                <span class="place-area">@place.Area</span>
            }
            <span class="mono muted">@location.FullCode</span>
            @if (place.Note is not null)
            {
                <div>@place.Note</div>
            }
        </div>
    </div>

    @if (content is null)
    {
        <p class="loading">Загрузка…</p>
    }
    else if (content.Count == 0)
    {
        <div class="panel empty">Здесь ничего не числится.</div>
    }
    else
    {
        <ul class="scan-list">
            @foreach (var c in content)
            {
                <li>
                    <a href="/items/@c.ItemId">
                        <Thumb ItemId="c.ItemId" ImageVersion="c.ImageVersion" />
                        <span class="scan-list-text">
                            <span class="scan-list-name">@c.Name</span>
                            <span class="mono muted">@c.Sku</span>
                        </span>
                        <strong class="scan-list-qty">@Ui.Qty(c.Quantity) @c.UnitCode</strong>
                    </a>
                </li>
            }
        </ul>
        <p class="muted">Позиций: @content.Count</p>
    }

    <div class="actions" style="margin-top: 1rem">
        <a class="btn" href="/stock?location=@Uri.EscapeDataString(location.FullCode)">Остатки по месту и вложенным</a>
    </div>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}
else
{
    <div class="actions"><a class="btn" href="/scan"><Icon Name="scan" Size="18" /> Сканировать снова</a></div>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private LocationDto? location;
    private PlaceTree placeTree = new();

    /// <summary>Идущие инвентаризации, куда входит это место (только кладовщику и администратору).</summary>
    private List<InventorySummaryDto> inventories = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool placesLoaded;
    private List<LocationContentDto>? content;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        location = null;
        content = null;
        error = null;
        try
        {
            location = await Api.GetLocationByCodeAsync(Code);
            content = await Api.GetLocationContentAsync(location.Id);
            if (AuthState is not null && (await AuthState).User is var user
                && (user.IsInRole(AppRoles.Storekeeper) || user.IsInRole(AppRoles.Admin)))
            {
                try { inventories = await Api.GetOpenInventoriesAsync(location.Id); }
                catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
            }
            if (!placesLoaded)
            {
                // Без дерева мест адрес показывается шифром — страница всё равно работает.
                try { placeTree = await Api.GetPlacesAsync(); placesLoaded = true; }
                catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
