@page "/l/{Code}"
@inject ApiClient Api

@* Сюда ведёт QR-наклейка ячейки: что лежит в месте хранения. Страница рассчитана на телефон. *@

<PageTitle>@(location?.FullCode ?? Code) — склад</PageTitle>

<Alert Error="@error" />

@if (location is not null)
{
    <div class="page-head">
        <h1 class="mono">@location.FullCode</h1>
        <span class="tag tag-neutral">@Ui.LocType(location.Type)</span>
        <span class="spacer"></span>
        <a class="btn" href="/scan">📷 Ещё</a>
    </div>
    @if (!string.IsNullOrEmpty(location.Name))
    {
        <p class="muted" style="margin-top: -.5rem">@location.Name</p>
    }

    @if (content is null)
    {
        <p class="loading">Загрузка…</p>
    }
    else if (content.Count == 0)
    {
        <div class="panel empty">Здесь ничего не числится.</div>
    }
    else
    {
        <ul class="scan-list">
            @foreach (var c in content)
            {
                <li>
                    <a href="/items/@c.ItemId">
                        <Thumb ItemId="c.ItemId" ImageVersion="c.ImageVersion" />
                        <span class="scan-list-text">
                            <span class="scan-list-name">@c.Name</span>
                            <span class="mono muted">@c.Sku</span>
                        </span>
                        <strong class="scan-list-qty">@Ui.Qty(c.Quantity) @c.UnitCode</strong>
                    </a>
                </li>
            }
        </ul>
        <p class="muted">Позиций: @content.Count</p>
    }

    <div class="actions" style="margin-top: 1rem">
        <a class="btn" href="/stock?location=@Uri.EscapeDataString(location.FullCode)">Остатки по месту и вложенным</a>
    </div>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}
else
{
    <div class="actions"><a class="btn" href="/scan">📷 Сканировать снова</a></div>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    private LocationDto? location;
    private List<LocationContentDto>? content;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        location = null;
        content = null;
        error = null;
        try
        {
            location = await Api.GetLocationByCodeAsync(Code);
            content = await Api.GetLocationContentAsync(location.Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
