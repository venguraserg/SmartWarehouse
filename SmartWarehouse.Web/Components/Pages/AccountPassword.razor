@page "/account/password"
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Смена пароля — склад</PageTitle>

<h1>Смена пароля</h1>

@if (HttpContext.User.MustChangePasswordOf())
{
    <p class="muted">Вы вошли с временным паролем. Придумайте свой — не короче 6 символов.</p>
}

<Alert Error="@error" />

<EditForm Model="Input" FormName="change-password" OnSubmit="ChangeAsync">
    <div class="field">
        <label for="current">Текущий пароль</label>
        <InputText id="current" type="password" @bind-Value="Input.Current" autocomplete="current-password" />
    </div>
    <div class="field">
        <label for="new">Новый пароль</label>
        <InputText id="new" type="password" @bind-Value="Input.New" autocomplete="new-password" />
    </div>
    <div class="field">
        <label for="repeat">Новый пароль ещё раз</label>
        <InputText id="repeat" type="password" @bind-Value="Input.Repeat" autocomplete="new-password" />
    </div>
    <div class="actions">
        <button class="btn btn-primary" type="submit">Сменить пароль</button>
        @if (!HttpContext.User.MustChangePasswordOf())
        {
            <a class="btn" href="/">Отмена</a>
        }
    </div>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private PasswordForm Input { get; set; } = new();

    private string? error;

    private async Task ChangeAsync()
    {
        var current = Input.Current ?? "";
        var next = Input.New ?? "";

        if (next.Length < 6)
        {
            error = "Новый пароль должен быть не короче 6 символов.";
            return;
        }
        if (next != Input.Repeat)
        {
            error = "Новый пароль и повтор не совпадают.";
            return;
        }

        LoginResponse login;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequest(current, next));

            // Входим заново с новым паролем: в cookie попадут свежий токен и снятый флаг «сменить пароль».
            var userLogin = HttpContext.User.FindFirstValue(ClaimTypes.Name) ?? "";
            login = await Api.LoginAsync(new LoginRequest(userLogin, next));
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            return;
        }
        catch (HttpRequestException)
        {
            error = "Сервер склада (API) недоступен.";
            return;
        }

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            AuthClaims.CreatePrincipal(login),
            new AuthenticationProperties { ExpiresUtc = login.ExpiresAt, IsPersistent = false });

        Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class PasswordForm
    {
        public string? Current { get; set; }
        public string? New { get; set; }
        public string? Repeat { get; set; }
    }
}
