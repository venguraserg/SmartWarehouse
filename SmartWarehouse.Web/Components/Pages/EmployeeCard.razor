@page "/employees/{Id:int}"
@inject ApiClient Api

<PageTitle>@(employee?.ShortName ?? "Сотрудник") — Склад ОЭТО</PageTitle>

<Alert Error="@error" />

@if (employee is not null)
{
    <div class="page-head">
        <h1>@employee.FullName</h1>
        @if (!employee.IsActive)
        {
            <span class="tag tag-neutral">не работает</span>
        }
        <span class="spacer"></span>
        <AuthorizeView Roles="@AppRoles.Admin"><a class="btn" href="/employees?edit=@employee.Id">Изменить</a></AuthorizeView>
        <AuthorizeView Roles="@($"{AppRoles.Admin},{AppRoles.Storekeeper},{AppRoles.Manager}")"><a class="btn" href="/employees">К списку</a></AuthorizeView>
    </div>

    <div class="panel">
        <dl class="props">
            <dt>Табельный номер</dt>
            <dd class="mono">@(employee.PersonnelNumber ?? "—")</dd>
            <dt>Должность</dt>
            <dd>@(employee.Position ?? "—")</dd>
            <dt>Подразделение</dt>
            <dd>@(employee.Department ?? "—")</dd>
            <dt>Руководитель</dt>
            <dd>
                @if (employee.ManagerId is int managerId)
                {
                    <a href="/employees/@managerId">@employee.ManagerName</a>
                }
                else
                {
                    @("— (сам утверждает свои акты)")
                }
            </dd>
            <dt>Телефон</dt>
            <dd>@(employee.Phone ?? "—")</dd>
            @if (employee.IsMol)
            {
                <dt>МОЛ</dt>
                <dd>Материально ответственное лицо · <a href="/stock?mol=@employee.Id">что числится за ним на складе</a></dd>
            }
        </dl>
    </div>

    <div class="page-head" style="margin-top: 1.5rem; margin-bottom: .75rem">
        <h2 style="margin: 0">Числится за сотрудником</h2>
        @if (ShowValue)
        {
            <span class="muted">на сумму @Ui.Value(custody.Any(c => c.Value is not null) ? custody.Sum(c => c.Value ?? 0) : null, custody.Any(c => c.ValueIncomplete))</span>
        }
        <span class="spacer"></span>
        <a class="btn" href="/reports?scope=all&employee=@employee.Id">Отчёты</a>
        <a class="btn" href="/acts?scope=all&employee=@employee.Id">Акты</a>
        <AuthorizeView Roles="@AppRoles.Warehouse">
            @if (custody.Count > 0)
            {
                <a class="btn" href="/documents/new/Return?employee=@employee.Id">Вернуть на склад</a>
            }
            @if (employee.IsActive)
            {
                <a class="btn" href="/documents/new/Issue?employee=@employee.Id">Выдать</a>
            }
        </AuthorizeView>
    </div>
    @if (custody.Count == 0)
    {
        <div class="panel empty">За сотрудником ничего не числится.</div>
    }
    @* Два раздела: «выдано в работу» (в 1С — за кладовщиком) и «подотчёт по 1С» (МОЛ — сам сотрудник). *@
    @foreach (var section in custody.GroupBy(c => c.Kind).OrderBy(g => g.Key))
    {
        <div class="page-head" style="margin: 1rem 0 .5rem">
            <h3 style="margin: 0">
                <span class="tag @Ui.CustodyKindClass(section.Key)">@Ui.CustodyKindShort(section.Key)</span>
                @(section.Key == CustodyKind.Official ? "Подотчёт по 1С" : "Выдано в работу")
                <span class="muted" style="font-weight: 400; font-size: .875rem">— @Ui.CustodyKindTitle(section.Key).Split(':')[1].Trim()</span>
            </h3>
            <span class="spacer"></span>
            @if (isWarehouse || employee.Id == myEmployeeId)
            {
                @if (section.Key == CustodyKind.Work)
                {
                    <a class="btn btn-primary btn-sm" href="/reports/new?employee=@employee.Id">Отчёт об использовании</a>
                }
            }
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width: 56px"></th>
                        <th>Артикул</th>
                        <th>Наименование</th>
                        <th class="num">Количество</th>
                        @if (ShowValue)
                        {
                            <th class="num">Стоимость</th>
                        }
                        <th class="num" title="Сколько дней числится (по самой ранней невозвращённой выдаче)">Числится</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in section)
                    {
                        <tr class="@(c.OffBookQuantity >= c.Quantity ? "row-offbook" : null)">
                            <td><Thumb ItemId="c.ItemId" ImageVersion="c.ImageVersion" /></td>
                            <td class="mono"><a href="/items/@c.ItemId">@c.Sku</a></td>
                            <td class="col-name">@c.ItemName <OffBookTag Quantity="c.OffBookQuantity" Total="c.Quantity" /> <MolTags Mols="c.Mols" /></td>
                            <td class="num">
                                <strong>@Ui.Qty(c.Quantity) @c.UnitCode</strong>
                                @if (c.Reserved > 0)
                                {
                                    <div class="line-hint">из них @Ui.Qty(c.Reserved) — @(c.Kind == CustodyKind.Work ? "в отчётах об использовании" : "в актах на утверждении")</div>
                                }
                            </td>
                            @if (ShowValue)
                            {
                                <td class="num">@Ui.Value(c.Value, c.ValueIncomplete)</td>
                            }
                            <td class="num"><CustodyAge Since="c.HeldSince" Kind="c.Kind" Unreported="c.Quantity - c.Reserved" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>История: выдачи, списания, возвраты</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Документ</th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th>Место</th>
                    <th class="num">Количество</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in history)
                {
                    <tr>
                        <td>@Ui.Date(m.OccurredAt)</td>
                        <td>
                            <a class="mono" href="/documents/@m.DocumentId">@m.DocumentNumber</a>
                            <span class="tag @Ui.DocTypeClass(m.Type)">@Ui.DocType(m.Type)</span>
                        </td>
                        <td class="mono"><a href="/items/@m.ItemId">@m.Sku</a></td>
                        <td class="col-name">@m.ItemName</td>
                        <td class="mono">@m.Location</td>
                        <td class="num">@(m.Quantity > 0 ? "+" : "−")@Ui.Qty(Math.Abs(m.Quantity)) @m.UnitCode</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (history.Count == 0)
        {
            <div class="empty">Движений по подотчёту не было.</div>
        }
    </div>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}

@code {
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isWarehouse;

    private bool ShowValue => custody.Any(c => c.Value is not null || c.ValueIncomplete);
    private int? myEmployeeId;

    private EmployeeDto? employee;
    private List<CustodyRowDto> custody = [];
    private List<EmployeeMovementDto> history = [];
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            isWarehouse = user.IsWarehouseStaff();
            myEmployeeId = user.EmployeeIdOf();
        }

        try
        {
            employee = await Api.GetEmployeeAsync(Id);
            custody = await Api.GetCustodyAsync(employeeId: Id);
            history = await Api.GetEmployeeHistoryAsync(Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
