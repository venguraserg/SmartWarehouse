@page "/employees/{Id:int}"
@inject ApiClient Api

<PageTitle>@(employee?.ShortName ?? "Сотрудник") — склад</PageTitle>

<Alert Error="@error" />

@if (employee is not null)
{
    <div class="page-head">
        <h1>@employee.FullName</h1>
        @if (!employee.IsActive)
        {
            <span class="tag tag-neutral">не работает</span>
        }
        <span class="spacer"></span>
        <AuthorizeView Roles="@AppRoles.Admin"><a class="btn" href="/employees?edit=@employee.Id">Изменить</a></AuthorizeView>
        <AuthorizeView Roles="@($"{AppRoles.Admin},{AppRoles.Storekeeper},{AppRoles.Manager}")"><a class="btn" href="/employees">К списку</a></AuthorizeView>
    </div>

    <div class="panel">
        <dl class="props">
            <dt>Табельный номер</dt>
            <dd class="mono">@(employee.PersonnelNumber ?? "—")</dd>
            <dt>Должность</dt>
            <dd>@(employee.Position ?? "—")</dd>
            <dt>Подразделение</dt>
            <dd>@(employee.Department ?? "—")</dd>
            <dt>Руководитель</dt>
            <dd>
                @if (employee.ManagerId is int managerId)
                {
                    <a href="/employees/@managerId">@employee.ManagerName</a>
                }
                else
                {
                    @("— (сам утверждает свои акты)")
                }
            </dd>
            <dt>Телефон</dt>
            <dd>@(employee.Phone ?? "—")</dd>
        </dl>
    </div>

    <div class="page-head" style="margin-top: 1.5rem; margin-bottom: .75rem">
        <h2 style="margin: 0">Числится за сотрудником</h2>
        <span class="spacer"></span>
        @if (custody.Count > 0 && (isWarehouse || employee.Id == myEmployeeId))
        {
            <a class="btn btn-primary" href="/acts/new?employee=@employee.Id">Акт на списание</a>
        }
        <a class="btn" href="/acts?scope=all&employee=@employee.Id">Акты сотрудника</a>
        <AuthorizeView Roles="@AppRoles.Warehouse">
            @if (custody.Count > 0)
            {
                <a class="btn" href="/documents/new/Return?employee=@employee.Id">Вернуть на склад</a>
            }
            @if (employee.IsActive)
            {
                <a class="btn" href="/documents/new/Issue?employee=@employee.Id">Выдать</a>
            }
        </AuthorizeView>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 56px"></th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th class="num">Количество</th>
                    <th class="num" title="Сколько дней числится (по самой ранней невозвращённой выдаче)">Числится</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in custody)
                {
                    <tr>
                        <td><Thumb ItemId="c.ItemId" ImageVersion="c.ImageVersion" /></td>
                        <td class="mono"><a href="/items/@c.ItemId">@c.Sku</a></td>
                        <td>@c.ItemName</td>
                        <td class="num">
                            <strong>@Ui.Qty(c.Quantity) @c.UnitCode</strong>
                            @if (c.Reserved > 0)
                            {
                                <div class="line-hint">из них @Ui.Qty(c.Reserved) — в актах на утверждении</div>
                            }
                        </td>
                        <td class="num"><CustodyAge Since="c.HeldSince" /></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (custody.Count == 0)
        {
            <div class="empty">За сотрудником ничего не числится.</div>
        }
    </div>

    <h2>История: выдачи, списания, возвраты</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Документ</th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th>Место</th>
                    <th class="num">Количество</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in history)
                {
                    <tr>
                        <td>@Ui.Date(m.OccurredAt)</td>
                        <td>
                            <a class="mono" href="/documents/@m.DocumentId">@m.DocumentNumber</a>
                            <span class="tag @Ui.DocTypeClass(m.Type)">@Ui.DocType(m.Type)</span>
                        </td>
                        <td class="mono"><a href="/items/@m.ItemId">@m.Sku</a></td>
                        <td>@m.ItemName</td>
                        <td class="mono">@m.Location</td>
                        <td class="num">@(m.Quantity > 0 ? "+" : "−")@Ui.Qty(Math.Abs(m.Quantity)) @m.UnitCode</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (history.Count == 0)
        {
            <div class="empty">Движений по подотчёту не было.</div>
        }
    </div>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}

@code {
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isWarehouse;
    private int? myEmployeeId;

    private EmployeeDto? employee;
    private List<CustodyRowDto> custody = [];
    private List<EmployeeMovementDto> history = [];
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            isWarehouse = user.IsWarehouseStaff();
            myEmployeeId = user.EmployeeIdOf();
        }

        try
        {
            employee = await Api.GetEmployeeAsync(Id);
            custody = await Api.GetCustodyAsync(employeeId: Id);
            history = await Api.GetEmployeeHistoryAsync(Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
