@page "/items/{Id:int}"
@inject ApiClient Api

<PageTitle>@(item?.Name ?? "Позиция") — склад</PageTitle>

<Alert Error="@error" Success="@success" />

@if (item is not null)
{
    <div class="page-head">
        <h1>@item.Name</h1>
        @if (!item.IsActive)
        {
            <span class="tag tag-neutral">неактивна</span>
        }
        <span class="spacer"></span>
        <AuthorizeView Roles="@AppRoles.Warehouse">
            <a class="btn" href="/labels.pdf?kind=Item&ids=@item.Id&layout=3x8" target="_blank" rel="noopener" title="Наклейка с QR-кодом позиции">Наклейка QR</a>
            <a class="btn" href="/items/@item.Id/edit">Изменить</a>
        </AuthorizeView>
    </div>

    <div class="panel">
        <div class="item-head">
            <div>
                <div class="item-photo">
                    @if (Ui.ImageUrl(item.Id, item.ImageVersion) is { } url)
                    {
                        <img src="@url" alt="Фото: @item.Name" />
                    }
                    else
                    {
                        <span>Нет фото</span>
                    }
                </div>
                <AuthorizeView Roles="@AppRoles.Warehouse">
                <div style="margin-top: .6rem">
                    <label for="photo">@(item.ImageVersion is null ? "Загрузить фото" : "Заменить фото") (JPEG, PNG, WebP, до 5 МБ)</label>
                    <InputFile id="photo" class="file-input" accept="image/jpeg,image/png,image/webp" OnChange="UploadAsync" disabled="@busy" />
                    @if (item.ImageVersion is not null)
                    {
                        <div style="margin-top: .4rem">
                            <button class="btn btn-danger btn-sm" type="button" @onclick="DeleteImageAsync" disabled="@busy">Удалить фото</button>
                        </div>
                    }
                </div>
                </AuthorizeView>
            </div>

            <dl class="props">
                <dt>Артикул</dt>
                <dd class="mono">@item.Sku</dd>
                @if (!string.IsNullOrEmpty(item.Barcode))
                {
                    <dt>Штрих-код</dt>
                    <dd class="mono">@item.Barcode</dd>
                }
                <dt>Категория</dt>
                <dd>@(item.CategoryName ?? "—")</dd>
                <dt>Единица</dt>
                <dd>@item.UnitCode</dd>
                <dt>Минимум</dt>
                <dd>@Ui.Qty(item.MinStock)</dd>
                <dt>Максимум</dt>
                <dd>@(item.MaxStock is { } max ? Ui.Qty(max) : "—")</dd>
                <dt>На складе</dt>
                <dd>
                    <strong>@Ui.Qty(Total) @item.UnitCode</strong>
                    @if (Total < item.MinStock)
                    {
                        <span class="tag tag-warn">ниже минимума</span>
                    }
                </dd>
                @if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    <dt>Описание</dt>
                    <dd style="white-space: pre-line">@item.Description</dd>
                }
            </dl>
        </div>
    </div>

    <div class="grid-2" style="margin-top: 1rem">
        <div>
            <h2 style="margin-top: 0">Остатки по местам</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Место</th><th class="num">Количество</th>@if (seesPrices){<th class="num">Стоимость</th>}</tr></thead>
                    <tbody>
                        @foreach (var b in balances)
                        {
                            <tr>
                                <td>
                                    <a href="/stock?location=@Uri.EscapeDataString(b.LocationCode)">@(b.LocationName ?? b.LocationCode)</a>
                                    @if (b.LocationName is not null)
                                    {
                                        <div class="line-hint mono">@b.LocationCode</div>
                                    }
                                </td>
                                <td class="num">@Ui.Qty(b.Quantity) @item.UnitCode</td>
                                @if (seesPrices)
                                {
                                    <td class="num">@Ui.Value(b.Value, b.ValueIncomplete)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (balances.Count == 0)
                {
                    <div class="empty">На складе нет.</div>
                }
            </div>

            <h2>За сотрудниками (подотчёт)</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Сотрудник</th><th class="num">Количество</th>@if (seesPrices){<th class="num">Стоимость</th>}</tr></thead>
                    <tbody>
                        @foreach (var c in custody)
                        {
                            <tr>
                                <td><a href="/employees/@c.EmployeeId">@c.EmployeeName</a></td>
                                <td class="num">@Ui.Qty(c.Quantity) @item.UnitCode</td>
                                @if (seesPrices)
                                {
                                    <td class="num">@Ui.Value(c.Value, c.ValueIncomplete)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (custody.Count == 0)
                {
                    <div class="empty">Ни за кем не числится.</div>
                }
            </div>

            @if (seesPrices)
            {
                <h2>Партии</h2>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Поступила</th><th>Документ</th><th class="num">Цена</th><th class="num">Остаток</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var b in batches)
                            {
                                <tr>
                                    <td>@Ui.Day(b.ReceivedAt)@(string.IsNullOrEmpty(b.Note) ? "" : $" · {b.Note}")</td>
                                    <td class="mono">
                                        @if (b.DocumentId is long documentId)
                                        {
                                            <a href="/documents/@documentId">@b.DocumentNumber</a>
                                        }
                                    </td>
                                    <td class="num">
                                        @if (priceFor == b.BatchId)
                                        {
                                            <input type="number" min="0" step="0.01" @bind="newPrice" style="max-width: 110px" aria-label="Цена" />
                                        }
                                        else
                                        {
                                            @(b.UnitPrice is decimal p ? Ui.Price(p) : "без цены")
                                        }
                                    </td>
                                    <td class="num">@Ui.Qty(b.Quantity) @item.UnitCode</td>
                                    <td class="row-actions">
                                        @if (isAdmin)
                                        {
                                            if (priceFor == b.BatchId)
                                            {
                                                <button class="btn btn-primary btn-sm" type="button" disabled="@(busy || newPrice is null || newPrice < 0)" @onclick="() => SavePriceAsync(b.BatchId)">Сохранить</button>
                                                <button class="btn btn-sm" type="button" @onclick="() => priceFor = null">Отмена</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm" type="button" @onclick="() => { priceFor = b.BatchId; newPrice = b.UnitPrice; }">@(b.UnitPrice is null ? "Указать цену" : "Цена")</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (batches.Count == 0)
                    {
                        <div class="empty">Партий с остатком нет.</div>
                    }
                </div>
                <div class="field-hint">Остаток партии — на складе и у сотрудников вместе. Цену партии может исправить администратор.</div>
            }
        </div>

        <div>
            <h2 style="margin-top: 0">История движений</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Документ</th><th>Дата</th><th>Откуда → куда</th><th class="num">Кол-во</th></tr></thead>
                    <tbody>
                        @foreach (var m in movements)
                        {
                            <tr>
                                <td>
                                    <a class="mono" href="/documents/@m.DocumentId">@m.DocumentNumber</a><br />
                                    <span class="tag @Ui.DocTypeClass(m.Type)">@Ui.DocType(m.Type)</span>
                                    @if (!string.IsNullOrEmpty(m.ReceivedBy))
                                    {
                                        <div class="line-hint">кому: @m.ReceivedBy</div>
                                    }
                                </td>
                                <td>@Ui.Date(m.OccurredAt)</td>
                                <td class="mono">@(m.FromLocation ?? "—") → @(m.ToLocation ?? "—")</td>
                                <td class="num">@Ui.Qty(m.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (movements.Count == 0)
                {
                    <div class="empty">Движений не было.</div>
                }
            </div>
        </div>
    </div>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}

@code {
    [Parameter] public int Id { get; set; }

    private ItemDto? item;
    private List<StockBalanceDto> balances = [];
    private List<MovementDto> movements = [];
    private List<CustodyRowDto> custody = [];
    private bool busy;
    private string? error;
    private string? success;

    private decimal Total => balances.Sum(b => b.Quantity);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool seesPrices;
    private bool isAdmin;
    private List<BatchStockDto> batches = [];
    private int? priceFor;
    private decimal? newPrice;

    private async Task SavePriceAsync(int batchId)
    {
        if (newPrice is not decimal price) return;
        busy = true;
        error = success = null;
        try
        {
            await Api.SetBatchPriceAsync(batchId, price);
            priceFor = null;
            success = "Цена партии сохранена.";
            batches = await Api.GetBatchesAsync(Id);
            balances = await Api.GetBalancesAsync(Id);
            custody = await Api.GetCustodyAsync(itemId: Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (AuthState is not null)
            {
                var user = (await AuthState).User;
                seesPrices = user.SeesPrices();
                isAdmin = user.IsInRole(AppRoles.Admin);
            }
            item = await Api.GetItemAsync(Id);
            balances = await Api.GetBalancesAsync(Id);
            if (seesPrices)
                batches = await Api.GetBatchesAsync(Id);
            movements = await Api.GetMovementsAsync(Id, 50);
            custody = await Api.GetCustodyAsync(itemId: Id);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 5 * 1024 * 1024;
        error = success = null;

        var file = e.File;
        if (file.Size > maxBytes)
        {
            error = "Файл больше 5 МБ. Уменьшите фото и попробуйте снова.";
            return;
        }

        busy = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(maxBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            item = await Api.UploadItemImageAsync(Id, buffer.ToArray(), file.Name, file.ContentType);
            success = "Фото сохранено.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or IOException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteImageAsync()
    {
        error = success = null;
        busy = true;
        try
        {
            await Api.DeleteItemImageAsync(Id);
            item = await Api.GetItemAsync(Id);
            success = "Фото удалено.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
