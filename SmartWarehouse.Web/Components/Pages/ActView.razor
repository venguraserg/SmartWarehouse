@page "/acts/{Id:int}"
@page "/reports/{Id:int}"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@(act?.Number ?? "Акт") — Склад ОЭТО</PageTitle>

<Alert Error="@error" Success="@success" />

@if (act is not null)
{
    <div class="page-head">
        <h1 class="mono">@act.Number</h1>
        <span class="tag @Ui.ActStateClass(act.Status)">@Ui.ActState(act.Status, act.Kind)</span>
        <span class="muted">@(IsSummary ? "сводный акт кладовщика" : IsReport ? "отчёт об использовании" : "акт на списание")</span>
        @if (IsReport && act.WrittenOff)
        {
            <span class="tag tag-danger">списан актом @act.SummaryActNumber</span>
        }
        else if (IsReport && act.SummaryActNumber is not null)
        {
            <span class="tag tag-neutral">в черновике @act.SummaryActNumber</span>
        }
        <span class="spacer"></span>
        @if (IsSummary)
        {
            <select @bind="pdfOrder" style="max-width: 210px" aria-label="Порядок строк в PDF">
                <option value="date">Строки по дате</option>
                <option value="employee">По сотрудникам</option>
                <option value="equipment">По оборудованию</option>
            </select>
        }
        @if (!IsReport)
        {
            <a class="btn" href="@PdfUrl" target="_blank" rel="noopener">PDF@(act.Status == ActStatus.Approved ? "" : " (черновик)")</a>
        }
        <a class="btn" href="@ListUrl">К списку</a>
    </div>

    @if (act.Status == ActStatus.Returned && !string.IsNullOrEmpty(act.ReturnRemark))
    {
        <div class="alert alert-error">
            <strong>Возвращён на доработку.</strong> @act.DecidedBy: «@act.ReturnRemark»
        </div>
    }

    @* ---------- Действия ---------- *@
    @if (act.Can.Decide)
    {
        <div class="panel" style="margin-bottom: 1rem">
            <h2 style="margin-top: 0">Ваше решение</h2>
            <p class="muted" style="margin-top: 0">
                @(IsReport
                    ? "Подтверждённое ждёт вашего сводного акта за месяц (до тех пор в резерве); вне учёта списывается сразу. Если что-то не так — верните отчёт с замечанием."
                    : "При утверждении позиции списываются с сотрудника. Если что-то не так — верните акт с замечанием.")
            </p>
            <div class="field">
                <label for="remark">Замечание (для возврата)</label>
                <textarea id="remark" rows="2" @bind="remark" @bind:event="oninput" maxlength="1000"
                          placeholder="Что нужно исправить"></textarea>
            </div>
            <div class="actions">
                <button class="btn btn-primary" type="button" disabled="@busy" @onclick="ApproveAsync">@(IsReport ? "Подтвердить" : "Утвердить и списать")</button>
                <button class="btn" type="button" disabled="@(busy || string.IsNullOrWhiteSpace(remark))" @onclick="ReturnAsync">Вернуть на доработку</button>
            </div>
        </div>
    }

    @if (IsSummary && act.Can.Edit)
    {
        <div class="actions" style="margin-bottom: 1rem">
            <button class="btn btn-primary" type="button" disabled="@busy" @onclick="PostSummaryAsync">Провести списание</button>
            <a class="btn" href="/summary-acts/@act.Id/edit">Изменить состав</a>
            @if (confirmDelete)
            {
                <button class="btn btn-danger" type="button" disabled="@busy" @onclick="DeleteAsync">Да, удалить (отчёты освободятся)</button>
                <button class="btn" type="button" @onclick="() => confirmDelete = false">Не удалять</button>
            }
            else
            {
                <button class="btn" type="button" @onclick="() => confirmDelete = true">Удалить</button>
            }
        </div>
    }
    else if (act.Can.Edit || act.Can.Recall)
    {
        <div class="actions" style="margin-bottom: 1rem">
            @if (act.Can.Submit)
            {
                <button class="btn btn-primary" type="button" disabled="@busy" @onclick="SubmitAsync">
                    @(IsReport ? (isWarehouse ? "Подтвердить" : "Отправить кладовщику") : SelfApproves ? "Утвердить и списать" : "Отправить на утверждение")
                </button>
            }
            @if (act.Can.Edit)
            {
                <a class="btn" href="@(IsReport ? "/reports" : "/acts")/@act.Id/edit">Изменить</a>
                @if (confirmDelete)
                {
                    <button class="btn btn-danger" type="button" disabled="@busy" @onclick="DeleteAsync">Да, удалить</button>
                    <button class="btn" type="button" @onclick="() => confirmDelete = false">Не удалять</button>
                }
                else
                {
                    <button class="btn" type="button" @onclick="() => confirmDelete = true">Удалить</button>
                }
            }
            @if (act.Can.Recall)
            {
                <button class="btn" type="button" disabled="@busy" @onclick="RecallAsync">@(IsReport ? "Отозвать" : "Отозвать с утверждения")</button>
            }
        </div>
    }

    <div class="panel">
        <dl class="props">
            <dt>Сотрудник</dt>
            <dd>
                <a href="/employees/@act.EmployeeId">@act.EmployeeName</a>
                @if (!string.IsNullOrEmpty(act.EmployeePosition))
                {
                    <span class="muted">· @act.EmployeePosition</span>
                }
            </dd>
            @if (IsSummary)
            {
                <dt>№ документа 1С</dt>
                <dd>
                    <span class="input-with-btn" style="max-width: 360px">
                        <input type="text" @bind="externalNumber" maxlength="100" placeholder="номер акта списания в 1С" aria-label="№ документа 1С" />
                        <button class="btn btn-sm" type="button" disabled="@(busy || externalNumber == act.ExternalNumber)" @onclick="SaveExternalNumberAsync">Сохранить</button>
                    </span>
                </dd>
                @if (act.Status == ActStatus.Approved)
                {
                    <dt>Провёл</dt>
                    <dd>@act.DecidedBy@(act.DecidedAt is { } postedAt ? $", {Ui.Date(postedAt)}" : "")</dd>
                }
                <dt>Документы списания</dt>
                <dd>
                    @if (act.Documents is { Count: > 0 } docs)
                    {
                        @foreach (var d in docs)
                        {
                            <a class="mono" href="/documents/@d.Id" style="margin-right: .6rem">@d.Number</a>
                        }
                    }
                    else
                    {
                        <span class="muted">появятся после проведения — на каждого сотрудника</span>
                    }
                </dd>
                <dt>Отчёты</dt>
                <dd>
                    @foreach (var r in act.Reports ?? [])
                    {
                        <a class="mono" href="/acts/@r.Id" style="margin-right: .6rem">@r.Number</a>
                    }
                </dd>
            }
            else if (act.Status == ActStatus.Approved)
            {
                <dt>@(IsReport ? "Подтвердил" : "Утвердил")</dt>
                <dd>@act.DecidedBy@(act.DecidedAt is { } approvedAt ? $", {Ui.Date(approvedAt)}" : "")</dd>
                <dt>Документ списания</dt>
                <dd>
                    @if (act.DocumentId is long documentId)
                    {
                        <a class="mono" href="/documents/@documentId">@act.DocumentNumber</a>
                        @if (IsReport)
                        {
                            <span class="muted"> — списано вне учёта</span>
                        }
                    }
                    else if (IsReport)
                    {
                        <span class="muted">ждёт сводного акта кладовщика за месяц</span>
                    }
                </dd>
            }
            else if (IsReport)
            {
                <dt>Подтверждает</dt>
                <dd>кладовщик</dd>
            }
            else
            {
                <dt>Утверждает</dt>
                <dd>@act.ApproverName@(act.ApproverId == act.EmployeeId ? " (руководитель не назначен)" : "")</dd>
            }
            @if (Ui.Period(act.PeriodFrom, act.PeriodTo) is { } period)
            {
                <dt>Период</dt>
                <dd>@period</dd>
            }
            @if (!IsSummary && !string.IsNullOrEmpty(act.ExternalNumber))
            {
                <dt>Основание</dt>
                <dd>@act.ExternalNumber</dd>
            }
            @if (!string.IsNullOrEmpty(act.Comment))
            {
                <dt>Примечание</dt>
                <dd style="white-space: pre-line">@act.Comment</dd>
            }
            <dt>Составлен</dt>
            <dd>@Ui.Date(act.CreatedAt)@(string.IsNullOrEmpty(act.CreatedBy) ? "" : $", {act.CreatedBy}")</dd>
            @if (act.SubmittedAt is { } submittedAt)
            {
                <dt>Отправлен на утверждение</dt>
                <dd>@Ui.Date(submittedAt)</dd>
            }
        </dl>
    </div>

    <h2>Что израсходовано</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th class="num">№</th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th class="num">Количество</th>
                    @if (ShowPrices)
                    {
                        <th class="num">Цена</th>
                        <th class="num">Сумма</th>
                    }
                    @if (IsSummary)
                    {
                        <th>Сотрудник / отчёт</th>
                    }
                    <th>Куда использовано</th>
                    <th>Дата</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in act.Lines)
                {
                    <tr class="@(l.OffBook ? "row-offbook" : null)">
                        <td class="num">@l.LineNo</td>
                        <td class="mono"><a href="/items/@l.ItemId">@l.Sku</a></td>
                        <td>@l.ItemName <OffBookTag Quantity="@(l.OffBook ? 1m : 0m)" /></td>
                        <td class="num">
                            @Ui.Qty(l.Quantity) @l.UnitCode
                            @if (l.BatchDate is { } batchDate)
                            {
                                <div class="line-hint">партия от @Ui.Day(batchDate)</div>
                            }
                        </td>
                        @if (ShowPrices)
                        {
                            <td class="num">@(l.UnitPrice is decimal p ? Ui.Price(p) : "—")</td>
                            <td class="num">@(l.UnitPrice is decimal q ? Ui.Money(decimal.Round(l.Quantity * q, 2, MidpointRounding.AwayFromZero)) : "—")</td>
                        }
                        @if (IsSummary)
                        {
                            <td>
                                @l.EmployeeName
                                @if (l.SourceId is int sourceId)
                                {
                                    <div class="line-hint"><a class="mono" href="/acts/@sourceId">@l.SourceNumber</a></div>
                                }
                            </td>
                        }
                        <td>
                            @if (l.Equipment is not null)
                            {
                                <div>@l.Equipment</div>
                            }
                            @if (!string.IsNullOrEmpty(l.Usage))
                            {
                                <div class="@(l.Equipment is null ? null : "muted")">@l.Usage</div>
                            }
                        </td>
                        <td>@(l.UsedOn is DateOnly d ? Ui.Day(d) : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (ShowPrices)
    {
        <p style="text-align: right"><strong>Итого: @Ui.Money(ActTotal)</strong>@(act.Lines.Any(l => l.UnitPrice is null) ? " (без строк, у партий которых цена не указана)" : "")</p>
    }
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}

@code {
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ActDto? act;

    private bool ShowPrices => act?.Lines.Any(l => l.UnitPrice is not null) == true;

    private decimal ActTotal => act?.Lines
        .Where(l => l.UnitPrice is not null)
        .Sum(l => decimal.Round(l.Quantity * l.UnitPrice!.Value, 2, MidpointRounding.AwayFromZero)) ?? 0;
    private int? myEmployeeId;
    private string? remark;
    private bool busy;
    private bool confirmDelete;
    private string? error;
    private string? success;

    /// <summary>Руководителя нет и это мой акт — отправка сразу утверждает.</summary>
    private bool SelfApproves => act is not null && act.ApproverId == act.EmployeeId && act.EmployeeId == myEmployeeId;

    private bool IsReport => act?.Kind == ActKind.UsageReport;

    private bool IsSummary => act?.Kind == ActKind.Summary;
    private string PdfUrl => $"/act-pdf/{act?.Id}" + (IsSummary ? $"?order={pdfOrder}" : "");

    private string ListUrl => IsSummary ? "/summary-acts" : IsReport ? "/reports" : "/acts";

    private string pdfOrder = "date";
    private string? externalNumber;

    private Task PostSummaryAsync() => RunAsync(() => Api.PostSummaryAsync(Id),
        a => $"Сводный акт проведён: списано документами {string.Join(", ", a.Documents?.Select(d => d.Number) ?? [])}.");

    private Task SaveExternalNumberAsync() => RunAsync(() => Api.SetActExternalNumberAsync(Id, externalNumber), _ => "Номер документа 1С сохранён.");

    private bool isWarehouse;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            myEmployeeId = user.EmployeeIdOf();
            isWarehouse = user.IsWarehouseStaff();
        }

        try
        {
            act = await Api.GetActAsync(Id);
            externalNumber = act.ExternalNumber;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private Task SubmitAsync() => RunAsync(() => Api.SubmitActAsync(Id),
        a => a.Kind == ActKind.UsageReport
            ? (a.Status == ActStatus.Approved ? "Отчёт подтверждён." : "Отчёт отправлен кладовщику на подтверждение.")
            : (a.Status == ActStatus.Approved ? "Акт утверждён, позиции списаны." : $"Отправлен на утверждение: {a.ApproverName}."));

    private Task RecallAsync() => RunAsync(() => Api.RecallActAsync(Id), _ => "Отозван — снова черновик.");

    private Task ApproveAsync() => RunAsync(() => Api.ApproveActAsync(Id),
        a => a.Kind == ActKind.UsageReport
            ? "Отчёт подтверждён" + (a.DocumentNumber is { } d ? $"; вне учёта списано документом {d}." : ".")
            : $"Акт утверждён, позиции списаны документом {a.DocumentNumber}.");

    private Task ReturnAsync() => RunAsync(() => Api.ReturnActAsync(Id, remark ?? ""), _ => "Возвращён на доработку.");

    private async Task RunAsync(Func<Task<ActDto>> action, Func<ActDto, string> message)
    {
        busy = true;
        error = success = null;
        try
        {
            act = await action();
            externalNumber = act.ExternalNumber;
            success = message(act);
            remark = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        busy = true;
        error = null;
        try
        {
            var list = ListUrl;
            await Api.DeleteActAsync(Id);
            Nav.NavigateTo(list);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
            busy = false;
        }
    }
}
