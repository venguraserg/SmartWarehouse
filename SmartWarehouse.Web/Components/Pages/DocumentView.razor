@page "/documents/{Id:long}"
@inject ApiClient Api

<PageTitle>@(doc?.Number ?? "Документ") — склад</PageTitle>

<Alert Error="@error" />

@if (doc is not null)
{
    <div class="page-head">
        <h1 class="mono">@doc.Number</h1>
        <span class="tag @Ui.DocTypeClass(doc.Type)">@Ui.DocType(doc.Type)</span>
        <span class="spacer"></span>
        @if (doc.ActId is int actId)
        {
            <a class="btn" href="/acts/@actId">Акт @doc.ActNumber</a>
        }
        @if (doc.Type == MovementType.WriteOff)
        {
            <a class="btn btn-primary" href="/document-act/@doc.Id" target="_blank" rel="noopener">Акт на списание (PDF)</a>
        }
        <a class="btn" href="/documents">К списку</a>
    </div>

    <div class="panel">
        <dl class="props">
            <dt>Дата</dt>
            <dd>@Ui.Date(doc.OccurredAt)</dd>
            <dt>Основание</dt>
            <dd>@(doc.ExternalNumber ?? "—")</dd>
            <dt>Кто провёл</dt>
            <dd>
                @if (doc.PerformedById is int performerId)
                {
                    <a href="/employees/@performerId">@doc.PerformedBy</a>
                }
                else
                {
                    @(doc.PerformedBy ?? "—")
                }
            </dd>
            @if (doc.Type is MovementType.Issue or MovementType.WriteOff or MovementType.Return)
            {
                <dt>@Ui.AccountableLabel(doc.Type)</dt>
                <dd>
                    @if (doc.ReceivedById is int receiverId)
                    {
                        <a href="/employees/@receiverId">@doc.ReceivedBy</a>
                    }
                    else
                    {
                        @("—")
                    }
                </dd>
            }
            @if (doc.EquipmentId is int equipmentId)
            {
                <dt>Оборудование</dt>
                <dd>@(equipment.FirstOrDefault(e => e.Id == equipmentId) is { } eq ? $"{eq.Code} — {eq.Name}" : $"№{equipmentId}")</dd>
            }
            @if (!string.IsNullOrWhiteSpace(doc.Comment))
            {
                <dt>@(doc.Type == MovementType.WriteOff ? "Куда использовано" : "Комментарий")</dt>
                <dd style="white-space: pre-line">@doc.Comment</dd>
            }
        </dl>
    </div>

    <h2>Строки</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th class="num">№</th>
                    <th>Артикул</th>
                    <th>Наименование</th>
                    <th>Откуда</th>
                    <th>Куда</th>
                    <th class="num">Количество</th>
                    @if (ShowPrices)
                    {
                        <th class="num">Цена</th>
                        <th class="num">Сумма</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var line in doc.Lines)
                {
                    <tr>
                        <td class="num">@line.LineNo</td>
                        <td class="mono"><a href="/items/@line.ItemId">@line.Sku</a></td>
                        <td>@line.ItemName</td>
                        <td>@PlaceCell(line.FromLocationName, line.FromLocation)</td>
                        <td>@PlaceCell(line.ToLocationName, line.ToLocation)</td>
                        <td class="num">
                            @Ui.Qty(line.Quantity) @line.UnitCode
                            @if (line.BatchDate is { } batchDate)
                            {
                                <div class="line-hint">партия от @Ui.Day(batchDate)</div>
                            }
                        </td>
                        @if (ShowPrices)
                        {
                            <td class="num">@(line.UnitPrice is decimal p ? Ui.Price(p) : "—")</td>
                            <td class="num">@(line.UnitPrice is decimal q ? Ui.Money(decimal.Round(line.Quantity * q, 2, MidpointRounding.AwayFromZero)) : "—")</td>
                        }
                    </tr>
                }
            </tbody>
            @if (ShowPrices)
            {
                <tfoot>
                    <tr>
                        <td colspan="7" class="num"><strong>Итого</strong></td>
                        <td class="num"><strong>@Ui.Money(Total)</strong>@(doc.Lines.Any(l => l.UnitPrice is null) ? "*" : "")</td>
                    </tr>
                </tfoot>
            }
        </table>
        @if (ShowPrices && doc.Lines.Any(l => l.UnitPrice is null))
        {
            <div class="field-hint">* без строк, у партий которых цена не указана.</div>
        }
    </div>
}
else if (error is null)
{
    <p class="loading">Загрузка…</p>
}

@code {
    /// <summary>Место в строке документа: описание, под ним код.</summary>
    private static RenderFragment PlaceCell(string? name, string? code)
    {
        if (code is null)
            return @<span class="muted">—</span>;
        if (string.IsNullOrWhiteSpace(name))
            return @<span class="mono">@code</span>;
        return @<span>@name<br /><span class="line-hint mono">@code</span></span>;
    }

    [Parameter] public long Id { get; set; }

    private DocumentDto? doc;

    /// <summary>Цены есть в ответе только у тех, кому их можно видеть.</summary>
    private bool ShowPrices => doc?.Lines.Any(l => l.UnitPrice is not null) == true;

    private decimal Total => doc?.Lines
        .Where(l => l.UnitPrice is not null)
        .Sum(l => decimal.Round(l.Quantity * l.UnitPrice!.Value, 2, MidpointRounding.AwayFromZero)) ?? 0;
    private List<EquipmentDto> equipment = [];
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            doc = await Api.GetDocumentAsync(Id);
            if (doc.EquipmentId is not null)
                equipment = await Api.GetEquipmentAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }
}
