@page "/admin/import"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject ApiClient Api

<PageTitle>Импорт остатков — склад</PageTitle>

<h1>Импорт начальных остатков</h1>
<p class="muted" style="margin-top: -.5rem">
    Из файла «Начальные остатки — готово (1С на …)»: лист «Импорт» — партии 1С с адресами хранения.
    Сначала проверка (ничего не меняется), затем загрузка.
</p>

<Alert Error="@error" Success="@success" />

<div class="panel ref-section" style="max-width: 820px">
    <div class="field-row">
        <div class="field">
            <label for="wh">Склад</label>
            @if (warehouses is { Count: 0 })
            {
                <p class="muted">Складов нет — сначала создайте склад в «<a href="/warehouses">Складах и местах</a>».</p>
            }
            else
            {
                <select id="wh" @bind="warehouseId" @bind:after="Reset">
                    @foreach (var w in warehouses ?? [])
                    {
                        <option value="@w.Id">@w.Code — @w.Name</option>
                    }
                </select>
            }
        </div>
        <div class="field">
            <label for="file">Файл Excel (.xlsx)</label>
            <InputFile id="file" accept=".xlsx" OnChange="OnFileAsync" disabled="@busy" />
        </div>
    </div>
    <div class="field-hint">
        Позиции, единицы, места хранения (из адресов «2A.2.1.3») и сотрудники-МОЛ создаются, если их нет.
        Остатки вводятся документами прихода (партии — с ценой и датой документа 1С), подотчёт — выдачей сотрудникам.
        <strong>Загружайте один раз:</strong> повторная загрузка добавит остатки ещё раз.
    </div>
    <div class="actions">
        <button class="btn btn-primary" type="button" disabled="@(busy || data is null || warehouseId == 0)" @onclick="() => RunAsync(false)">Проверить</button>
        @if (check is not null && !check.Applied)
        {
            if (confirm)
            {
                <button class="btn btn-danger" type="button" disabled="@busy" @onclick="() => RunAsync(true)">Да, загрузить @check.RowsImported партий</button>
                <button class="btn" type="button" disabled="@busy" @onclick="() => confirm = false">Отмена</button>
            }
            else
            {
                <button class="btn" type="button" disabled="@(busy || check.RowsImported == 0)" @onclick="() => confirm = true">Загрузить…</button>
            }
        }
    </div>
    @if (busy)
    {
        <p class="loading">@(applying ? "Загрузка… Это может занять несколько минут — не закрывайте страницу." : "Проверка файла…")</p>
    }
</div>

@if (check is { } r)
{
    <h2>@(r.Applied ? "Загружено" : "Проверка: что будет загружено")</h2>
    <div class="table-wrap" style="max-width: 820px">
        <table>
            <tbody>
                <tr><td>Строк в файле</td><td class="num">@r.Rows</td></tr>
                <tr><td>Партий @(r.Applied ? "загружено" : "к загрузке")</td><td class="num"><strong>@r.RowsImported</strong></td></tr>
                <tr><td>&nbsp;&nbsp;на склад / в подотчёт</td><td class="num">@r.WarehouseBatches / @r.CustodyBatches</td></tr>
                <tr><td>Стоимость, руб.</td><td class="num">@Ui.Money(r.Value)</td></tr>
                <tr><td>Новых позиций / уже были</td><td class="num">@r.ItemsNew / @r.ItemsExisting</td></tr>
                <tr><td>Новых мест хранения</td><td class="num">@r.LocationsNew</td></tr>
                <tr><td>Новых единиц измерения</td><td class="num">@r.UnitsNew</td></tr>
                <tr><td>Новых сотрудников (МОЛ)</td><td class="num">@r.EmployeesNew</td></tr>
                <tr><td>Пропущено строк</td><td class="num">@r.Issues.Count(i => i.Skipped)</td></tr>
            </tbody>
        </table>
    </div>

    @if (r.Applied && r.DocumentIds.Count > 0)
    {
        <p>
            Документы:
            @foreach (var id in r.DocumentIds)
            {
                <a class="mono" href="/documents/@id" style="margin-right: .5rem">@id</a>
            }
        </p>
    }

    @if (r.Notes.Count > 0)
    {
        <h3>Замечания</h3>
        <ul>
            @foreach (var n in r.Notes)
            {
                <li>@n</li>
            }
        </ul>
    }

    @if (r.Issues.Count > 0)
    {
        <h3>Строки с замечаниями (@r.Issues.Count)</h3>
        <div class="table-wrap">
            <table>
                <thead><tr><th class="num">Строка</th><th>Код</th><th>Что не так</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in r.Issues.Take(1000))
                    {
                        <tr>
                            <td class="num">@i.Line</td>
                            <td class="mono">@i.Code</td>
                            <td>@i.Message</td>
                            <td>@(i.Skipped ? "пропущена" : "загружена")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (r.Issues.Count > 1000)
        {
            <p class="muted">Показаны первые 1000.</p>
        }
    }
}

@code {
    private const long MaxBytes = 30 * 1024 * 1024;

    private List<WarehouseDto>? warehouses;
    private int warehouseId;
    private byte[]? data;
    private string? fileName;
    private OpeningImportResult? check;
    private bool confirm;
    private bool busy;
    private bool applying;
    private string? error;
    private string? success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            warehouses = await Api.GetWarehousesAsync();
            warehouseId = warehouses.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private void Reset()
    {
        check = null;
        confirm = false;
        success = null;
    }

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        Reset();
        error = null;
        if (e.File.Size > MaxBytes)
        {
            error = "Файл больше 30 МБ.";
            return;
        }
        busy = true;
        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(MaxBytes))
                await stream.CopyToAsync(buffer);
            data = buffer.ToArray();
            fileName = e.File.Name;
        }
        catch (IOException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunAsync(bool apply)
    {
        if (data is null)
            return;
        busy = true;
        applying = apply;
        error = success = null;
        try
        {
            check = await Api.ImportOpeningAsync(data, fileName ?? "import.xlsx", warehouseId, apply);
            confirm = false;
            if (check.Applied)
            {
                success = $"Загружено партий: {check.RowsImported} на {Ui.Money(check.Value)} руб.";
                data = null;
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
            applying = false;
        }
    }
}
