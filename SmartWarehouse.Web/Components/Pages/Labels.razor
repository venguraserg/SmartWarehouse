@page "/labels"
@attribute [Authorize(Roles = AppRoles.Warehouse)]
@inject ApiClient Api
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Наклейки QR — Склад ОЭТО</PageTitle>

<h1>Наклейки с QR-кодами</h1>
<p class="muted" style="margin-top: -.5rem">
    Печать на листы A4 с самоклеящимися наклейками. QR-код распознают ручной сканер и сканер в приложении:
    сразу открывается ячейка или позиция, а в документе добавляется строка.
</p>

<Alert Error="@error" />

@if (qr?.QrContent == QrContent.Code)
{
    <p class="muted">
        В QR — сам код места или артикул, без ссылки.
        <AuthorizeView Roles="@AppRoles.Admin">Изменить — в <a href="/admin/settings">настройках</a>.</AuthorizeView>
    </p>
}
else if (qr is not null && LinkBase is { } link && IsLocalHost(link))
{
    <div class="alert alert-error">
        В QR-коды попадёт адрес <span class="mono">@link</span> — телефоны его не откроют.
        Укажите адрес приложения в <a href="/admin/settings">настройках</a> (IP или имя сервера) или откройте сайт по такому адресу.
        Сканер внутри приложения такие наклейки всё равно распознает.
    </div>
}
else if (qr is not null && LinkBase is { } shown)
{
    <p class="muted">В QR — ссылки: <span class="mono">@shown</span>/l/… и /i/…</p>
}

<div class="toolbar">
    <div class="segmented">
        <button type="button" class="@(kind == LabelKind.Rack ? "active" : null)" @onclick="() => SetKindAsync(LabelKind.Rack)">По стеллажу</button>
        <button type="button" class="@(kind == LabelKind.Location ? "active" : null)" @onclick="() => SetKindAsync(LabelKind.Location)">Места хранения</button>
        <button type="button" class="@(kind == LabelKind.Item ? "active" : null)" @onclick="() => SetKindAsync(LabelKind.Item)">Номенклатура</button>
    </div>
</div>

<div class="panel" style="margin-bottom: 1rem">
    <div class="field-row">
        <div class="field">
            <label for="layout">Лист</label>
            <select id="layout" @bind="layout">
                @foreach (var l in layouts)
                {
                    <option value="@l.Id">@l.Title</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="skip">Пропустить наклеек в начале</label>
            <input id="skip" type="number" min="0" max="@(PerSheet - 1)" @bind="skip" />
            <div class="field-hint">Если лист уже частично использован.</div>
        </div>
        <div class="field">
            <label for="copies">Копий каждой</label>
            <input id="copies" type="number" min="1" max="50" @bind="copies" />
        </div>
    </div>
    @if (kind == LabelKind.Rack)
    {
        <div class="toolbar" style="margin: .5rem 0 0">
            <label class="checkbox"><input type="checkbox" @bind="rackSign" /> Табличка стеллажа (лист A5)</label>
            <label class="checkbox"><input type="checkbox" @bind="rackStickers" /> Наклейки полок и ячеек</label>
        </div>
        <div class="field-hint">
            Порядок — как клеить: полки сверху вниз, пол — последним, внутри полки — ячейки по номеру.
            У полки с ячейками печатаются наклейки только ячеек. Таблички идут отдельными листами A5 перед листами наклеек.
        </div>
    }
</div>

@if (kind is LabelKind.Location or LabelKind.Rack)
{
    <div class="toolbar">
        <select @bind="warehouseId" @bind:after="LoadLocationsAsync" style="max-width: 260px">
            @foreach (var w in warehouses)
            {
                <option value="@w.Id">@w.Code — @w.Name</option>
            }
        </select>
        @if (kind == LabelKind.Location)
        {
            <div style="min-width: 280px; flex: 1; max-width: 520px">
                <PlacePicker Tree="branchTree" @bind-Value="branchId" Title="Наклейки для места и всего, что в нём"
                             AllowClear="true" ClearText="Весь склад" Placeholder="Весь склад — или выберите стеллаж, полку" />
            </div>
        }
        <input type="search" placeholder="@(kind == LabelKind.Rack ? "Фильтр: C3, ворота" : "Фильтр: C3 1")" @bind="filter" @bind:event="oninput" style="max-width: 220px" />
        @if (kind == LabelKind.Location)
        {
            <label class="checkbox"><input type="checkbox" @bind="onlyLeaves" /> только конечные места (без вложенных)</label>
        }
    </div>
}
else
{
    <form class="toolbar" @onsubmit="LoadItemsAsync" @onsubmit:preventDefault>
        <input type="search" placeholder="Артикул, наименование или штрих-код" @bind="filter" style="max-width: 360px" />
        <button class="btn" type="submit">Найти</button>
    </form>
}

@if (rows is null)
{
    if (error is null)
    {
        <p class="loading">Загрузка…</p>
    }
}
else
{
    <div class="toolbar">
        <button class="btn btn-sm" type="button" @onclick="SelectAllVisible" disabled="@(Visible.Count == 0)">Выбрать все показанные (@Visible.Count)</button>
        <button class="btn btn-sm" type="button" @onclick="() => chosen.Clear()" disabled="@(chosen.Count == 0)">Снять выбор</button>
        <span class="spacer"></span>
        <span class="muted">Выбрано: @chosen.Count · наклеек: @(StickerCount * Math.Max(1, copies)) · листов: @Sheets@(kind == LabelKind.Rack && rackSign ? $" + табличек A5: {chosen.Count}" : "")</span>
        @if (chosen.Count > 0 && (kind != LabelKind.Rack || rackSign || rackStickers))
        {
            <a class="btn btn-primary" href="@PdfUrl" target="_blank" rel="noopener">Сформировать PDF</a>
        }
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 40px"></th>
                    <th>Код</th>
                    <th>Наименование</th>
                    <th>@(kind switch { LabelKind.Location => "Тип", LabelKind.Rack => "Наклеек", _ => "Штрих-код" })</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Visible)
                {
                    <tr @onclick="() => Toggle(r.Id)" style="cursor: pointer">
                        <td><input type="checkbox" checked="@chosen.Contains(r.Id)" @onclick:stopPropagation @onchange="() => Toggle(r.Id)" /></td>
                        <td class="mono" style="padding-left: @Indent(r.Depth)">@r.Code</td>
                        <td class="col-name">@r.Name</td>
                        <td class="muted">@r.Note</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Visible.Count == 0)
        {
            <div class="empty">@(kind switch
            {
                LabelKind.Location => "Мест хранения нет — создайте их в разделе «Склады и места».",
                LabelKind.Rack => "Стеллажей нет — создайте их в разделе «Склады и места».",
                _ => "Ничего не найдено."
            })</div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "warehouse")] public int? WarehouseParam { get; set; }

    private LabelKind kind = LabelKind.Rack;
    private bool rackSign = true;
    private bool rackStickers = true;
    private List<LabelLayoutDto> layouts = [];
    private string layout = "3x8";
    private int skip;
    private int copies = 1;

    private List<WarehouseDto> warehouses = [];
    private int? warehouseId;
    private bool onlyLeaves = true;

    /// <summary>Места склада деревом — выбрать стеллаж или полку и печатать всё, что в ней.</summary>
    private PlaceTree branchTree = new();

    /// <summary>Выбранная ветка: показываются она и всё вложенное; null — весь склад.</summary>
    private int? branchId;
    private string? filter;

    private List<Row>? rows;
    private readonly HashSet<int> chosen = [];
    private string? error;

    private LabelSettingsDto? qr;

    /// <summary>Адрес, который попадёт в ссылки QR-кодов: из настроек, иначе как в /labels.pdf.</summary>
    private string? LinkBase =>
        !string.IsNullOrWhiteSpace(qr?.BaseUrl) ? qr.BaseUrl.TrimEnd('/')
        : string.IsNullOrWhiteSpace(Config["App:PublicUrl"]) ? Nav.BaseUri.TrimEnd('/') : Config["App:PublicUrl"]!.TrimEnd('/');

    private static bool IsLocalHost(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.IsLoopback || uri.Host == "localhost");

    private int PerSheet => layouts.FirstOrDefault(l => l.Id == layout) is { } l ? l.Columns * l.Rows : 24;

    /// <summary>Сколько наклеек выйдет: для стеллажей — сумма по выбранным (полки без ячеек и ячейки).</summary>
    private int StickerCount => kind != LabelKind.Rack ? chosen.Count
        : !rackStickers ? 0
        : chosen.Sum(id => rackStickerCounts.GetValueOrDefault(id, 1));

    private readonly Dictionary<int, int> rackStickerCounts = [];

    private int Sheets => StickerCount == 0 ? 0 : (Math.Clamp(skip, 0, PerSheet - 1) + StickerCount * Math.Max(1, copies) + PerSheet - 1) / PerSheet;

    private List<Row> Visible =>
        (rows ?? new List<Row>())
            .Where(r => kind != LabelKind.Location || !onlyLeaves || r.IsLeaf)
            .Where(r => kind != LabelKind.Location || branchId is not int b || InBranch(b, r.Id))
            .Where(r => kind == LabelKind.Item
                        || SmartWarehouse.Application.Services.SearchWords.Matches(filter, r.Code, r.Name))
            .ToList();

    private HashSet<int>? branchIds;
    private int? branchIdsFor;

    private bool InBranch(int branch, int id)
    {
        if (branchIdsFor != branch || branchIds is null)
        {
            branchIds = branchTree.SubtreeOf(branch).ToHashSet();
            branchIdsFor = branch;
        }
        return branchIds.Contains(id);
    }

    private string PdfUrl =>
        $"/labels.pdf?kind={kind}&layout={Uri.EscapeDataString(layout)}&skip={Math.Clamp(skip, 0, PerSheet - 1)}" +
        $"&copies={Math.Clamp(copies, 1, 50)}&ids={string.Join(',', kind == LabelKind.Rack ? chosen.OrderBy(branchTree.OrderOf) : chosen.OrderBy(x => x))}" +
        (kind == LabelKind.Rack ? $"&sign={(rackSign ? "true" : "false")}&stickers={(rackStickers ? "true" : "false")}" : "");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            layouts = await Api.GetLabelLayoutsAsync();
            qr = await Api.GetLabelSettingsAsync();
            warehouses = await Api.GetWarehousesAsync();
            warehouseId = warehouses.Any(w => w.Id == WarehouseParam) ? WarehouseParam : warehouses.FirstOrDefault()?.Id;
            await LoadLocationsAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private async Task SetKindAsync(LabelKind value)
    {
        if (kind == value)
            return;
        kind = value;
        chosen.Clear();
        filter = null;
        rows = null;
        if (kind == LabelKind.Item)
            await LoadItemsAsync();
        else
            await LoadLocationsAsync();
    }

    private async Task LoadLocationsAsync()
    {
        chosen.Clear();
        if (warehouseId is not int id)
        {
            rows = [];
            return;
        }
        try
        {
            var result = new List<Row>();
            var roots = await Api.GetLocationTreeAsync(id);
            Flatten(roots, 0, result);
            branchTree = new PlaceTree().AddGroup(null, roots);
            // Наименование места — адрес словами и описание (а не «Ячейка 1»).
            rows = kind == LabelKind.Rack ? RackRows() : result.Select(r => r with { Name = Describe(r.Id) }).ToList();
            branchId = null;
            branchIdsFor = null;
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }

        static void Flatten(IEnumerable<LocationNodeDto> nodes, int depth, List<Row> into)
        {
            foreach (var n in nodes.OrderBy(n => n.Code))
            {
                into.Add(new Row(n.Id, n.FullCode, n.Name, Ui.LocType(n.Type), depth, n.Children.Count == 0));
                Flatten(n.Children, depth + 1, into);
            }
        }
    }

    private async Task LoadItemsAsync()
    {
        try
        {
            rows = (await Api.GetItemsAsync(search: filter))
                .Where(i => i.IsActive)
                .Select(i => new Row(i.Id, i.Sku, i.Name, i.Barcode, 0, true))
                .ToList();
            error = null;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
    }

    private string Describe(int id)
    {
        var a = branchTree.AddressOf(id);
        return a.Note is null ? a.Full : $"{a.Full} — {a.Note}";
    }

    /// <summary>Стеллажи склада в порядке дерева и сколько наклеек выйдет на каждый.</summary>
    private List<Row> RackRows()
    {
        rackStickerCounts.Clear();
        var racks = new List<Row>();
        foreach (var rack in branchTree.All.Where(n => n.Type == LocationType.Rack))
        {
            var count = 0;
            foreach (var child in rack.Children)
                count += child.Type == LocationType.Shelf ? Math.Max(1, child.Children.Count) : 1;
            rackStickerCounts[rack.Id] = Math.Max(1, count);
            var a = branchTree.AddressOf(rack.Id);
            racks.Add(new Row(rack.Id, rack.FullCode, a.Note is null ? a.GroupTitle : $"{a.GroupTitle} — {a.Note}",
                rackStickerCounts[rack.Id].ToString(System.Globalization.CultureInfo.InvariantCulture), 0, true));
        }
        return racks;
    }

    private void Toggle(int id)
    {
        if (!chosen.Remove(id))
            chosen.Add(id);
    }

    private void SelectAllVisible()
    {
        foreach (var r in Visible)
            chosen.Add(r.Id);
    }

    /// <summary>Отступ уровня дерева (CSS не зависит от языковых настроек сервера).</summary>
    private static string Indent(int depth) =>
        (depth * 1.1 + .6).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "rem";

    private sealed record Row(int Id, string Code, string? Name, string? Note, int Depth, bool IsLeaf);
}
