<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Шрифт — из приложения (сеть комбината может быть без интернета); основные начертания грузим сразу *@
    <link rel="preload" href="fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/Inter-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Установка на телефон как приложение (PWA); иконка — знак ТМК на фирменном градиенте *@
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#004820" />
    <link rel="icon" type="image/svg+xml" href="img/tmk_app_icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="icons/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="icons/icon-16.png" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @if (PageRenderMode is not null)
    {
        @* Пока интерактивная часть не подключилась — «Загрузка…», а не белый экран; не подключилась за 15 с — причина. *@
        <div id="sw-boot" class="sw-boot">
            <div id="sw-boot-loading" class="sw-boot-loading">Загрузка…</div>
            <div id="sw-boot-problem" class="sw-boot-problem" hidden>
                <h2>Приложение не запустилось</h2>
                <p id="sw-boot-hint">Проверьте связь с сервером и обновите страницу. Если не помогает — пришлите администратору текст ниже (снимок экрана).</p>
                <button type="button" class="btn btn-primary" onclick="location.reload()">Обновить</button>
                <pre id="sw-boot-details"></pre>
            </div>
        </div>
        <script src="js/boot.js"></script>
    }
    <Routes @rendermode="PageRenderMode" />
    <script src="js/latin-input.js"></script>
    <script src="js/android-app.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Обычные страницы — интерактивные (на сервере, без предварительной отрисовки: данные грузятся один раз).
    // Страницы входа и смены пароля — статические: им нужно записать cookie в ответ.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
