@* Значки интерфейса: линейные, 24×24, цвет — от текста (currentColor). Декоративные — скрыты от экранного диктора. *@

<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "home":
            <path d="M4 11l8-7 8 7"></path><path d="M6 10v10h12V10"></path><path d="M10 20v-6h4v6"></path>
            break;
        case "box":
            <path d="M4 8l8-4 8 4v8l-8 4-8-4z"></path><path d="M4 8l8 4 8-4M12 12v8"></path>
            break;
        case "scan":
            <path d="M4 8V5h3M17 5h3v3M20 16v3h-3M7 19H4v-3"></path><path d="M8 12h8"></path>
            break;
        case "inbox":
            <path d="M4 13l2.5-7h11L20 13v6H4z"></path><path d="M4 13h4.5l1 2h5l1-2H20"></path>
            break;
        case "custody":
            <circle cx="9" cy="8" r="3.2"></circle><path d="M3.5 19c.8-3.2 3-5 5.5-5s4.7 1.8 5.5 5"></path><path d="M15 6h5M15 10h5M17 14h3"></path>
            break;
        case "more":
            <path d="M4 7h16M4 12h16M4 17h16"></path>
            break;
        case "receive":
            <path d="M12 4v11"></path><path d="M7.5 10.5L12 15l4.5-4.5"></path><path d="M4 16v4h16v-4"></path>
            break;
        case "plus":
            <path d="M12 5v14M5 12h14"></path>
            break;
        case "issue":
            <path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path>
            break;
        case "return":
            <path d="M9 7L4 12l5 5"></path><path d="M4 12h11a5 5 0 0 1 0 10h-2"></path>
            break;
        case "transfer":
            <path d="M4 8h14l-3-3M20 16H6l3 3"></path>
            break;
        case "act":
            <path d="M7 3h7l4 4v14H7z"></path><path d="M14 3v4h4"></path><path d="M10 12h5M10 16h5"></path>
            break;
        case "report":
            <path d="M6 3h12v18H6z"></path><path d="M9 8h6M9 12h6M9 16h3"></path>
            break;
        case "adjust":
            <path d="M5 7h9M18 7h1M5 17h1M10 17h9"></path><circle cx="16" cy="7" r="2"></circle><circle cx="8" cy="17" r="2"></circle>
            break;
        case "request":
            <path d="M6 4h12v16l-3-2-3 2-3-2-3 2z"></path><path d="M9 9h6M9 13h4"></path>
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5"></path>
            break;
        case "alert":
            <path d="M12 4l9 16H3z"></path><path d="M12 10v4M12 17.5v.01"></path>
            break;
        case "empty":
            <circle cx="12" cy="12" r="8"></circle><path d="M6.5 17.5l11-11"></path>
            break;
        case "clock":
            <circle cx="12" cy="12" r="8"></circle><path d="M12 8v4l3 2"></path>
            break;
        case "search":
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18"></path>
            break;
        case "minus":
            <path d="M5 12h14"></path>
            break;
        case "refresh":
            <path d="M19 12a7 7 0 1 1-2.05-4.95"></path><path d="M19 4v4h-4"></path>
            break;
        case "camera":
            <path d="M4 8h3l1.5-2h7L17 8h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle>
            break;
        case "back":
            <path d="M19 12H5"></path><path d="M11 6l-6 6 6 6"></path>
            break;
        case "docs":
            <path d="M8 3h8l3 3v13H8z"></path><path d="M5 6v15h11"></path><path d="M11 10h5M11 14h5"></path>
            break;
        case "tag":
            <path d="M4 4h7l9 9-7 7-9-9z"></path><circle cx="8" cy="8" r="1.4"></circle>
            break;
        case "shelves":
            <path d="M4 3v18M20 3v18M4 8h16M4 14h16M4 20h16"></path><path d="M7 5.5h3M13 11h4M8 17h3"></path>
            break;
        case "users":
            <circle cx="9" cy="8" r="3"></circle><path d="M3.5 19c.8-3 3-4.8 5.5-4.8s4.7 1.8 5.5 4.8"></path><path d="M16 5.2a3 3 0 0 1 0 5.6M18 14.6c1.3.7 2.1 2.2 2.5 4.4"></path>
            break;
        case "user":
            <circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c1-3.5 3.8-5.5 7-5.5s6 2 7 5.5"></path>
            break;
        case "book":
            <path d="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"></path><path d="M5 17a3 3 0 0 1 3-3h10"></path>
            break;
        case "qr":
            <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"></path><path d="M14 14h2v2h-2zM18 14h2M14 18v2M18 18h2v2"></path>
            break;
        case "sync":
            <path d="M4 9h13l-3-3M20 15H7l3 3"></path>
            break;
        case "upload":
            <path d="M12 16V4"></path><path d="M7.5 8.5L12 4l4.5 4.5"></path><path d="M4 16v4h16v-4"></path>
            break;
        case "settings":
            <circle cx="12" cy="12" r="3"></circle><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"></path>
            break;
        case "equipment":
            <path d="M14.5 5.5a4 4 0 0 0 4.9 4.9l-9 9a2.1 2.1 0 0 1-3-3l9-9a4 4 0 0 1-1.9-1.9z"></path><path d="M14.5 5.5L17 3l1.5 3.5L22 8l-2.6 2.4"></path>
            break;
        case "cart":
            <path d="M3 4h2.5l2 11h10.5l2-8H6.5"></path><circle cx="9" cy="19.5" r="1.3"></circle><circle cx="17" cy="19.5" r="1.3"></circle>
            break;
        case "palette":
            <path d="M12 3a9 9 0 0 0 0 18c1.4 0 2-.9 2-1.8 0-1.4-1.2-1.7-1.2-2.9 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4C21 6.4 17 3 12 3z"></path><circle cx="7.5" cy="11" r="1"></circle><circle cx="10.5" cy="7.5" r="1"></circle><circle cx="15" cy="7.5" r="1"></circle>
            break;
        case "key":
            <circle cx="8" cy="15" r="4"></circle><path d="M11 12l8-8M16 7l2.5 2.5M14 9l2 2"></path>
            break;
        case "logout":
            <path d="M14 4h5v16h-5"></path><path d="M10 8l-4 4 4 4M6 12h10"></path>
            break;
        case "summary":
            <path d="M12 3l9 5-9 5-9-5z"></path><path d="M3 12.5l9 5 9-5M3 17l9 5 9-5"></path>
            break;
        case "expand":
            <path d="M7 10l5 5 5-5"></path>
            break;
        case "collapse":
            <path d="M7 14l5-5 5 5"></path>
            break;
        case "phone":
            <path d="M8 3h8v18H8z"></path><path d="M11 18h2"></path>
            break;
        case "trash":
            <path d="M4 7h16M10 7V4h4v3M6 7l1 13h10l1-13"></path><path d="M10 11v6M14 11v6"></path>
            break;
        default:
            <circle cx="12" cy="12" r="3"></circle>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public int Size { get; set; } = 20;

    [Parameter] public string? Class { get; set; }
}
