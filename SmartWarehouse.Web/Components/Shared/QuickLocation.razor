@* Быстрое создание места хранения из документа (например, «куда» в приходе), не уходя со страницы.
   Новое место — конечное (в него кладут товар); вложить можно в любое место, кроме ячейки. *@
@inject ApiClient Api

<div class="quick-add">
    <div class="quick-add-title">Новое место хранения</div>
    @if (warehouses is null)
    {
        <p class="loading">Загрузка…</p>
    }
    else if (warehouses.Count == 0)
    {
        <p class="muted">Складов нет — создайте склад в разделе «Склады и места».</p>
        <button class="btn btn-sm" type="button" @onclick="OnCancel">Закрыть</button>
    }
    else
    {
        <div class="inline-form">
            <div class="field">
                <label for="ql-parent">Где <span class="req">*</span></label>
                <select id="ql-parent" @bind="parentKey" @bind:after="OnParentChanged">
                    @foreach (var p in parents)
                    {
                        <option value="@p.Key">@p.Title</option>
                    }
                </select>
            </div>
            <div class="field" style="max-width: 130px">
                <label for="ql-type">Тип</label>
                <select id="ql-type" @bind="type" @bind:after="SuggestCode">
                    @foreach (var t in AllowedTypes)
                    {
                        <option value="@t">@Ui.LocType(t)</option>
                    }
                </select>
            </div>
            <div class="field" style="max-width: 110px">
                <label for="ql-code">Код <span class="req">*</span></label>
                <CodeInput Id="ql-code" @bind-Value="code" />
            </div>
            <div class="field">
                <label for="ql-name">Описание <span class="req">*</span></label>
                <input id="ql-name" type="text" @bind="description" @bind:event="oninput" maxlength="128" placeholder="Подшипники 62xx" />
            </div>
            <button class="btn btn-primary btn-sm" type="button" disabled="@(busy || string.IsNullOrEmpty(code) || string.IsNullOrWhiteSpace(description))" @onclick="CreateAsync">Создать</button>
            <button class="btn btn-sm" type="button" @onclick="OnCancel">Отмена</button>
        </div>
        <div class="field-hint">Полный код: <span class="mono">@Selected?.Prefix-@(string.IsNullOrEmpty(code) ? "…" : code)</span></div>
    }
    <FieldError Message="@error" />
</div>

@code {
    [Parameter] public EventCallback<LocationDto> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private List<WarehouseDto>? warehouses;
    private List<Parent> parents = [];
    private string? parentKey;
    private LocationType type = LocationType.Cell;
    private string? code;
    private string? description;
    private bool busy;
    private string? error;

    /// <summary>Куда вложить: склад (верхний уровень) или место, кроме ячейки.</summary>
    private sealed record Parent(string Key, int WarehouseId, int? LocationId, LocationType? Type, string Prefix, string Title, IReadOnlyList<string> ChildCodes);

    private Parent? Selected => parents.FirstOrDefault(p => p.Key == parentKey);

    private List<LocationType> AllowedTypes =>
        Enum.GetValues<LocationType>().Where(t => Selected?.Type is not LocationType pt || t > pt).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            warehouses = await Api.GetWarehousesAsync();
            foreach (var w in warehouses)
            {
                var tree = await Api.GetLocationTreeAsync(w.Id);
                parents.Add(new Parent($"w{w.Id}", w.Id, null, null, w.Code, $"{w.Code} — {w.Name} (верхний уровень)", tree.Select(n => n.Code).ToList()));
                Walk(w.Id, tree, 1);
            }
            parentKey = parents.FirstOrDefault()?.Key;
            OnParentChanged();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }

        void Walk(int warehouseId, IEnumerable<LocationNodeDto> nodes, int depth)
        {
            foreach (var n in nodes.OrderBy(n => n.Code))
            {
                if (n.Type == LocationType.Cell)
                    continue;
                parents.Add(new Parent($"l{n.Id}", warehouseId, n.Id, n.Type, n.FullCode,
                    $"{new string('\u00A0', depth * 3)}{Ui.Place(n.Name, n.FullCode)}", n.Children.Select(c => c.Code).ToList()));
                Walk(warehouseId, n.Children, depth + 1);
            }
        }
    }

    private void OnParentChanged()
    {
        if (!AllowedTypes.Contains(type))
            type = AllowedTypes.LastOrDefault();
        SuggestCode();
    }

    private void SuggestCode() => code = Codes.NextLocationCode(type, Selected?.ChildCodes ?? []);

    private async Task CreateAsync()
    {
        if (Selected is not { } parent)
            return;
        busy = true;
        error = null;
        try
        {
            var created = await Api.AddLocationAsync(parent.WarehouseId, new CreateLocationRequest(parent.LocationId, type, code!, description!.Trim()));
            await OnCreated.InvokeAsync(created);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
