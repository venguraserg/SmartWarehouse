@* Выбор места хранения деревом, как в «Склады и места»: уровни раскрываются «+», выбрать можно любой
   (товар может лежать и прямо на полке, где стоят ящики). Есть поиск по коду и описанию. *@

<TreePicker Tree="Tree.Pick" Value="Value" ValueChanged="ValueChanged" Title="@Title" Placeholder="@Placeholder"
            SearchPlaceholder="Поиск: код или описание места" Invalid="Invalid" Disabled="Disabled"
            AllowClear="AllowClear" ClearText="@ClearText" Exclude="Exclude" Marks="Marks"
            CanSelect="PickCanSelect" />

@code {
    [Parameter, EditorRequired] public PlaceTree Tree { get; set; } = new();

    [Parameter] public int? Value { get; set; }

    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>Заголовок окна выбора: «Куда положить».</summary>
    [Parameter] public string Title { get; set; } = "Выберите место";

    [Parameter] public string Placeholder { get; set; } = "— выберите место —";

    [Parameter] public bool Invalid { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool AllowClear { get; set; }

    /// <summary>Подпись кнопки сброса: «Все места», «Верхний уровень склада».</summary>
    [Parameter] public string ClearText { get; set; } = "Очистить выбор";

    /// <summary>Какие места можно выбрать (остальные видны, раскрываются, но не выбираются).</summary>
    [Parameter] public Func<LocationNodeDto, bool>? CanSelect { get; set; }

    /// <summary>Места, которые выбрать нельзя (и всё, что в них вложено), — например, «Приёмка».</summary>
    [Parameter] public IReadOnlySet<int>? Exclude { get; set; }

    /// <summary>Пометки у мест: «есть 5 шт» — где позиция уже лежит.</summary>
    [Parameter] public IReadOnlyDictionary<int, string>? Marks { get; set; }

    private bool PickCanSelect(PickNode node) =>
        CanSelect is null || (Tree.ById.TryGetValue(node.Id, out var location) && CanSelect(location));
}
