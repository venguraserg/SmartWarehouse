@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ApiClient Api
@inject IJSRuntime JS
@inject ScannerHub Scanner
@implements IAsyncDisposable

<div class="app">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">SW</span>
            <span class="brand-text">Склад запчастей</span>
        </a>

        <button class="menu-toggle" type="button" @onclick="() => menuOpen = !menuOpen" aria-label="Меню">☰</button>

        <nav class="nav @(menuOpen ? "open" : null)" @onclick="() => menuOpen = false">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/scan" class="nav-scan">📷 Сканировать</NavLink>
                    <NavLink href="/" Match="NavLinkMatch.All">Обзор</NavLink>

                    <div class="nav-group">Учёт</div>
                    <NavLink href="/stock">Остатки</NavLink>
                    <NavLink href="/custody">Подотчёт</NavLink>
                    <NavLink href="/acts">
                        Акты на списание
                        @if (actsToApprove > 0)
                        {
                            <span class="nav-badge" title="Ждут вашего утверждения">@actsToApprove</span>
                        }
                    </NavLink>
                    <NavLink href="/documents">Документы</NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/documents/new/Receipt">+ Приход</NavLink>
                        <NavLink href="/documents/new/Issue">− Выдача сотруднику</NavLink>
                        <NavLink href="/documents/new/Return">↩ Возврат</NavLink>
                        <NavLink href="/documents/new/Transfer">⇄ Перемещение</NavLink>
                    </AuthorizeView>

                    <div class="nav-group">Данные</div>
                    <NavLink href="/items">Номенклатура</NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/warehouses">Склады и места</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@($"{AppRoles.Admin},{AppRoles.Storekeeper},{AppRoles.Manager}")" Context="staff">
                        <NavLink href="/employees">Сотрудники</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/references">Справочники</NavLink>
                        <NavLink href="/labels">Наклейки QR</NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                        <div class="nav-group">Администрирование</div>
                        <NavLink href="/admin/users">Пользователи</NavLink>
                    </AuthorizeView>

                    <div class="nav-user">
                        <div class="nav-user-name">@context.User.DisplayNameOf()</div>
                        <div class="nav-user-actions">
                            <a href="/account/password">Сменить пароль</a>
                            <form action="/account/logout" method="post">
                                <AntiforgeryToken />
                                <button type="submit" class="link-button">Выйти</button>
                            </form>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@if (scanMessage is not null)
{
    <div class="scan-toast @(scanFailed ? "scan-toast-error" : null)" role="status" @onclick="() => scanMessage = null">@scanMessage</div>
}

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка. <a href="." class="reload">Обновить страницу</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool menuOpen;
    private int actsToApprove;

    private IJSObjectReference? scannerModule;
    private DotNetObjectReference<MainLayout>? self;
    private string? scanMessage;
    private bool scanFailed;
    private CancellationTokenSource? toastTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Ручной сканер (USB / Bluetooth) — на любой странице.
        try
        {
            self = DotNetObjectReference.Create(this);
            scannerModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard-scanner.js");
            await scannerModule.InvokeVoidAsync("attach", self);
        }
        catch (JSException)
        {
            // без перехвата сканер просто пишет в поле, как клавиатура
        }
    }

    /// <summary>Код с ручного сканера: сначала странице (документ добавит строку), иначе — открыть найденное.</summary>
    [JSInvokable]
    public async Task OnHardwareScan(string code)
    {
        try
        {
            if (await Scanner.DispatchAsync(code))
                return;

            var found = await Api.ScanAsync(code);
            Nav.NavigateTo(found.Kind == ScanKind.Location
                ? $"/l/{Uri.EscapeDataString(found.Code)}"
                : $"/items/{found.Id}");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            await ShowScanMessageAsync(ex.Message, failed: true);
        }
    }

    private async Task ShowScanMessageAsync(string message, bool failed)
    {
        toastTimer?.Cancel();
        scanMessage = message;
        scanFailed = failed;
        StateHasChanged();

        var timer = toastTimer = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), timer.Token);
            scanMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // пришло новое сообщение
        }
    }

    public async ValueTask DisposeAsync()
    {
        toastTimer?.Cancel();
        try
        {
            if (scannerModule is not null)
            {
                await scannerModule.InvokeVoidAsync("detach");
                await scannerModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // вкладка закрыта
        }
        self?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Вошёл с временным паролем — сначала смена пароля.
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true)
            return;
        if (user.MustChangePasswordOf())
        {
            Nav.NavigateTo("/account/password", forceLoad: true);
            return;
        }

        // Значок «ждут утверждения» обновляется при каждом переходе по страницам.
        if (user.EmployeeIdOf() is not null)
        {
            try
            {
                actsToApprove = await Api.GetActsToApproveCountAsync();
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                actsToApprove = 0; // меню не должно ломаться из-за недоступного API
            }
        }
    }
}
