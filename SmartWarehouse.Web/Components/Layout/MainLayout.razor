@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ApiClient Api

<div class="app">
    <aside class="sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">SW</span>
            <span class="brand-text">Склад запчастей</span>
        </a>

        <button class="menu-toggle" type="button" @onclick="() => menuOpen = !menuOpen" aria-label="Меню">☰</button>

        <nav class="nav @(menuOpen ? "open" : null)" @onclick="() => menuOpen = false">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/" Match="NavLinkMatch.All">Обзор</NavLink>

                    <div class="nav-group">Учёт</div>
                    <NavLink href="/stock">Остатки</NavLink>
                    <NavLink href="/custody">Подотчёт</NavLink>
                    <NavLink href="/acts">
                        Акты на списание
                        @if (actsToApprove > 0)
                        {
                            <span class="nav-badge" title="Ждут вашего утверждения">@actsToApprove</span>
                        }
                    </NavLink>
                    <NavLink href="/documents">Документы</NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/documents/new/Receipt">+ Приход</NavLink>
                        <NavLink href="/documents/new/Issue">− Выдача сотруднику</NavLink>
                        <NavLink href="/documents/new/Return">↩ Возврат</NavLink>
                        <NavLink href="/documents/new/Transfer">⇄ Перемещение</NavLink>
                    </AuthorizeView>

                    <div class="nav-group">Данные</div>
                    <NavLink href="/items">Номенклатура</NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/warehouses">Склады и места</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@($"{AppRoles.Admin},{AppRoles.Storekeeper},{AppRoles.Manager}")" Context="staff">
                        <NavLink href="/employees">Сотрудники</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/references">Справочники</NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                        <div class="nav-group">Администрирование</div>
                        <NavLink href="/admin/users">Пользователи</NavLink>
                    </AuthorizeView>

                    <div class="nav-user">
                        <div class="nav-user-name">@context.User.DisplayNameOf()</div>
                        <div class="nav-user-actions">
                            <a href="/account/password">Сменить пароль</a>
                            <form action="/account/logout" method="post">
                                <AntiforgeryToken />
                                <button type="submit" class="link-button">Выйти</button>
                            </form>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка. <a href="." class="reload">Обновить страницу</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool menuOpen;
    private int actsToApprove;

    protected override async Task OnParametersSetAsync()
    {
        // Вошёл с временным паролем — сначала смена пароля.
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true)
            return;
        if (user.MustChangePasswordOf())
        {
            Nav.NavigateTo("/account/password", forceLoad: true);
            return;
        }

        // Значок «ждут утверждения» обновляется при каждом переходе по страницам.
        if (user.EmployeeIdOf() is not null)
        {
            try
            {
                actsToApprove = await Api.GetActsToApproveCountAsync();
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                actsToApprove = 0; // меню не должно ломаться из-за недоступного API
            }
        }
    }
}
