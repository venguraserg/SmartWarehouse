@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ApiClient Api
@inject IJSRuntime JS
@inject ScannerHub Scanner
@implements IAsyncDisposable

<div class="app">
    @* Шапка по брифу ТМК: логотип для тёмного фона | «Склад ОЭТО»; на телефоне — только знак *@
    <header class="topbar">
        <a class="brand" href="/" aria-label="Склад ОЭТО — на главную">
            <img class="brand-logo brand-logo-ondark" src="img/tmk_logo_dark.svg" alt="Туровский молочный комбинат" width="120" height="36" />
            <img class="brand-logo brand-logo-onlight" src="img/tmk_logo_light.svg" alt="Туровский молочный комбинат" width="120" height="36" />
            <img class="brand-mark" src="img/tmk_mark_accent.svg" alt="ТМК" width="26" height="30" />
            <span class="brand-divider" aria-hidden="true"></span>
            <span class="brand-text">Склад ОЭТО</span>
        </a>
        <span class="spacer"></span>
        <button class="menu-toggle" type="button" @onclick="() => menuOpen = !menuOpen"
                aria-label="Меню" aria-expanded="@(menuOpen ? "true" : "false")"><Icon Name="@(menuOpen ? "close" : "more")" Size="22" /></button>
    </header>

    <div class="app-body">
    <aside class="sidebar @(menuOpen ? "open" : null)">
        <nav class="nav" @onclick="() => menuOpen = false">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/scan" class="nav-scan"><Icon Name="scan" Size="18" /> Сканировать</NavLink>
                    <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="home" Size="18" /> Обзор</NavLink>

                    <div class="nav-group">Учёт</div>
                    <NavLink href="/stock"><Icon Name="box" Size="18" /> Остатки</NavLink>
                    <NavLink href="/requests">
                        <Icon Name="inbox" Size="18" /> Запросы на выдачу
                        @if (openRequests > 0)
                        {
                            <span class="nav-badge" title="Ждут выдачи">@openRequests</span>
                        }
                    </NavLink>
                    <NavLink href="/custody"><Icon Name="custody" Size="18" /> Подотчёт</NavLink>
                    <NavLink href="/reports">
                        <Icon Name="report" Size="18" /> Отчёты об использовании
                        @if (reportsToConfirm > 0)
                        {
                            <span class="nav-badge" title="Ждут подтверждения кладовщиком">@reportsToConfirm</span>
                        }
                    </NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="summary">
                        <NavLink href="/summary-acts"><Icon Name="summary" Size="18" /> Сводные акты</NavLink>
                    </AuthorizeView>
                    @* Прежние акты по подотчёту 1С больше не оформляются — пункт виден, только пока есть что утвердить. *@
                    @if (actsToApprove > 0)
                    {
                        <NavLink href="/acts">
                            <Icon Name="act" Size="18" /> Акты на списание
                            <span class="nav-badge" title="Ждут вашего утверждения">@actsToApprove</span>
                        </NavLink>
                    }
                    <NavLink href="/documents"><Icon Name="docs" Size="18" /> Документы</NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/receiving"><Icon Name="receive" Size="18" /> Приёмка по накладной</NavLink>
                        <NavLink href="/documents/new/Receipt"><Icon Name="plus" Size="18" /> Приход вручную</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Issuing" Context="issuing">
                        <NavLink href="/documents/new/Issue"><Icon Name="issue" Size="18" /> Выдача сотруднику</NavLink>
                        <NavLink href="/documents/new/Return"><Icon Name="return" Size="18" /> Возврат</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/documents/new/Transfer"><Icon Name="transfer" Size="18" /> Перемещение</NavLink>
                    </AuthorizeView>

                    <div class="nav-group">Данные</div>
                    <NavLink href="/items"><Icon Name="tag" Size="18" /> Номенклатура</NavLink>
                    <NavLink href="/equipment"><Icon Name="equipment" Size="18" /> Оборудование</NavLink>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/warehouses"><Icon Name="shelves" Size="18" /> Склады и места</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@($"{AppRoles.Admin},{AppRoles.Storekeeper},{AppRoles.Manager}")" Context="staff">
                        <NavLink href="/employees"><Icon Name="users" Size="18" /> Сотрудники</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@AppRoles.Warehouse" Context="warehouse">
                        <NavLink href="/references"><Icon Name="book" Size="18" /> Справочники</NavLink>
                        <NavLink href="/labels"><Icon Name="qr" Size="18" /> Наклейки QR</NavLink>
                        <NavLink href="/reconcile"><Icon Name="sync" Size="18" /> Сверка с 1С</NavLink>
                    </AuthorizeView>

                    <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                        <div class="nav-group">Администрирование</div>
                        <NavLink href="/admin/users"><Icon Name="user" Size="18" /> Пользователи</NavLink>
                        <NavLink href="/admin/import"><Icon Name="upload" Size="18" /> Импорт остатков</NavLink>
                        <NavLink href="/admin/settings"><Icon Name="settings" Size="18" /> Настройки</NavLink>
                    </AuthorizeView>

                    <div class="nav-user">
                        <div class="nav-user-name">@context.User.DisplayNameOf()</div>
                        <div class="nav-user-actions">
                            <a href="/appearance"><Icon Name="palette" Size="16" /> Оформление</a>
                            <a href="/account/password"><Icon Name="key" Size="16" /> Сменить пароль</a>
                            @if (isNativeApp)
                            {
                                <button type="button" class="link-button" onclick="swApp.openSettings()"><Icon Name="phone" Size="16" /> Настройки приложения</button>
                            }
                            <form action="/account/logout" method="post">
                                <AntiforgeryToken />
                                <button type="submit" class="link-button"><Icon Name="logout" Size="16" /> Выйти</button>
                            </form>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </aside>

    <main class="content @(isNativeApp ? "with-fab" : null)">
        @Body
    </main>
    </div>

    <AuthorizeView>
        <RequestCartBar />
    </AuthorizeView>

    @* Телефон и ТСД: нижняя панель — главные разделы под большой палец, «Ещё» открывает всё меню *@
    <AuthorizeView>
        <nav class="bottom-nav" aria-label="Основные разделы" @onclick="() => menuOpen = false">
            <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="home" Size="22" /><span>Обзор</span></NavLink>
            <NavLink href="/stock"><Icon Name="box" Size="22" /><span>Остатки</span></NavLink>
            @if (isNativeApp)
            {
                <button type="button" class="bn-scan" onclick="swApp.scan()" aria-label="Сканировать камерой"><Icon Name="scan" Size="26" /></button>
            }
            else
            {
                <NavLink href="/scan" class="bn-scan" aria-label="Сканировать"><Icon Name="scan" Size="26" /></NavLink>
            }
            @if (isIssuer)
            {
                <NavLink href="/requests">
                    <Icon Name="inbox" Size="22" /><span>Запросы</span>
                    @if (openRequests > 0)
                    {
                        <span class="bn-badge">@openRequests</span>
                    }
                </NavLink>
            }
            else
            {
                <NavLink href="/custody"><Icon Name="custody" Size="22" /><span>Подотчёт</span></NavLink>
            }
            <button type="button" class="@(menuOpen ? "active" : null)" @onclick:stopPropagation="true" @onclick="() => menuOpen = !menuOpen"
                    aria-expanded="@(menuOpen ? "true" : "false")">
                <Icon Name="more" Size="22" /><span>Ещё</span>
                @if (actsToApprove + reportsToConfirm > 0)
                {
                    <span class="bn-badge">@(actsToApprove + reportsToConfirm)</span>
                }
            </button>
        </nav>
    </AuthorizeView>
</div>

@* В приложении для Android — кнопка камеры на каждой странице: код идёт туда же, куда код ручного сканера. *@
@if (isNativeApp)
{
    <AuthorizeView>
        <button type="button" class="scan-fab" title="Сканировать камерой" aria-label="Сканировать камерой" onclick="swApp.scan()"><Icon Name="scan" Size="28" /></button>
    </AuthorizeView>
}

@if (scanMessage is not null)
{
    <div class="scan-toast @(scanFailed ? "scan-toast-error" : null)" role="status" @onclick="() => scanMessage = null">@scanMessage</div>
}

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка. <a href="." class="reload">Обновить страницу</a>
    <span class="dismiss" aria-label="Закрыть"><Icon Name="close" Size="16" /></span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool menuOpen;

    /// <summary>Сайт открыт в приложении «Склад» для Android (там есть сканирование камерой и сканер ТСД).</summary>
    private bool isNativeApp;

    /// <summary>Выдаёт со склада (кладовщик, администратор, старший смены) — в нижней панели «Запросы», а не «Подотчёт».</summary>
    private bool isIssuer;
    private int actsToApprove;
    private int reportsToConfirm;

    /// <summary>Запросы на выдачу, которые ждут кладовщика или старшего смены.</summary>
    private int openRequests;

    private IJSObjectReference? scannerModule;
    private DotNetObjectReference<MainLayout>? self;
    private string? scanMessage;
    private bool scanFailed;
    private CancellationTokenSource? toastTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Ручной сканер (USB / Bluetooth) — на любой странице.
        try
        {
            isNativeApp = await JS.InvokeAsync<bool>("swApp.isNative");
            if (isNativeApp)
                StateHasChanged();
            self = DotNetObjectReference.Create(this);
            scannerModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard-scanner.js");
            await scannerModule.InvokeVoidAsync("attach", self);
        }
        catch (JSException)
        {
            // без перехвата сканер просто пишет в поле, как клавиатура
        }
    }

    /// <summary>Код с ручного сканера: сначала странице (документ добавит строку), иначе — открыть найденное.</summary>
    [JSInvokable]
    public async Task OnHardwareScan(string code)
    {
        try
        {
            if (await Scanner.DispatchAsync(code))
                return;

            var found = await Api.ScanAsync(code);
            Nav.NavigateTo(found.Kind == ScanKind.Location
                ? $"/l/{Uri.EscapeDataString(found.Code)}"
                : $"/items/{found.Id}");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            await ShowScanMessageAsync(ex.Message, failed: true);
        }
    }

    private async Task ShowScanMessageAsync(string message, bool failed)
    {
        toastTimer?.Cancel();
        scanMessage = message;
        scanFailed = failed;
        StateHasChanged();

        var timer = toastTimer = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), timer.Token);
            scanMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // пришло новое сообщение
        }
    }

    public async ValueTask DisposeAsync()
    {
        toastTimer?.Cancel();
        try
        {
            if (scannerModule is not null)
            {
                await scannerModule.InvokeVoidAsync("detach");
                await scannerModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // вкладка закрыта
        }
        self?.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Вошёл с временным паролем — сначала смена пароля.
        if (AuthState is null)
            return;

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true)
            return;
        isIssuer = user.IsWarehouseStaff() || user.IsInRole(AppRoles.ShiftLead);
        if (user.MustChangePasswordOf())
        {
            Nav.NavigateTo("/account/password", forceLoad: true);
            return;
        }

        // Значки «ждут утверждения / подтверждения» обновляются при каждом переходе по страницам.
        // Всего ждут решения = акты (мне утверждать) + отчёты (кладовщику подтверждать).
        if (user.EmployeeIdOf() is not null || user.IsWarehouseStaff())
        {
            try
            {
                var total = await Api.GetActsToApproveCountAsync();
                reportsToConfirm = user.IsWarehouseStaff() && total > 0
                    ? (await Api.GetActsAsync(ActScope.ToApprove, kind: ActKind.UsageReport)).Count
                    : 0;
                actsToApprove = total - reportsToConfirm;
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                actsToApprove = reportsToConfirm = 0; // меню не должно ломаться из-за недоступного API
            }
        }

        if (user.IsInRole(AppRoles.Storekeeper) || user.IsInRole(AppRoles.Admin) || user.IsInRole(AppRoles.ShiftLead))
        {
            try
            {
                openRequests = await Api.GetOpenIssueRequestCountAsync();
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                openRequests = 0;
            }
        }
    }
}
