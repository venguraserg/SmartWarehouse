<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>smartwarehouse-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- EF Core Design транзитивно тянет System.Security.Cryptography.Pkcs 9.0.0 с известными уязвимостями
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Явно поднимаем до исправленной версии. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartWarehouse.Application\SmartWarehouse.Application.csproj" />
    <ProjectReference Include="..\SmartWarehouse.Infrastructure\SmartWarehouse.Infrastructure.csproj" />
  </ItemGroup>

</Project>
